# The peer closes first: its FIN is ACKed, recv sees EOF, our close
# sends FIN, the peer's ACK ends the connection.
# Copyright (C) 2026 The LikeOS Project
0.000 socket s stream
0.000 bind s 8080
0.000 listen s 16
0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
0.100 > S. 0:0(0) ack 1 win * <mss 1460,sackOK,TS val * ecr 100,nop,wscale *>
0.200 < . 1:1(0) ack 1 win 512 <nop,nop,TS val 200 ecr echo>
0.200 accept s c
0.300 < F. 1:1(0) ack 1 win 512 <nop,nop,TS val 300 ecr echo>
0.300 > . 1:1(0) ack 2 win * <nop,nop,TS val * ecr 300>
0.310 state c CLOSE_WAIT
0.310 recv c 100 = 0
0.400 close c
0.400 > F. 1:1(0) ack 2 win *   # (no TS option yet: see fin-timestamp.pkt)
0.400 < . 2:2(0) ack 2 win 512 <nop,nop,TS val 400 ecr echo>   # before the next tick: see fin-retransmit.pkt

# With timestamps on there is room for 3 SACK blocks; with 4 holes the
# ACK carries the 3 most recent, newest first.
# Copyright (C) 2026 The LikeOS Project
0.000 socket s stream
0.000 bind s 8080
0.000 listen s 16
0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
0.100 > S. 0:0(0) ack 1 win * <mss 1460,sackOK,TS val * ecr 100,nop,wscale *>
0.200 < . 1:1(0) ack 1 win 512 <nop,nop,TS val 200 ecr echo>
0.200 accept s c
0.300 < P. 1001:2001(1000) ack 1 win 512 <nop,nop,TS val 300 ecr echo>
0.300 > . 1:1(0) ack 1 win * <nop,nop,TS val * ecr *,sack 1001:2001>
0.310 < P. 3001:4001(1000) ack 1 win 512 <nop,nop,TS val 310 ecr echo>
0.310 > . 1:1(0) ack 1 win * <nop,nop,TS val * ecr *,sack 3001:4001 1001:2001>
0.320 < P. 5001:6001(1000) ack 1 win 512 <nop,nop,TS val 320 ecr echo>
0.320 > . 1:1(0) ack 1 win * <nop,nop,TS val * ecr *,sack 5001:6001 3001:4001 1001:2001>
0.330 < P. 7001:8001(1000) ack 1 win 512 <nop,nop,TS val 330 ecr echo>
0.330 > . 1:1(0) ack 1 win * <nop,nop,TS val * ecr *,sack 7001:8001 5001:6001 3001:4001>

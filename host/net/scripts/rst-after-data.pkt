# Data that arrived before the peer's reset is delivered first; the reset
# is then reported once (ECONNRESET), after which the stream reads end of
# file and a write fails with EPIPE.
# Copyright (C) 2026 The LikeOS Project
0.000 socket s stream
0.000 bind s 8080
0.000 listen s 16
0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
0.100 > S. 0:0(0) ack 1 win * <mss 1460,sackOK,TS val * ecr 100,nop,wscale *>
0.200 < . 1:1(0) ack 1 win 512 <nop,nop,TS val 200 ecr echo>
0.200 accept s c
0.300 < P. 1:11(10) ack 1 win 512 <nop,nop,TS val 300 ecr echo>
0.300 > . 1:1(0) ack 11 win *
0.310 < R. 11:11(0) ack 1 win 512
0.400 recv c 10 = 10
0.400 recv c 10 = -ECONNRESET
0.400 recv c 10 = 0
0.400 send c 1 = -EPIPE
0.400 so_error c = 0

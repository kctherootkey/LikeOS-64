# A data segment carrying an old acknowledgment number (SEG.ACK < SND.UNA)
# has its ACK ignored but its data accepted (RFC 9293 3.10.7.4).
# Copyright (C) 2026 The LikeOS Project
0.000 socket s stream
0.000 bind s 8080
0.000 listen s 16
0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
0.100 > S. 0:0(0) ack 1 win * <mss 1460,sackOK,TS val * ecr 100,nop,wscale *>
0.200 < . 1:1(0) ack 1 win 512 <nop,nop,TS val 200 ecr echo>
0.200 accept s c
0.300 send c 100 = 100
0.300 > P. 1:101(100) ack 1 win * <nop,nop,TS val * ecr *>
0.310 < . 1:1(0) ack 101 win 512 <nop,nop,TS val 310 ecr echo>
0.400 < P. 1:501(500) ack 1 win 512 <nop,nop,TS val 400 ecr echo>
0.400 > . 101:101(0) ack 501 win * <nop,nop,TS val * ecr *>
0.410 recv c 1000 = 500

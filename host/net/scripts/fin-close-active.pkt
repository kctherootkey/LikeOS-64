# We close first: FIN out, the peer ACKs, the peer's FIN is ACKed and the
# connection waits in TIME_WAIT.
# Copyright (C) 2026 The LikeOS Project
0.000 socket s stream
0.000 bind s 8080
0.000 listen s 16
0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
0.100 > S. 0:0(0) ack 1 win * <mss 1460,sackOK,TS val * ecr 100,nop,wscale *>
0.200 < . 1:1(0) ack 1 win 512 <nop,nop,TS val 200 ecr echo>
0.200 accept s c
0.300 shutdown c wr
0.300 > F. 1:1(0) ack 1 win *   # (no TS option yet: see fin-timestamp.pkt)
0.300 < . 1:1(0) ack 2 win 512 <nop,nop,TS val 300 ecr echo>   # before the next tick: see fin-retransmit.pkt
0.360 state c FIN_WAIT_2
0.400 < F. 1:1(0) ack 2 win 512 <nop,nop,TS val 400 ecr echo>
0.400 > . 2:2(0) ack 2 win * <nop,nop,TS val * ecr 400>
# TIME_WAIT is held by a TIME_WAIT sock from here on; the socket's own
# connection is over
0.410 state c CLOSED

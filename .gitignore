# LikeOS-64 build artifacts
#
# Only compiler/linker output is ignored here; all source (including the
# third-party ports/ trees and user/ sources) stays tracked.  Verified that no
# file with these extensions is currently tracked, so nothing real is hidden.
# NOTE: *.bin is intentionally NOT ignored -- 7 *.bin files are tracked assets.

# --- Kernel / OS build tree (kernel.elf, bootloader.efi, disk images, objects)
/build/

# --- Compiled objects & libraries (userland libc/rtld and in-tree ports build
#     their .o next to the sources).  *.o also covers *.pic.o and *.lib.o.
*.o
*.a
*.so
*.so.*
*.lo
*.la

# --- Dependency files (openssl's in-tree build emits thousands of these).
#     *.d also matches a couple of tracked config *directories* named "*.d",
#     so re-include those so their contents stay tracked.
*.d
!*.service.d/
!.ctags.d/

# --- Port build stamps (e.g. ports/openssl-3.5.6/.likeos-configured[.built])
.likeos-configured*

# --- Built port executables
/ports/nano-8.3/nano
/ports/netcat-OpenBSD/nc
/ports/openssl-3.5.6/apps/openssl
/ports/bash-5.2.37/bash
#     openssh's fourteen programs are NOT listed here: that port ships its own
#     .gitignore (see the openssh block below).

# --- tmux port: build output sitting in the tracked source tree.  cmd-parse.c
#     and cmd-parse.h are what yacc emits from cmd-parse.y, which IS tracked, so
#     committing them would put two copies of the same grammar under review and
#     let them drift.  `tmux` is the linked binary.
/ports/tmux-3.6a/cmd-parse.c
/ports/tmux-3.6a/cmd-parse.h
/ports/tmux-3.6a/tmux

# --- openssl port: the link wrapper its Makefile.likeos writes out.  Its own
#     first line says "Auto-generated ... do not edit", and the rule that
#     creates it is tracked, so the file itself is derived.
/ports/openssl-3.5.6/likeos-bin-linker

# --- bash port: everything likeos-generate.sh produces (see GEN_SOURCES and
#     GEN_STAMP in ports/bash-5.2.37/Makefile.likeos).  `make distclean` in
#     that tree removes exactly this set, returning it to the upstream tarball
#     plus the port's own build files.
/ports/bash-5.2.37/.likeos-generated
/ports/bash-5.2.37/hosttools/
/ports/bash-5.2.37/err.log
/ports/bash-5.2.37/config.h
/ports/bash-5.2.37/config-likeos.h
/ports/bash-5.2.37/pathnames.h
/ports/bash-5.2.37/version.h
/ports/bash-5.2.37/pipesize.h
/ports/bash-5.2.37/signames.h
/ports/bash-5.2.37/syntax.c
/ports/bash-5.2.37/builtins/pipesize.h
/ports/bash-5.2.37/builtins/builtext.h
#     One .c per builtins/*.def is generated by mkbuiltins, so ignore the
#     directory's sources and re-include the hand-written ones (the same
#     shape as the /user/bin rule below).  A new .def then needs no edit here.
/ports/bash-5.2.37/builtins/*.c
!/ports/bash-5.2.37/builtins/bashgetopt.c
!/ports/bash-5.2.37/builtins/common.c
!/ports/bash-5.2.37/builtins/evalfile.c
!/ports/bash-5.2.37/builtins/evalstring.c
!/ports/bash-5.2.37/builtins/gen-helpfiles.c
!/ports/bash-5.2.37/builtins/getopt.c
!/ports/bash-5.2.37/builtins/mkbuiltins.c
!/ports/bash-5.2.37/builtins/psize.c

# --- openssh port.  Unlike the other ports, the openssh tarball ships its OWN
#     .gitignore, and a .gitignore in a subdirectory takes precedence over this
#     one -- so rules for that tree belong there, not here.  Upstream's file
#     already covers everything configure and the build produce: the fourteen
#     programs, Makefile, config.h/.log/.status, openbsd-compat/{Makefile,
#     include}, *.out, buildpkg.sh, opensshd.init, openssh.xml, survey.sh and
#     autom4te.cache/ -- i.e. exactly what `make distclean` removes there.
#
#     Only the two files this port adds are left to cover: the configure cache
#     seeded by likeos-configure.sh (the .likeos-configured stamp is already
#     handled by the .likeos-configured* rule above).
/ports/openssh-10.4p1/likeos.cache
/ports/openssh-10.4p1/config.cache

# --- openssl port.  Configured and built in place with the tree tracked, and
#     its release tarball ships no .gitignore of its own, so the ~163 files its
#     Makefile derives from tracked .in/.pl sources are listed in
#     ports/openssl-3.5.6/.gitignore -- next to the tree they describe, the same
#     arrangement as openssh above.  They are not globbed there: most sit in
#     directories full of real sources with the same extension.

# --- X.Org port (52 packages).
#
#     The TARBALLS ARE TRACKED, deliberately, all 52 of them (~38 MB).  They are
#     the build's only source of upstream code, so committing them is what makes
#     `git clone && make` produce an X server on a machine with no network and
#     without depending on 52 upstream download URLs still resolving.  That is
#     also why ports/xorg/fetch.sh checks for an existing tarball before
#     reaching for the network: with these present it makes no requests at all.
#
#     What IS ignored is everything derived from them: the source tree each
#     tarball unpacks into (ports/xorg/<pkg>/), plus .stamps/, .logs/ and
#     .hosttools/ -- the last holds tools built for THIS machine (nsgenbind),
#     which must never reach the image.  All three are covered by the `*/` rule
#     below, because a gitignore `*` matches a leading dot.
#     The build sysroot they install into lives under /build/ and is gone with it.
/ports/xorg/*/
#     Re-included: the cross-compile toolchain and the patches we apply to
#     upstream source.  Both are OURS and there is no way to rebuild them from
#     a tarball.  (Negating a directory works here because the rule above
#     excludes the directory itself, so git still descends into these two.)
!/ports/xorg/toolchain/
!/ports/xorg/patches/
#     Re-included for the same reasons: the GTK3 sub-port, which is a manifest
#     and a set of wrapper scripts rather than a second build system, and then
#     the same three rules again one level down for what IT derives.
!/ports/xorg/gtk3/
/ports/xorg/gtk3/*/
!/ports/xorg/gtk3/patches/
#     And man/, for the same reason as patches/: it holds a manual page this
#     port WRITES rather than renders, because Mousepad publishes none of its
#     own.  It cannot be recovered from any tarball, and without this line the
#     `*/` rule above would drop it -- the build would then quietly produce an
#     image whose only missing piece is one manual page.
!/ports/xorg/gtk3/man/
#     Not listed, therefore tracked, and all required to build from a clone:
#     packages.list (the manifest), fetch/unpack/build/stage/clean.sh, and
#     checksums.sha256 (records which upstream bytes a build used).
/build/xorg-sysroot/

# --- Compiled userland executables (built in-tree next to their .c sources).
#     Ignore everything under the bin dirs, then re-include tracked sources.
/user/bin/*
!/user/bin/*.c
!/user/bin/*.h
!/user/bin/*.lds
!/user/bin/Makefile
!/user/bin/tests
/user/bin/tests/*
!/user/bin/tests/*.c
!/user/bin/tests/*.h
#     testcxx.cpp is the only C++ source in the tree, and this line is the
#     reason it went missing: without it the file was ignored, never committed,
#     and existed only on the machine it was written on.  Every other machine
#     got a Makefile that names it as a prerequisite and no file to satisfy it:
#     "No rule to make target 'user/bin/tests/testcxx.cpp'".
!/user/bin/tests/*.cpp
#     Shell-script tests (testbash.sh, scripttest.sh) are sources too -- they
#     are run on the target, not built, so nothing else would re-include them.
!/user/bin/tests/*.sh
!/user/bin/tests/Makefile
#     The desktop bar widgets (datetime.c, load.c) live in their own directory
#     under user/bin, so they need the same re-include the tests do -- the
#     "/user/bin/*" above hides a new subdirectory entirely, sources and all.
#     This is the testcxx.cpp trap described just above, one directory over.
!/user/bin/shell
/user/bin/shell/*
!/user/bin/shell/*.c
!/user/bin/shell/*.h
/tmp/

# libinstaller -- host build and tests (glibc, the build machine's gcc,
# the host's libzstd and libcrypt).
#
#   make -f Makefile.host          the test programs
#   make -f Makefile.host check    every backend test, boxed (nice, a memory
#                                  limit, a time limit): the unit tests, the
#                                  simulated installations, the extractor
#
# The tests work in a scratch directory (WORK, default a fresh directory
# under $TMPDIR) on sparse image files; the host's sgdisk, sfdisk, mkfs.fat,
# mke2fs, e2fsck, fsck.fat, tar, zstd and fakeroot check the results.
# Nothing runs as root and no block device is ever opened.
#
# Copyright (C) 2026 The LikeOS Project

CC = gcc
OUT ?= host
BACKEND = ..
LIBGPT = ../../../lib/libgpt
RES_ETC = ../../../../res/etc

ZSTD_CFLAGS := $(shell pkg-config --cflags libzstd)
ZSTD_LIBS := $(shell pkg-config --libs libzstd)

CFLAGS = -D_GNU_SOURCE -Wall -Wextra -Werror=implicit-function-declaration \
	-O2 -g -I$(BACKEND)/include -I$(BACKEND) -I$(LIBGPT)/include \
	$(ZSTD_CFLAGS)
LIBS = $(ZSTD_LIBS) -lcrypt

BACKEND_SRC = il_ctx.c il_log.c il_util.c il_sha256.c il_disk.c il_source.c \
	il_plan.c il_partition.c il_format.c il_mount.c il_extract.c il_tar.c \
	il_acl.c il_config.c il_accounts.c il_boot.c il_install.c il_progress.c \
	il_answers.c il_validate.c il_tz.c il_locale.c
LIBGPT_SRC = crc32.c guid.c blkio.c mbr.c gpt.c layout.c types.c

OBJ = $(addprefix $(OUT)/il/,$(BACKEND_SRC:.c=.o)) \
	$(addprefix $(OUT)/gpt/,$(LIBGPT_SRC:.c=.o))
HDRS = $(BACKEND)/include/installer.h $(BACKEND)/il_internal.h \
	$(BACKEND)/il_compat.h $(BACKEND)/il_tar.h $(LIBGPT)/include/gpt.h

all: $(OUT)/test_backend $(OUT)/test_install

$(OUT)/il $(OUT)/gpt:
	mkdir -p $@

$(OUT)/il/%.o: $(BACKEND)/%.c $(HDRS) | $(OUT)/il
	$(CC) $(CFLAGS) -c $< -o $@

$(OUT)/gpt/%.o: $(LIBGPT)/%.c $(LIBGPT)/include/gpt.h | $(OUT)/gpt
	$(CC) -D_GNU_SOURCE -Wall -Wextra -O2 -g -I$(LIBGPT)/include \
		-I$(LIBGPT) -c $< -o $@

# --wrap=malloc: the test fails allocations of the library on purpose.
$(OUT)/test_backend: test_backend.c $(OBJ)
	$(CC) $(CFLAGS) $< $(OBJ) $(LIBS) -Wl,--wrap=malloc -o $@

$(OUT)/test_install: test_install.c $(OBJ)
	$(CC) $(CFLAGS) $< $(OBJ) $(LIBS) -o $@

# The backend and libgpt as one host library, for the host build of the
# graphical installer that installs onto image files
# (user/installer/frontend/Makefile.host BACKEND=real).  Programs linking it
# need $(ZSTD_LIBS) -lcrypt as well.
lib: $(OUT)/libinstaller-host.a

$(OUT)/libinstaller-host.a: $(OBJ)
	rm -f $@
	ar rcs $@ $(OBJ)

check: all
	nice -n 19 timeout 600 sh -c 'ulimit -v 2500000; \
		sh ./run-tests.sh $(OUT) $(RES_ETC)'
	$(MAKE) -C extract -f Makefile.host OUT=$(abspath $(OUT)) check

clean:
	rm -rf $(OUT)
	$(MAKE) -C extract -f Makefile.host OUT=$(abspath $(OUT)) clean

.PHONY: all lib check clean

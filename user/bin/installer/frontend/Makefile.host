# LikeOS installer -- host builds of the graphical installer, for trying
# the wizard on any desktop:
#
#   make -f Makefile.host            build-host/likeos-installer: the
#                                    stand-in backend only (made-up disks,
#                                    nothing is written)
#   make -f Makefile.host BACKEND=real
#                                    build-host-real/likeos-installer:
#                                    libinstaller (the host build of
#                                    user/installer/backend) as well; it
#                                    installs onto image files:
#       likeos-installer --window --simulate=disk.img \
#           --source=likeos-rootfs.tar.zst --target=DIR --log=FILE
#     (as in the backend's host tests: run it under fakeroot, with
#     IL_MKFS_FAT, IL_MKE2FS, IL_E2FSCK and IL_TUNE2FS naming the host's
#     tools; --mock still selects the stand-in)
#   make -f Makefile.host run        runs the stand-in build in a window
#   make -f Makefile.host clean
#
# Needs the host's GTK 3 development files (pkg-config gtk+-3.0) and
# glib-compile-resources; BACKEND=real also libzstd and libcrypt.  The
# LikeOS build of this program is in mk/installer.mk.
#
# Copyright (C) 2026 The LikeOS Project

INSTALLER_FE_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
INSTALLER_FE_TOP := $(abspath $(INSTALLER_FE_DIR)/../../..)
BACKEND ?= mock
ifeq ($(BACKEND),real)
OUT ?= $(INSTALLER_FE_DIR)/build-host-real
else ifeq ($(BACKEND),mock)
OUT ?= $(INSTALLER_FE_DIR)/build-host
else
$(error BACKEND is mock or real)
endif

CC       ?= gcc
PKGS     := gtk+-3.0
CFLAGS   ?= -O2 -g
CFLAGS   += -std=gnu11 -Wall -Wextra
CPPFLAGS += $(shell pkg-config --cflags $(PKGS)) \
	-I$(INSTALLER_FE_DIR) -I$(INSTALLER_FE_TOP)/user/installer/backend/include \
	-I$(INSTALLER_FE_TOP)/user/bin/shell -I$(OUT) \
	-DKBD_CATALOGUE='"$(INSTALLER_FE_TOP)/res/keyboard/layouts.tsv"'
LDLIBS   += $(shell pkg-config --libs $(PKGS)) -lm

include $(INSTALLER_FE_DIR)/sources.mk

SRCS := $(INSTALLER_FE_SRCS) $(INSTALLER_FE_MOCK_SRCS)
ifeq ($(BACKEND),real)
# The backend's host objects as one library, built by its own host
# makefile (the same objects its tests use).
BACKEND_TESTS := $(INSTALLER_FE_TOP)/user/installer/backend/tests
BACKEND_LIB := $(OUT)/backend/libinstaller-host.a
SRCS += $(INSTALLER_FE_REAL_SRCS)
CPPFLAGS += -DINSTALLER_HAVE_REAL
LDLIBS += $(shell pkg-config --libs libzstd) -lcrypt
endif

OBJS := $(patsubst %.c,$(OUT)/obj/%.o,$(SRCS)) \
	$(OUT)/obj/keyboard-conf.o $(OUT)/obj/resources.o

all: $(OUT)/likeos-installer

$(OUT)/likeos-installer: $(OBJS) $(BACKEND_LIB)
	@echo "  LD      $@"
	@$(CC) $(CFLAGS) -o $@ $(OBJS) $(BACKEND_LIB) $(LDLIBS)

ifeq ($(BACKEND),real)
# BACKEND=real from the command line must not reach that makefile, whose
# BACKEND is the path of the sources.
MAKEOVERRIDES :=
.PHONY: $(BACKEND_LIB)
$(BACKEND_LIB):
	$(MAKE) -C $(BACKEND_TESTS) -f Makefile.host OUT=$(OUT)/backend lib
endif

$(OUT)/obj/%.o: $(INSTALLER_FE_DIR)/%.c $(INSTALLER_FE_HDRS) | $(OUT)
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

$(OUT)/obj/keyboard-conf.o: $(INSTALLER_FE_TOP)/user/bin/shell/keyboard-conf.c $(INSTALLER_FE_TOP)/user/bin/shell/keyboard-conf.h | $(OUT)
	@mkdir -p $(dir $@)
	@echo "  CC      $<"
	@$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

$(OUT)/resources.c: $(INSTALLER_FE_RES_DEPS) | $(OUT)
	glib-compile-resources --target=$@ --generate-source $(INSTALLER_FE_RES_DIRS) \
		$(INSTALLER_FE_DIR)/style/installer.gresource.xml

$(OUT)/obj/resources.o: $(OUT)/resources.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -Wno-overlength-strings -c -o $@ $<

$(OUT):
	mkdir -p $@

run: $(OUT)/likeos-installer
	$(OUT)/likeos-installer --window $(if $(filter mock,$(BACKEND)),,--mock)

clean:
	rm -rf $(OUT)

.PHONY: all run clean

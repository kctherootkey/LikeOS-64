# Copyright (C) 2026 The LikeOS Project
#
# Firmware the sound drivers (kernel/dev/sound) ask for, one per line, as
# paths under /lib/firmware: every file the Intel audio DSP driver
# (sof_pci.c, sof_loader.c, sof_acpi.c) can request on the platforms it
# boots, cAVS 2.5 (Tiger/Elkhart/Alder/Raptor Lake) and ACE 1.x-3.x
# (Meteor/Arrow/Lunar/Panther/Wildcat Lake), plus the CS42L43 codec patch.
# All of it ships uncompressed in res/firmware (intel/ mirrors
# /lib/firmware/intel), from the SOF binary release sof-bin v2026.09.2
# (firmware v2.12 for cAVS 2.5, v2.15 for ACE, topologies v2.15.1);
# licence in LICENCE.sof, LICENSE.cirrus for cs42l43.bin.
#
# Base firmware, Intel-signed (DSPs fused with the Intel production key,
# every retail machine).  The machine scan's name comes first
# (sof-ipc4/<plat>/sof-<plat>.ri), then the PCI table's directory:
intel/sof-ipc4/tgl/sof-tgl.ri
intel/sof-ipc4/tgl-h/sof-tgl-h.ri
intel/sof-ipc4/adl/sof-adl.ri
intel/sof-ipc4/adl-s/sof-adl-s.ri
intel/sof-ipc4/adl-n/sof-adl-n.ri
intel/sof-ipc4/rpl/sof-rpl.ri
intel/sof-ipc4/rpl-s/sof-rpl-s.ri
intel/sof-ipc4/mtl/sof-mtl.ri
intel/sof-ipc4/arl/sof-arl.ri
intel/sof-ipc4/arl-s/sof-arl-s.ri
intel/sof-ipc4/lnl/sof-lnl.ri
intel/sof-ipc4/ptl/sof-ptl.ri
intel/sof-ipc4/wcl/sof-wcl.ri
# Base firmware, community-signed (DSPs fused with the community key:
# Chromebooks and UP boards, recognised from SMBIOS; asked for first
# there, and as the last resort elsewhere).  Elkhart Lake has only this
# build:
intel/sof-ipc4/tgl/community/sof-tgl.ri
intel/sof-ipc4/tgl-h/community/sof-tgl-h.ri
intel/sof-ipc4/ehl/community/sof-ehl.ri
intel/sof-ipc4/adl/community/sof-adl.ri
intel/sof-ipc4/adl-s/community/sof-adl-s.ri
intel/sof-ipc4/adl-n/community/sof-adl-n.ri
intel/sof-ipc4/rpl/community/sof-rpl.ri
intel/sof-ipc4/rpl-s/community/sof-rpl-s.ri
intel/sof-ipc4/mtl/community/sof-mtl.ri
intel/sof-ipc4/arl/community/sof-arl.ri
intel/sof-ipc4/arl-s/community/sof-arl-s.ri
intel/sof-ipc4/lnl/community/sof-lnl.ri
intel/sof-ipc4/ptl/community/sof-ptl.ri
intel/sof-ipc4/wcl/community/sof-wcl.ri
# Split releases (ACE 3.x): the open modules, loaded as a library next to
# the base image once it runs:
intel/sof-ipc4/ptl/sof-ptl-openmodules.ri
intel/sof-ipc4/ptl/community/sof-ptl-openmodules.ri
intel/sof-ipc4/wcl/sof-wcl-openmodules.ri
intel/sof-ipc4/wcl/community/sof-wcl-openmodules.ri
#
# Loadable libraries, named after the module UUID they provide
# (sof-ipc4-lib/<plat>[/community]/<UUID>.bin), for a module a loaded
# topology uses that the base firmware lacks.  Of all the topologies below
# only Lunar Lake needs one: DRC, used by its HDA generic and SoundWire
# topologies.
intel/sof-ipc4-lib/lnl/B36EE4DA-006F-47F9-A06D-FECBE2D8B6CE.bin
intel/sof-ipc4-lib/lnl/community/B36EE4DA-006F-47F9-A06D-FECBE2D8B6CE.bin
#
# Topologies, all in sof-ipc4-tplg.
#
# Function topologies (ACE SoundWire machines, sof_pci.c), one per audio
# function: SDCA jack, amplifiers by number of amplifier links, SoundWire
# microphones, PCH DMICs by platform and count (two or four), HDMI.
intel/sof-ipc4-tplg/sof-arl-dmic-2ch-id4.tplg
intel/sof-ipc4-tplg/sof-arl-dmic-4ch-id4.tplg
intel/sof-ipc4-tplg/sof-hdmi-pcm5-id5.tplg
intel/sof-ipc4-tplg/sof-lnl-dmic-2ch-id4.tplg

intel/sof-ipc4-tplg/sof-sdca-mic-id4.tplg
intel/sof-ipc4-tplg/sof-wcl-dmic-2ch-id4.tplg
intel/sof-ipc4-tplg/sof-wcl-dmic-4ch-id4.tplg
#
# HDA generic topologies (HDMI and/or an analog HDA codec): plain, -idisp
# when only display codecs answer, -1ch/-2ch/-4ch with PCH DMICs; the

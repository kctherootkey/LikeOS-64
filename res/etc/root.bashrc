# ~/.bashrc - per-user settings for root's interactive shells.
#
# The system-wide /etc/bash.bashrc has already set the prompt, history
# behaviour and the standard aliases.  Put personal overrides here; the
# examples below are commented out.

# Keep the system prompt, or override it, e.g.:
#PS1='\u@\h:\w\$ '

#alias rm='rm -i'
#alias grep='grep --color=auto'

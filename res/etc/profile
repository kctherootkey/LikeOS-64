# /etc/profile - system-wide startup for LOGIN shells.
#
# Read by bash when it is started as a login shell (getty -> login -> "-bash"),
# before the per-user ~/.profile.  A login shell does not read /etc/bash.bashrc
# by itself, so source it here: the prompt and the other interactive settings
# then apply to login and non-login shells alike.

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# $SHELL is the user's login shell, and plenty of programs read it rather than
# looking the user up: xterm and screen use it to decide what to run, and
# anything offering a "shell escape" spawns it.  bash does not set it itself.
[ -n "$SHELL" ] || export SHELL=/bin/bash
export PAGER=less
export EDITOR=nano

# The system locale.  init already exports this and login carries it into the
# session, so it is normally set by the time this file runs; it is repeated
# here because this is where someone looks to change it.  The part that matters
# is the ".UTF-8" suffix: programs read the locale name to decide whether to
# handle multibyte characters at all, and without it anything above ASCII --
# an umlaut in a filename, a box-drawing character, a remote host's banner --
# is treated as a byte per character and comes out mangled.
[ -n "$LANG" ] || export LANG=en_US.UTF-8

umask 022

# Interactive shells also get the system-wide interactive configuration.
case $- in
	*i*)
		if [ -r /etc/bash.bashrc ]; then
			. /etc/bash.bashrc
		fi
		;;
esac

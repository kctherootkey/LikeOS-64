#!/bin/sh
# Default X session, installed as /etc/X11/xinit/xinitrc.
#
# xinit runs this unless the user has their own ~/.xinitrc.  When it exits, the
# session is over and the server shuts down -- so the LAST command runs in the
# foreground and defines the session's lifetime, and everything before it is a
# background helper that gets killed when that program ends.

# System-wide X resources.  The toolkit reads the file named by $XENVIRONMENT as
# this host's resource file, which gets these defaults to every toolkit client
# without needing xrdb (not built) to publish them on the root window.
#
# Exported before any client starts, because a client only reads resources once
# at startup.
if [ -r /etc/X11/Xresources ]; then
	XENVIRONMENT=/etc/X11/Xresources
	export XENVIRONMENT
fi

# Keyboard map.  The server already reads this from xorg.conf; setting it again
# here is where to change it for a session without editing the configuration.
if [ -x /usr/bin/setxkbmap ]; then
	setxkbmap us
fi

# Desktop background: the CDE teal.
#
# This is the real desktop colour and it sticks, because system.ctwmrc sets
# DontPaintRootWindow -- otherwise ctwm would repaint the root from the current
# workspace's own colour the moment it mapped a workspace, and whatever was set
# here would last only an instant.
#
# Set once, to the final colour, so there is no intermediate shade: the screen is
# black until the server starts, then this, then the desktop.  (The default root
# pattern is a black-and-white weave that dithers harshly on a framebuffer, so
# something does have to replace it.)
# -cursor_name is here for the same reason the colour is: the DESKTOP pointer
# belongs to the root window, which ctwm never touches, so it keeps whatever the
# server set -- and the server's default is X_cursor, the big X.  left_ptr is the
# plain arrow.  The pointers over windows, titles and menus are ctwm's, and are
# set in the Cursors block in system.ctwmrc.
xsetroot -solid "#6f9c9c" -cursor_name left_ptr

# Clock, top-left, as the first piece of the desktop bar.  Started BEFORE the
# window manager so it is already mapped when ctwm takes over and applies the
# NoTitle / NoBorder / OccupyAll rules that make the bar a panel rather than
# three ordinary windows.
#
# Backgrounded: only the LAST command in this script may run in the foreground,
# because that one's lifetime is the session's.
#
# -strftime cuts the display down to the time alone.  A digital xclock otherwise
# prints the full date as well, which is far wider than the slot the bar leaves
# for it, and the text would simply be clipped.
#
# 60x52 is the bar's own height, so the clock is the same height as the taskbar
# and the workspace manager beside it.
#
# Colours on the COMMAND LINE, not in the resource file.  xclock names every one
# of its own resources under the instance "clock" (*clock.analog, *clock.chime,
# ...), and a tight ".clock" binding outranks the loose "XClock*background" a
# resource file can offer -- which is why the clock stayed pale.  A command-line
# option outranks every resource file, so this is the one place that cannot be
# overridden.  #c6c6c6 is exactly IconManagerBackground, the taskbar's own fill,
# so the clock and the bar it sits in stay the same colour.
if [ -x /usr/bin/xclock ]; then
	xclock -digital -strftime "%H:%M" \
	       -background "#c6c6c6" -foreground black -borderwidth 0 \
	       -geometry 60x52+0+0 &
fi

# Load-average graph, immediately right of the clock and before the taskbar
# (which system.ctwmrc starts at +168 to leave room for both).
#
# Same colours as the rest of the bar, and for the same reason they are on the
# command line rather than in Xresources: an option cannot be outranked by a
# tighter resource binding.  -update 2 is a two-second sample; the default of 10
# makes the graph look frozen.
#
# -scale is the number of divisions the graph is drawn against, and it decides
# what "full height" MEANS.  xload plots the 1-minute load average -- the
# number of runnable tasks -- and the default scale of 1 makes a full-height
# graph mean ONE task runnable, i.e. one core busy.  On a multi-core machine
# that reads alarmingly: an idle desktop with a load of 0.6 fills 60% of the
# graph while the CPUs are 95% idle, because 0.6 of one core IS most of one
# core -- it is just a small share of the machine.
#
# Scaling by the processor count makes full height mean "every core busy", so
# the graph tracks what top reports.  Taken from nproc rather than hardcoded,
# because this image boots on machines with different core counts.
if [ -x /usr/bin/xload ]; then
	_ncpu=1
	# /bin, not /usr/bin: the X clients live in /usr/bin but the LikeOS
	# tools are in /bin, and they are separate directories here.
	if [ -x /bin/nproc ]; then
		_ncpu=$(/bin/nproc 2>/dev/null) || _ncpu=1
	fi
	case "$_ncpu" in
	''|*[!0-9]*) _ncpu=1 ;;
	esac
	[ "$_ncpu" -lt 1 ] && _ncpu=1
	xload -update 2 -nolabel -scale "$_ncpu" \
	      -background "#c6c6c6" -foreground black -borderwidth 0 \
	      -geometry 100x52+64+0 &
	unset _ncpu
fi

# No terminal is started here on purpose.  Use "New xterm" on the root menu
# (button 1 on the background) to open one.  Starting clients from this script
# only obscures which of them failed and why.

# The window manager runs in the FOREGROUND, which is the conventional
# arrangement for twm and its relatives: "Exit" on the root menu then ends the
# session and stops the server, rather than merely removing the decorations.
exec ctwm

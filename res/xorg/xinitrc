#!/bin/sh
# Default X session, installed as /etc/X11/xinit/xinitrc.
#
# xinit runs this unless the user has their own ~/.xinitrc.  When it exits, the
# session is over and the server shuts down -- so the LAST command runs in the
# foreground and defines the session's lifetime, and everything before it is a
# background helper that gets killed when that program ends.

# System-wide X resources.  The toolkit reads the file named by $XENVIRONMENT as
# this host's resource file, which gets these defaults to every toolkit client
# without needing xrdb (not built) to publish them on the root window.
#
# Exported before any client starts, because a client only reads resources once
# at startup.
if [ -r /etc/X11/Xresources ]; then
	XENVIRONMENT=/etc/X11/Xresources
	export XENVIRONMENT
fi

# Keyboard map.  The server already reads this from xorg.conf; setting it again
# here is where to change it for a session without editing the configuration.
if [ -x /usr/bin/setxkbmap ]; then
	setxkbmap us
fi

# The session bus.
#
# One D-Bus daemon for the session, started here because it has to exist before
# anything that wants it does.  xfce4-terminal is what wants it: its
# preferences live in xfconf, which is a daemon holding the settings and a
# client library talking to it, and the two find each other over this bus.
# With no bus the terminal warns once on stderr and falls back to compiled-in
# defaults -- it works, and nothing set in its preferences dialog survives
# being closed.
#
# dbus-launch rather than dbus-daemon directly: it starts the daemon, prints
# the address and pid as shell assignments, and the eval publishes them into
# this script's environment, which every client started below then inherits.
# --exit-with-session makes the daemon go away when this script does, so a
# second startx does not find a stale socket from the first.
#
# Guarded on the binary and on the address not already being set: a user who
# has arranged their own bus keeps it.  The machine id is written first because
# dbus-daemon refuses to start without one, and nothing else on the image
# creates it.
if [ -x /usr/bin/dbus-launch ] && [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
	if [ ! -s /var/lib/dbus/machine-id ] && [ -x /usr/bin/dbus-uuidgen ]; then
		mkdir -p /var/lib/dbus
		dbus-uuidgen > /var/lib/dbus/machine-id 2>/dev/null
	fi
	eval "$(dbus-launch --sh-syntax --exit-with-session)"
	export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
fi

# Desktop background: black, and black is deliberate.
#
# Something has to replace the root window's default pattern -- a black-and-white
# weave that dithers harshly on a framebuffer -- but whatever it is shows only
# for the moment between the server starting and PCManFM drawing the wallpaper
# over it.  A colour here therefore buys nothing and costs a visible flash:
# the screen went black, then teal, then the wallpaper, and the teal in the
# middle read as a fault rather than as a background.
#
# Black is what the screen already is when the server starts, so this changes
# nothing visible and the only transition left is the one that matters, to the
# wallpaper.  pcmanfm.conf's desktop_bg is black for the same reason and has to
# stay in step with this.
#
# It sticks, because system.ctwmrc sets DontPaintRootWindow -- otherwise ctwm
# would repaint the root from the current workspace's own colour the moment it
# mapped a workspace, and whatever was set here would last only an instant.
#
# -cursor_name is here for a different reason: the DESKTOP pointer belongs to
# the root window, which ctwm never touches, so it keeps whatever the server
# set -- and the server's default is X_cursor, the big X.  left_ptr is the
# plain arrow.  The pointers over windows, titles and menus are ctwm's, and are
# set in the Cursors block in system.ctwmrc.
xsetroot -solid "#000000" -cursor_name left_ptr

# The desktop bar.
#
# taskbar(1) is this system's own program (user/bin/shell/taskbar.c): a
# Windows 2000-style panel across the bottom of the screen holding the LikeOS
# button, the load and memory tray, the task buttons, the four workspace
# buttons and the clock.  It replaced three things that used to be started or
# drawn separately -- xclock, xload, and ctwm's own icon manager and workspace
# manager, both of which are switched off in system.ctwmrc.
#
# Backgrounded: only the LAST command in this script may run in the foreground,
# because that one's lifetime is the session's.
#
# Started BEFORE the window manager, like the widgets it replaced, so it is
# already mapped when ctwm takes over and applies the NoTitle / NoBorder /
# OccupyAll rules.  It does not need ctwm to be running first: everything it
# shows comes from EWMH properties on the root window, and until ctwm sets them
# the panel simply has an empty task list.  It picks them up from the
# PropertyNotify that follows.
#
# No -geometry.  The panel sizes itself to the width of the monitor and pins
# itself to the bottom, then publishes _NET_WM_STRUT_PARTIAL so ctwm narrows
# _NET_WORKAREA and maximised windows stay clear of it.
#
# datetime(1) and load(1) are NOT started here any more.  They still exist and
# still work -- run either from a terminal -- but the panel draws both from the
# same code (user/bin/shell/panel.c), so having them as separate windows as
# well would only be the same readings twice.
if [ -x /usr/bin/taskbar ]; then
	taskbar &
fi

# Cursor theme.  Xcursor reads the resource file above for most clients, but a
# program that starts before resources are loaded -- or one that consults the
# environment first, which Xcursor does -- needs it here too.  The theme is
# generated at image-build time into /usr/share/icons/LikeOS and supplies the
# busy cursors; everything else falls back to the X core cursor font.
XCURSOR_THEME=LikeOS
XCURSOR_SIZE=32
export XCURSOR_THEME XCURSOR_SIZE

# WebKit: accelerated compositing is ON, and this is where it used to be
# switched off.
#
# WEBKIT_DISABLE_DMABUF_RENDERER=1 was exported here while the system had no
# GL at all -- no Mesa, no libEGL -- because libepoxy abort()s the process
# the moment an EGL entry point is called with no libEGL.so.1 to load, which
# is how Claws Mail died on its first HTML message.  Mesa with llvmpipe now
# provides EGL (see eglinfo) and the server provides GLX, so that danger is
# gone.  The variable is worse than unnecessary now: WebKit reads it FIRST in
# AcceleratedBackingStore::rendererBufferTransportMode(), reports no
# transport at all, HardwareAccelerationManager concludes hardware
# acceleration is unavailable, webkit://gpu shows "Policy: never" -- and
# WebGL, which needs a composited canvas, is refused with "disabled or
# unavailable" no matter what the settings say.
#
# What WebKit does with it unset: EGL_MESA_platform_surfaceless is present,
# so the web process renders through llvmpipe and hands frames over as shared
# memory (there is no GBM/DMA-BUF here, so the "Hardware" transport never
# engages).  GTK's own GL check goes through GLX, which is why server-side
# GLX is a prerequisite.  To fall back for debugging, export the variable
# from a shell before starting luakit -- not here.
#
# Composite where there is a GPU, and not where there is not.
#
# With acceleration available WebKit forces every page through its compositor.
# That is what WebGL, the accelerated canvas and the GPU process need, and on
# a machine with no GPU it is the wrong choice outright: GL is llvmpipe, so the
# arrangement becomes several full-screen software passes per scroll step where
# cairo needs one, and freebsd.org was unscrollable that way.
#
# Known and measured, so that nobody re-discovers it: on the GTK3 API line the
# accelerated path does NOT end on the GPU.  WebKit only hands the compositor's
# buffer to the toolkit when its EGL display is the one GTK already uses, and
# GTK3's X11 backend is GLX-only, so that is never true here -- the UI process
# CPU-maps the tile every frame (gbm_bo_map) and composites it with cairo
# anyway.  webkit://gpu says so: "Native interface: None", "Usage: Mapping".
# That map is a processor/device synchronisation once a frame, ~6.8ms of every
# maximized frame, and turning compositing off removes it.  It was the default
# here for a while for exactly that reason.
#
# It is back on because the compositor is what the rest of the engine expects:
# with it off, WebKit's non-composited paths -- which upstream barely
# exercises -- drop wheel events and crashed the web process on a null
# overflow-controls host layer.  Scrolling no longer depends on which way this
# goes: luakit binds the wheel itself now (res/xorg/gtk3/luakit-userconf.lua),
# so the wheel behaves the same either way.
#
# Reverse this the day WebKit is built against GTK4 (webkit2gtk-6.0): the
# display is shared there, the map disappears, and the accelerated path is
# genuinely the shorter one.
#
# The test is /dev/dri/card0: it exists exactly where the kernel bound a
# display-manager driver to a GPU.  To force either behaviour by hand, export
# the variable from a shell before starting luakit -- not here.
if [ ! -e /dev/dri/card0 ]; then
	WEBKIT_FORCE_COMPOSITING_MODE=0
	export WEBKIT_FORCE_COMPOSITING_MODE
fi

# No terminal is started here on purpose.  Use "Xterm" on the window manager's
# menu, which is Alt+F1 -- the menus are on keys rather than mouse buttons
# because the desktop below owns all three buttons (see system.ctwmrc).
# Starting clients from this script only obscures which of them failed and why.

# The desktop: icons on the background, drawn by PCManFM.
#
# Started here rather than from a menu entry, because it is part of what the
# session IS -- a desktop that has to be switched on by hand after every login
# is not a desktop.  It takes the root window over, so the background becomes a
# PCManFM window showing the home folder, the trash and any mounted volume, and
# all three buttons over it belong to PCManFM.  ctwm's own menus move to Alt+F1
# and Alt+F2 to make room (see system.ctwmrc).
#
# Backgrounded and started BEFORE the window manager so that ctwm is already
# there to manage its window: PCManFM marks it _NET_WM_WINDOW_TYPE_DESKTOP and
# ctwm gives that type the bottom of the stacking order, which is what keeps it
# behind every other window instead of covering them.
pcmanfm --desktop &

# The window manager's pid, recorded so the desktop menu can reach it.
#
# exec does not change the pid, so $$ here IS what ctwm will be running as a
# line further down.  That is the whole reason this can be written in advance:
# ctwm advertises no window a client could ask to restart or quit -- it sets
# _NET_SUPPORTING_WM_CHECK but no _NET_WM_PID -- and it restarts on SIGHUP and
# shuts down on SIGTERM, so a pid is all a menu entry needs.  Written before
# the exec rather than after, because there is no after.
echo $$ > "$HOME/.ctwm.pid"

# The window manager runs in the FOREGROUND, which is the conventional
# arrangement for twm and its relatives: "Exit" on the root menu then ends the
# session and stops the server, rather than merely removing the decorations.
exec ctwm

# Which application opens which kind of file, installed as
# /usr/share/applications/mimeapps.list.
#
# mimeinfo.cache, generated beside this file at image-build time, says which
# applications CAN open a type -- every one that claims it.  This file says
# which one is chosen when the user does not pick, and it is why
# double-clicking a file opens something instead of a chooser dialog.
#
# A user's own ~/.config/mimeapps.list overrides this entirely, and PCManFM
# writes to that file when "Open With..." is used with "Set as default"
# ticked.  Nothing here is a choice the user is held to.
#
# The names are desktop-entry file names in this same directory, so a program
# is only worth naming here if its .desktop file is installed.
#
# Copyright (C) 2026 The LikeOS Project

[Default Applications]
# Folders open in LikeOS Explorer (likeos-explorer).  The PCManFM desktop asks
# this same question when a folder on it is opened (gtk3 patch pcmanfm/0007),
# so a folder window is always Explorer's while the desktop stays PCManFM's.
# trash: is how other programs ask for the Trash.
inode/directory=likeos-explorer.desktop
x-scheme-handler/trash=likeos-explorer.desktop

# Text of every kind goes to Mousepad -- it is the graphical editor on this
# image, and text/plain is the type most files that are not something else
# resolve to.  The subtypes are listed because a source file is not text/plain:
# the shared MIME database gives it its own type (text/x-csrc and the rest),
# which does not inherit a default from its parent.
text/plain=org.xfce.mousepad.desktop
text/x-csrc=org.xfce.mousepad.desktop
text/x-chdr=org.xfce.mousepad.desktop
text/x-c++src=org.xfce.mousepad.desktop
text/x-c++hdr=org.xfce.mousepad.desktop
text/x-makefile=org.xfce.mousepad.desktop
text/x-python=org.xfce.mousepad.desktop
text/x-shellscript=org.xfce.mousepad.desktop
text/x-diff=org.xfce.mousepad.desktop
text/x-log=org.xfce.mousepad.desktop
text/markdown=org.xfce.mousepad.desktop
text/csv=org.xfce.mousepad.desktop
application/json=org.xfce.mousepad.desktop
application/x-shellscript=org.xfce.mousepad.desktop
application/xml=org.xfce.mousepad.desktop
text/xml=org.xfce.mousepad.desktop

# Web pages and the http(s) schemes go to luakit, the WebKit browser: it is
# the one on this image that renders a current page, and a default that opened
# something else would be a default nobody keeps.
#
# Exactly the types luakit's own desktop entry claims, no more.  Its MimeType
# line is the program's statement about what it handles, and using anything
# else as the rule here would be this file guessing on its behalf.
text/html=luakit.desktop
application/xhtml+xml=luakit.desktop
x-scheme-handler/http=luakit.desktop
x-scheme-handler/https=luakit.desktop

# Pictures open in LikeOS Image Viewer (imageviewer, gtk3/likeos-imageviewer-
# 1.0): every format its desktop entry claims -- what the image library's
# built-in loaders read, and WebP, which it decodes itself.  Double-clicking a
# picture in LikeOS Explorer asks this file, so this is what makes a picture
# open in the viewer, with the rest of its folder to browse.
image/png=likeos-imageviewer.desktop
image/jpeg=likeos-imageviewer.desktop
image/pjpeg=likeos-imageviewer.desktop
image/jpg=likeos-imageviewer.desktop
image/gif=likeos-imageviewer.desktop
image/webp=likeos-imageviewer.desktop
image/bmp=likeos-imageviewer.desktop
image/x-bmp=likeos-imageviewer.desktop
image/x-ms-bmp=likeos-imageviewer.desktop
image/tiff=likeos-imageviewer.desktop
image/vnd.microsoft.icon=likeos-imageviewer.desktop
image/x-icon=likeos-imageviewer.desktop
image/x-ico=likeos-imageviewer.desktop
image/x-win-bitmap=likeos-imageviewer.desktop
image/x-portable-anymap=likeos-imageviewer.desktop
image/x-portable-bitmap=likeos-imageviewer.desktop
image/x-portable-graymap=likeos-imageviewer.desktop
image/x-portable-pixmap=likeos-imageviewer.desktop
image/x-tga=likeos-imageviewer.desktop
image/x-targa=likeos-imageviewer.desktop
image/x-xpixmap=likeos-imageviewer.desktop
image/x-xbitmap=likeos-imageviewer.desktop
image/x-icns=likeos-imageviewer.desktop
image/x-quicktime=likeos-imageviewer.desktop
image/qtif=likeos-imageviewer.desktop

# PDF goes to the browser: WebKit is built with its PDF.js viewer
# (ENABLE_PDFJS, on by default for the GTK port, and the viewer bundle is
# compiled into libwebkit2gtk), so luakit renders a PDF handed to it as a path
# or file:// URI, and nothing else on the image reads one.  Assigned here
# because luakit's desktop entry does not claim the type.  Claws Mail does not consult this file for attachments; /etc/mailcap
# carries the matching rule for it.
application/pdf=luakit.desktop

# Mail: a mailbox file, and the mailto: links every other program produces.
application/mbox=claws-mail.desktop
message/rfc822=claws-mail.desktop
x-scheme-handler/mailto=claws-mail.desktop

# A .desktop file is a launcher, and editing one is what lxshortcut does.
application/x-desktop=lxshortcut.desktop

# Music, video and playlists play in the media player.
audio/mpeg=mediaplayer.desktop
audio/flac=mediaplayer.desktop
audio/ogg=mediaplayer.desktop
audio/x-vorbis+ogg=mediaplayer.desktop
audio/x-opus+ogg=mediaplayer.desktop
audio/x-wav=mediaplayer.desktop
audio/mp4=mediaplayer.desktop
audio/x-mpegurl=mediaplayer.desktop
audio/x-scpls=mediaplayer.desktop
video/mp4=mediaplayer.desktop
video/x-matroska=mediaplayer.desktop
video/webm=mediaplayer.desktop
video/ogg=mediaplayer.desktop

[Desktop Entry]
# Desktop entry for the Settings window (likeos-settings, built from
# user/bin/shell/settings.c): the cards that open each area's own settings.
# The launcher lists it as "Settings"; the Control Center's Settings button
# and the launcher's Settings chip open it too.  The areas' own windows have
# entries of their own, hidden from the menus.
#
# Copyright (C) 2026 The LikeOS Project
Type=Application
Version=1.0
Name=Settings
GenericName=System settings
Comment=Display, keyboard and the other settings of the system
Exec=likeos-settings
Icon=preferences-system
Terminal=false
StartupNotify=false
Categories=Settings;System;
Keywords=settings;preferences;control;panel;display;screen;resolution;keyboard;layout;language;input;

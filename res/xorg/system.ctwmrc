#
# $XConsortium: system.twmrc,v 1.8 91/04/23 21:10:58 gildea Exp $
#
# Default twm configuration file; needs to be kept small to conserve string
# space in systems whose compilers don't handle medium-sized strings.
#
# Sites should tailor this file, providing any extra title buttons, menus, etc.
# that may be appropriate for their environment.  For example, if most of the
# users were accustomed to uwm, the defaults could be set up not to decorate
# any windows and to use meta-keys.
#

TitleFont	"-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
ResizeFont	"-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
MenuFont	"-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
IconFont	"-adobe-helvetica-bold-r-normal--*-100-*-*-*-*-*-*"
IconManagerFont	"-adobe-helvetica-bold-r-normal--*-100-*-*-*"
ShowWorkSpaceManager			# start with workspace manager up
UseThreeDMenus
UseThreeDTitles
UseThreeDIconManagers
UseThreeDBorders
UseThreeDWMap
#
# SunkFocusWindowTitle is deliberately NOT set (upstream had it).  It draws the
# FOCUSED window's title bar and its buttons pressed-in, so the active window
# looked like its controls were being held down while every other window looked
# normal.  Focus is still visible -- the title bar highlights and the taskbar
# entry takes IconManagerHighlight -- without the decoration changing shape.
#
#
# Focus and stacking, the way a Windows user expects: pressing a mouse button
# ANYWHERE in a window focuses it (so its title bar highlights) and raises it.
#
# Without ClickToFocus, ctwm follows the pointer, so moving onto a second xterm
# focused it silently and pressing a button changed nothing visible.
#
# The click is NOT eaten.  This is handled in one place in HandleButtonPress,
# which sets the focus and then calls XAllowEvents(ReplayPointer) -- so the
# press still reaches the application and a click that also selects text or
# presses a button behaves normally.
#
# RaiseOnClick is deliberately NOT set, and that is not a style choice.
#
# ctwm does not recognise PCManFM's desktop as a desktop window: f.identify
# reports `OnTopPriority = 0' for it, which is the NORMAL plane (a window ctwm
# had typed as _NET_WM_WINDOW_TYPE_DESKTOP would report -8, since
# EwmhGetInitPriority gives it EWMH_PRI_DESKTOP).  With RaiseOnClick on, a
# window in the normal plane comes to the front when clicked -- and the desktop
# is full-screen, so clicking the background put it over every other window.
# That is what made "all the ctwm controls disappear", and it is also why a
# click aimed at a file-manager window afterwards landed on the desktop instead
# and opened the root menu.
#
# Raising is still available where it belongs: button 1 on a title bar is
# f.function "move-or-raise", and button 2 there is f.raiselower.
#
# The underlying question -- why ctwm does not see the DESKTOP type when
# PCManFM does set it in fm_desktop_constructor -- is still open.  To settle it,
# run `xprop' and click the desktop background: if _NET_WM_WINDOW_TYPE is
# _NET_WM_WINDOW_TYPE_DESKTOP then the fault is in ctwm's reading of it, and if
# the property is absent it is GTK's or PCManFM's.  Once that is fixed the
# desktop sits in the -8 plane and RaiseOnClick could come back.
ClickToFocus

#
# Minimise into the taskbar instead of onto the desktop.
#
# Iconifying normally leaves a little icon window lying on the root.  Unmapping
# instead means the window simply disappears, and the entry it already has in
# the icon manager at the top IS the minimised state -- click that entry to get
# the window back.
IconifyByUnmapping

#
# Title buttons: minimise, maximise, close -- in that order, left to right.
#
# NoDefaults is required.  Without it ctwm adds its own two ("dot" to iconify on
# the LEFT, "resize" on the right) and there is no way to remove just those.  It
# also drops the six fallback mouse bindings AddDefaultFuncButtons() installs
# (buttons 1 and 2 on title, icon and iconmgr) -- every one of which this file
# already binds explicitly further down, which is what makes it safe here.
#
# Right-side buttons are laid out left to right in the order declared
# (win_decorations.c walks the list adding boxwidth each time), so close ends up
# in the corner rather than where minimise is expected.
NoDefaults
RightTitleButton ":xpm:bar"     = f.iconify
RightTitleButton ":xpm:zoom"    = f.fullzoom
RightTitleButton ":xpm:cross"   = f.delete

#
# Four workspaces.  With the four columns set below that is a single row, which
# is what the bar's 52px height has room for -- eight would have wrapped to a
# second row of 26px buttons.
#
# Fields per workspace, as ctwm's workspace_config.c documents them:
#     "name" { button-bg  button-fg  map-bg  map-fg  [root-image] }
#
# Field 3 is the background of each workspace's CELL in the workspace manager --
# the grey the little window blocks are drawn on.
#
# ctwm normally uses that same colour for the DESKTOP too
# (XSetWindowBackground(vs->window, ws->backcp.back) in workspace_manager.c), so
# grey cells would have forced a grey desktop.  DontPaintRootWindow, set below,
# switches only the root half of that off: the cells still take field 3, and the
# desktop is left to the xsetroot in xinitrc.  The two are independent now, which
# is what lets the cells be grey and the desktop teal.
#
# The root-image field upstream used is dropped: one entry named an .xpm that is
# not installed here, and the other asked for the "plaid" pattern -- both only
# per-workspace, so the background changed as you switched desktops.
#
WorkSpaces {
    "1" {"#c6c6c6" "black" "#c6c6c6" "black"}
    "2" {"#c6c6c6" "black" "#c6c6c6" "black"}
    "3" {"#c6c6c6" "black" "#c6c6c6" "black"}
    "4" {"#c6c6c6" "black" "#c6c6c6" "black"}
}

#
# Mouse pointers.
#
# ctwm's defaults are the old X set: "top_left_arrow" over frames, titles and
# icons (the thin skewed outline arrow), "hand2" over the title buttons and
# "sb_left_arrow" over menus.  "left_ptr" is the plain arrow every current
# desktop uses, and it is what these should all be.
#
# Kept as they are, because they say something a plain arrow could not, and
# because Windows shows its own equivalents in the same situations:
#   Move/Resize  fleur  - a drag is in progress
#   Wait         watch  - busy
#   Destroy      pirate - the next click KILLS the window it lands on; that is
#                         worth a pointer that does not look routine
#
# The DESKTOP pointer is not here: ctwm never sets a cursor on the root window,
# so the X-shaped one comes from the server's own default and has to be replaced
# with xsetroot -cursor_name (see xinitrc).
#
Cursors
{
    Frame    "left_ptr"
    Title    "left_ptr"
    Icon     "left_ptr"
    IconMgr  "left_ptr"
    Button   "left_ptr"
    Menu     "left_ptr"
    Select   "left_ptr"
    Move     "fleur"
    Resize   "fleur"
    Wait     "watch"
    Destroy  "pirate"
}

###########################################################
# Top desktop bar
###########################################################

#
# Workspace manager (right side)
#
# ONE number, not two: the grammar is "WorkSpaceManagerGeometry <geom>
# <columns>" and there is no row argument -- rows come out of the workspace
# count divided by the columns.  Four workspaces over four columns is therefore
# a single row, each button 250/4 = 62px wide and the full 52px height.
#
# Anchored to the RIGHT edge with -0, so it stays in the corner whatever
# resolution the framebuffer comes up at (this driver picks anything from
# 1024x768 to 1920x1200).
WorkSpaceManagerGeometry        "250x52-0+0" 4

# Leave the root window alone.  Without this ctwm repaints the desktop from the
# current workspace's field 3 every time a workspace is mapped, which would tie
# the desktop colour to the workspace cell colour.
DontPaintRootWindow

#
# Icon manager (taskbar)
#
# The number is COLUMNS, and it is what makes the bar horizontal: each entry is
# width/columns wide and a new row starts only once a row is full
# (PackIconManager in iconmgr.c).  At 1 every entry was full-width and they
# stacked downward, which is the vertical strip this replaces.  Five columns of
# 600/5 = 120px each is enough for a window name.
ShowIconManager
NoIconManagerFocus

#
# Geometry:
# Width x Height + X + Y
#
# Left-anchored past the clock AND the load graph (0..60 clock, 64..164 xload,
# so the bar starts at 168).  600 wide keeps it clear of the workspace manager's
# 250 at the right edge on a 1024-wide screen.
#
# Unlike the workspace manager this cannot stretch to the space available --
# ctwm has no way to say "the rest of the row" -- so it is sized for the
# narrowest mode; on a wider screen the gap before the workspace manager simply
# grows.  Widen the 600 to suit.
IconManagerGeometry             "600x52+168+0" 5

#
# Make it look like a panel: undecorated, and present on every workspace rather
# than only the one it was opened on.
#
# AlwaysOnTop is deliberately NOT set for these.  It works -- but it also wins
# against every window that overlaps the bar, and a new xterm placed under it
# had its title bar hidden, leaving nothing to grab to move the window.  With
# normal stacking new windows come up ABOVE the bar.
#
# To bring the bar back to the front: button 3 on the taskbar raises it (bound
# below), and meta-button-3 raises any window, the workspace manager included.
#
NoTitle
{
    "TWM Icon Manager"
    "WorkSpaceManager"
    "xclock"
    "xload"
}

NoBorder
{
    "TWM Icon Manager"
    "WorkSpaceManager"
    "xclock"
    "xload"
}

OccupyAll
{
    "TWM Icon Manager"
    "WorkSpaceManager"
    "xclock"
    "xload"
}

#
# Don't list the panel itself
#
IconManagerDontShow
{
    "TWM Icon Manager"
    "WorkSpaceManager"
    "xclock"
    "xload"
}

#
# Solaris/CDE palette.  Three colours do all the work:
#
#   #c6c6c6  light grey  - every frame, title bar, menu and the taskbar
#   #ae5c8c  dusty pink  - "this one is active": focused border, menu titles
#   #40408c  dark blue   - the window blocks drawn inside the workspace map
#
# The greys are flat rather than saturated on purpose: UseThreeD* shades its
# bevels FROM the base colour, so a strong colour there produces harsh edges.
#
# Focus is shown by BorderColor alone.  ctwm paints the border of the FOCUSED
# window in BorderColor and fills every other window's border from the
# BorderTile pair, so pink borders mark the active window while the rest stay
# grey -- and the title bar itself does not change shape (see the note about
# SunkFocusWindowTitle at the top of this file).
#
Color
{
    BorderColor           "#ae5c8c"
    DefaultBackground     "#c6c6c6"
    DefaultForeground     "black"
    BorderTileBackground  "#c6c6c6"
    BorderTileForeground  "#8c8c8c"
    TitleBackground       "#c6c6c6"
    TitleForeground       "black"
    MenuBackground        "#c6c6c6"
    MenuForeground        "black"
    MenuTitleBackground   "#ae5c8c"
    MenuTitleForeground   "white"
    IconBackground        "#c6c6c6"
    IconForeground        "black"
    IconBorderColor       "#8c8c8c"
    IconManagerBackground "#c6c6c6"
    IconManagerForeground "black"
    IconManagerHighlight  "#ae5c8c"
    MapWindowBackground   "#40408c"
    MapWindowForeground   "white"
}

# The IconManagerGeometry, IconManagerDontShow and NoTitle that upstream set here
# now live in the "Top desktop bar" section above, with the panel's values (a wide
# short bar at the top rather than a tall column on the right, and xclock listed
# as well).  Removed rather than left in place: ctwm accepts either of them twice
# without complaint -- the window lists would simply accumulate, and the second
# geometry would silently win -- so a leftover copy here would be a trap for
# whoever next changes the bar and cannot see why it has no effect.
#
# Define some useful functions for motion-based actions.
#
MoveDelta 3
Function "move-or-lower" { f.move f.deltastop f.lower }
Function "move-or-raise" { f.move f.deltastop f.raise }
Function "move-or-iconify" { f.move f.deltastop f.iconify }

#
# Set some useful bindings.  Sort of uwm-ish, sort of simple-button-ish
#
#
# Root menu: the LEFT button over the background opens it.
#
# That takes a patch on PCManFM's side to work at all.  A window manager only
# hears about root-window clicks by selecting ButtonPressMask ON the root -- it
# does not grab them -- and PCManFM's desktop covers the root completely, so
# every click on the background stops there and never reaches ctwm.  PCManFM
# already hands button 3 back when show_wm_menu is set; the port patch
# 0001-give-the-window-manager-button-1-on-the-blank-desktop does the same for
# button 1, so this binding fires again.
#
# Only the PRESS is forwarded, never the release.  ctwm posts the menu on the
# press and grabs the pointer for it, so a forwarded release would land on the
# menu it had just posted and pick whatever entry sat under the cursor -- which
# is how a desktop click used to select "Restart ctwm" and strip the session.
#
# Button 3 stays PCManFM's (show_wm_menu=0), so the desktop keeps its own
# context menu.  Alt+F1 and Alt+F2 reach the same two menus from the keyboard,
# which is the way back if the desktop is not running or has died.
#
# StayUpMenus is what makes a posted menu stay: without it a ctwm menu is
# press-drag-release, so it would vanish the instant the button came up.  With
# it, a press that does not select simply leaves the menu posted, and the next
# click either activates the entry under the pointer or dismisses it.
#
StayUpMenus

Button1 =	: root		: f.menu "defops"
Button2 =	: root		: f.menu "windowops"

"F1" = m	: all		: f.menu "defops"
"F2" = m	: all		: f.menu "windowops"

Button1 = m	: window|icon	: f.function "move-or-lower"
Button2 = m	: window|icon	: f.iconify
Button3 = m	: window|icon	: f.function "move-or-raise"

Button1 =	: title		: f.function "move-or-raise"
Button2 =	: title		: f.raiselower
Button1 = m     : title		: f.movetitlebar

Button1 =	: icon		: f.function "move-or-iconify"
Button2 =	: icon		: f.iconify

Button1 =	: iconmgr	: f.iconify
Button2 =	: iconmgr	: f.iconify
# Button 3 was free here.  It raises the taskbar itself, which is the way back
# when a window has come up over the bar (see the panel section above).
Button3 =	: iconmgr	: f.raise

Button1 =	: frame		: f.resize
Button1 = m	: frame		: f.move
Button2 =	: frame		: f.raiselower
#
# And a menus with the usual things
#
#
# Root menu.  Only programs that are actually installed appear here: upstream
# offered xcalc, xman and xmag, none of which is in this port, and a menu entry
# that runs a command the system does not have is worse than no entry -- it
# fails silently, with nothing on screen to say why.
#
# When a program is added to ports/xorg/packages.list and staged, add it here.
#
menu "defops"
{
    "LikeOS"		f.title
    "Xterm"		!"xterm&"
    "Explorer"		!"pcmanfm &"
    "Editor"		!"mousepad &"
    "Xnedit"	!"xnedit &"
    "Mail"		!"claws-mail &"
    "Browser"	!"netsurf &"
    "Calculator"	!"xcalc &"
    ""			f.separator
    "Restart ctwm"	f.restart
    "Exit session"	f.quit
}

#
# PCManFM's desktop is started by xinitrc, not from here.  It draws the home
# folder, the trash and any mounted volume on the background, and it owns the
# right button over that background -- which is why the root menu above is on
# the left one.  A desktop is part of the session, not something to be switched
# on from a menu after the fact.
#

menu "windowops" {
    "Windows"		f.title
    "Occupy"		f.occupy
    "Occupy All"	f.occupyall
    "Iconify"		f.iconify
    "Refresh"		f.refresh
    "Vanish"		f.vanish
    "Info"		f.identify
    ""			f.separator
    "Resize"		f.resize
    "Move"		f.move
    "Raise"		f.raise
    "Lower"		f.lower
    "Animate"		f.startanimation
    "Don't animate"	f.stopanimation
    ""			f.separator
    "Send Delete"	f.delete
    "Kill Window"	f.destroy
    "Pin menu"		f.pin
}

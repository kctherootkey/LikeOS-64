# Claws Mail defaults for a new account on LikeOS-64.
#
# Copied to ~/.claws-mail the first time the program runs, by the copy_dir() of
# SYSCONFDIR/skel/.claws-mail in src/main.c.  Only the settings that this system
# actually needs to differ on are listed; every key left out keeps the built-in
# default, which is how the file is meant to be used.
#
# The fonts are the point.  Claws asks for "Sans" and "Monospace", which are
# fontconfig aliases -- they resolve here, but only because the shipped conf.d
# maps them, and they resolve to whatever happens to be installed.  Naming the
# font that IS installed removes the guess: DejaVu is the only scalable family
# on the image, and Pango renders through FreeType, so an alias that failed to
# resolve would leave the reader showing blank lines rather than falling back.
#
# Sizes are one point larger than upstream's 9, which is chosen for displays
# considerably denser than the ones this runs on.
#
# The block label is not decoration: prefs_read_config() in src/prefs_gtk.c
# skips everything up to the "[Common]" line and stops at the next '[', so a
# key placed outside that block is never read at all.  Every setting below,
# up to the plugin block, must stay inside it.

[Common]
message_font_gtk2=DejaVu Sans Mono 10
print_font_gtk2=DejaVu Sans Mono 10
small_font_gtk2=DejaVu Sans 9
normal_font_gtk2=DejaVu Sans 10
bold_font_gtk2=DejaVu Sans Bold 10

# Show the HTML part of multipart/alternative mail by default.  Upstream
# prefers the text/plain part and leaves the HTML one as a click-to-view
# alternative; with the fancy viewer loaded below there is no reason to make
# the reader click through on every message.  Per-folder settings can still
# override this (folder properties -> "HTML messages").
promote_html_part=1

# The programs Claws hands things off to.
#
# Upstream's defaults are firefox, gedit and xdg-open -- reasonable on the
# distributions Claws is packaged for, none of which exist here.  Left alone,
# clicking a link in a message spawns a browser that is not installed and the
# link simply never opens, with the failure reported nowhere the user is
# looking.  luakit is the browser this image ships, and there is no
# desktop-file database for an xdg-open to consult, so an attachment is better
# handed to the browser -- which reads HTML, text and images -- than to nothing
# at all.
#
# The editor is a terminal one, so it is given a terminal: Claws spawns this
# command directly, not through a shell and not in a console, so a bare `nano'
# would start with no tty and exit immediately.
#
# The quoting matters: Claws substitutes the path or URI into the one %s, and
# the single quotes keep a URI containing shell metacharacters as one word.
uri_open_command=luakit '%s'
mime_open_command=luakit '%s'
ext_editor_command=xterm -e nano %s

# Plugins loaded at startup.  The block label is what src/common/plugin.c
# looks for (PLUGINS_BLOCK_PREFIX + the plugin type, which is "GTK3" for a
# claws-mail 4 build); a bare filename resolves against the standard plugin
# directory, /usr/lib/claws-mail/plugins.  fancy is the WebKit HTML viewer --
# loaded from the first run so HTML mail renders instead of showing as a
# wall of markup.
[Plugins_GTK3]
fancy.so

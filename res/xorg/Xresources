! X resources for LikeOS, installed as /etc/X11/Xresources.
!
! Read via $XENVIRONMENT, which the session startup script exports.  That is
! the toolkit's own per-host resource file mechanism, and it needs no running
! program -- xrdb, which would instead publish these on the root window for
! every client to read, is not built here.
!
! These are OUR settings.  The app-defaults files under
! /usr/share/X11/app-defaults are installed exactly as their packages ship
! them, and nothing here edits them; resources from this file simply take
! precedence.
!
! xterm's built-in defaults are black text on a WHITE background, and the
! XTerm app-defaults file it ships does not change them (the dark scheme lives
! in XTerm-color, commented out for the user to choose).  Nothing else on this
! system expects a light terminal: the framebuffer console is light text on
! black, and programs that colour their output assume the same.  top prints its
! summary block in white, which on a white background is simply invisible --
! that is the whole of the "upper half of top is missing" symptom.
!
! Both colours are set, never one.  A program that changes only the foreground
! still has to land on a readable background, and vice versa.
XTerm*VT100*background:		black
XTerm*VT100*foreground:		gray90
XTerm*VT100*cursorColor:	gray90

! Colour is on so the ANSI colour escapes programs emit mean something.
XTerm*VT100*colorMode:		on
XTerm*VT100*boldColors:		on
XTerm*VT100*dynamicColors:	on

! Window size.  xterm's geometry is in CHARACTERS, not pixels -- 80x24 is the
! built-in default and is a small window on a 1920x1200 screen.
!
! 132x43 at the default 6x13 font is 792x559 pixels, which is the ~800x600 a
! terminal wants to be here; 132 columns is also the conventional wide-terminal
! width, so output formatted for it lines up.  Change the numbers, not the
! font, to resize: the pixel size follows from both together.
!
! A resource rather than -geometry in the ctwm menu, so an xterm started from a
! shell is the same size as one started from the menu -- and an explicit
! -geometry on a command line still outranks this.
XTerm*VT100.geometry:		132x43

! Scrollback.  A terminal without it loses everything that scrolls past, which
! matters more here than usual: this is where build and boot output is read.
/* Alt+key sends ESC-prefixed key, not the key with bit 7 set.
 *
 * xterm's default is eightBitInput: true, which encodes Meta+key as
 * key|0x80 -- and in a UTF-8 locale it then encodes THAT as a character,
 * so Alt+Tab arrives as U+0089 = the two bytes \302\211.  With no window
 * manager grabbing Alt+Tab, that lands in the shell, and the next thing
 * typed is glued onto it: bash reports $'\302\211cat': command not found.
 *
 * metaSendsEscape is what every terminal has done for decades and what
 * readline expects for its Alt- bindings. */
XTerm*metaSendsEscape:		true

XTerm*saveLines:		2048

! Send-to-scrollback on output is off, so a program drawing a full-screen
! display (top, tmux, nano) does not fill the scrollback with its redraws.
XTerm*scrollTtyOutput:		false
XTerm*scrollKey:		true

! The bar's clock and load monitor take no resources at all.  They are this
! system's own GTK programs (datetime and load, in user/bin/shell), not X
! clients, so they never consult this file: their colours are compiled in, set
! to the same grey as the taskbar they sit beside.

! Cursor theme, for clients that use libXcursor directly rather than through
! GTK (xterm, ctwm, the Athena programs).  The theme is generated by
! host/gen-cursors.c and defines only the busy cursors; anything it does not
! provide falls back to the X core cursor font, as it did before.
Xcursor.theme: LikeOS
Xcursor.size: 32

+	newpath = fd_target_path(dirfd, path);
+	if (newpath) {
+		if (!*path)
+			*at_flags &= ~AT_SYMLINK_NOFOLLOW;
+		return newpath;
+	}
+#endif
 	if (!*path) {
 		*at_flags &= ~AT_SYMLINK_NOFOLLOW;

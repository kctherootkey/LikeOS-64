--- a/libmisc/uid_gid_lookup.c	2026-11-13 15:14:53.017595100 +0100
+++ b/libmisc/uid_gid_lookup.c	2026-11-13 15:14:53.018673946 +0100
@@ -60,7 +60,7 @@
 		}
 		l = -l & 0xFFFF;
 	}
-	if ((uid_t)(gid_t)l != l || l == ACL_UNDEFINED_ID) {
+	if ((uid_t)(gid_t)l != l || l == (uid_t)ACL_UNDEFINED_ID) {
 		errno = ERANGE;
 		return -1;
 	}

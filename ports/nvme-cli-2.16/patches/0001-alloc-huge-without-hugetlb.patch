--- a/util/mem.c	2025-11-04 10:36:51.000000000 +0100
+++ b/util/mem.c	2026-11-11 11:55:49.043778405 +0100
@@ -64,12 +64,14 @@
 	 *
 	 * https://www.kernel.org/doc/Documentation/vm/hugetlbpage.txt
 	 */
+#ifdef MAP_HUGETLB
 	mh->p = mmap(NULL, len, PROT_READ | PROT_WRITE,
 		     MAP_ANONYMOUS | MAP_PRIVATE | MAP_HUGETLB, -1, 0);
 	if (mh->p != MAP_FAILED) {
 		mh->len = len;
 		return mh->p;
 	}
+#endif
 

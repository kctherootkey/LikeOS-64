# Makefile.likeos - build the NTFS tools of ntfs-3g 2026.9.28 (mkntfs,
# ntfsfix, ntfslabel, ntfsinfo) for LikeOS
#
# The tarball (ntfs-3g and ntfsprogs in one) is unpacked and patched by
# unpack.sh into src/; configure is not run.  config.h in this directory
# stands in for the config.h configure would write; the source lists are the
# release's libntfs-3g/Makefile.am (with the default unix_io device
# operations) and ntfsprogs/Makefile.am.  Only the command-line tools are
# built: no FUSE driver (src/, libfuse-lite), no mount helper, no
# ntfsdecrypt (crypto).
#
# mkntfs gives the volume a GUID with uuid_generate() from util-linux's
# libuuid (ports/util-linux-2.42.4, built first by the top-level
# ports-ntfsprogs target), a static archive like e2fsprogs links it.
#
# Library (static archive in build/, linked into the programs):
#   libntfs-3g  the NTFS library
#
# Programs (build/), installed to /sbin:
#   mkntfs (+ mkfs.ntfs)  ntfsfix  ntfslabel  ntfsinfo
#
# Copyright (C) 2026 The LikeOS Project

CC = gcc
LD = ld
AR = ar

LIBC_DIR = ../../user/lib/libc
RTLD_DIR = ../../user/lib/rtld
UL_DIR = ../util-linux-2.42.4

SRC_STAMP := .likeos-unpacked
PATCHES := $(wildcard patches/*.patch)
S := src
B := build
G := $(B)/gen
O := $(B)/obj

VERSION := 2026.9.28

GCC_INC := $(shell $(CC) -print-file-name=include)

# -nostdinc: only the LikeOS libc headers and gcc's own (stddef.h, stdarg.h
# ...) are visible, so a header the libc lacks fails here instead of being
# taken silently from the build host.  "-I." finds config.h, $(G) holds
# util-linux's uuid/uuid.h.
CFLAGS = -O2 -nostdlib -nostdinc -fno-builtin -fstack-protector-strong \
         -mno-red-zone -ffreestanding -fPIE -fno-common \
         -D__LIKEOS__ -DHAVE_CONFIG_H \
         -isystem $(LIBC_DIR)/include -isystem $(GCC_INC) \
         -I. -I$(S)/include/ntfs-3g -I$(G)
# A function the libc does not declare is an error, not a guess at its type.
CFLAGS += -Werror=implicit-function-declaration -Werror=implicit-int
# What configure adds for gcc.
CFLAGS += -Wall
# The package's own code, the package's own warnings (packed on-disk
# structures, trailing zero-length arrays): not this port's to fix.
CFLAGS += -Wno-address-of-packed-member -Wno-zero-length-bounds

LDFLAGS = -pie -nostdlib -T ../../user/bin/user_dyn.lds --hash-style=gnu \
          -z now -z relro -rpath /lib -dynamic-linker /lib/ld-likeos.so \
          -L$(LIBC_DIR) -L$(RTLD_DIR)
CRT1 = $(LIBC_DIR)/crt1.o
LIBGCC := $(shell $(CC) -print-libgcc-file-name)
LIBS = -lc -l:ld-likeos.so $(LIBGCC)

obj = $(addprefix $(O)/,$(1:.c=.o))

# ioctl.c is left out: its one function is the FUSE driver's ioctl entry
# (file system trim), which none of the tools calls.
LIBNTFS_SRC = $(addprefix libntfs-3g/,acls.c attrib.c attrlist.c bitmap.c \
	bootsect.c cache.c collate.c compat.c compress.c debug.c device.c \
	dir.c ea.c efs.c index.c inode.c lcnalloc.c logfile.c \
	logging.c mft.c misc.c mst.c object_id.c realpath.c reparse.c \
	runlist.c security.c unistr.c volume.c xattrs.c unix_io.c)
LIBNTFS_OBJ = $(call obj,$(LIBNTFS_SRC))

MKNTFS_OBJ    = $(call obj,$(addprefix ntfsprogs/,attrdef.c boot.c sd.c \
	mkntfs.c utils.c))
NTFSFIX_OBJ   = $(call obj,ntfsprogs/ntfsfix.c ntfsprogs/utils.c)
NTFSLABEL_OBJ = $(call obj,ntfsprogs/ntfslabel.c ntfsprogs/utils.c)
NTFSINFO_OBJ  = $(call obj,ntfsprogs/ntfsinfo.c ntfsprogs/utils.c)

LIBNTFS = $(B)/libntfs-3g.a
# util-linux's libuuid and the helpers it is built on.
UL_LIBS = $(UL_DIR)/build/libuuid.a $(UL_DIR)/build/libcommon.a

PROGS = mkntfs ntfsfix ntfslabel ntfsinfo
TARGETS = $(addprefix $(B)/,$(PROGS))

.SUFFIXES:

all: $(SRC_STAMP)
	$(MAKE) -f Makefile.likeos programs

programs: $(TARGETS)

# Re-unpack whenever the tarball or a patch changes.
$(SRC_STAMP): ntfs-3g_ntfsprogs-$(VERSION).tgz $(PATCHES) unpack.sh
	$(SHELL) ./unpack.sh --force
	@touch $@

# util-linux's public libuuid header, where mkntfs.c includes it from.
$(G)/uuid/uuid.h: $(UL_DIR)/src/libuuid/src/uuid.h
	@mkdir -p $(dir $@)
	cp $< $@

# Every object depends on every header: there are few of them.
HDRS = config.h $(G)/uuid/uuid.h $(wildcard $(S)/include/ntfs-3g/*.h \
	$(S)/ntfsprogs/*.h)

$(O)/%.o: $(S)/%.c $(SRC_STAMP) $(HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(LIBNTFS): $(LIBNTFS_OBJ)
	rm -f $@
	$(AR) rcs $@ $^

LINK = $(LD) $(LDFLAGS) $(CRT1) $(filter-out $(CRT1),$^) $(LIBS) -o $@

$(B)/mkntfs: $(MKNTFS_OBJ) $(LIBNTFS) $(UL_LIBS) $(CRT1)
	$(LINK)
$(B)/ntfsfix: $(NTFSFIX_OBJ) $(LIBNTFS) $(CRT1)
	$(LINK)
$(B)/ntfslabel: $(NTFSLABEL_OBJ) $(LIBNTFS) $(CRT1)
	$(LINK)
$(B)/ntfsinfo: $(NTFSINFO_OBJ) $(LIBNTFS) $(CRT1)
	$(LINK)

unpack: $(SRC_STAMP)

clean:
	rm -rf $(B)

distclean: clean
	rm -rf src $(SRC_STAMP)

.PHONY: all programs unpack clean distclean
.SECONDARY:

--- a/libntfs-3g/security.c	2026-09-18 14:47:54.000000000 +0200
+++ b/libntfs-3g/security.c	2026-11-20 16:02:38.202553271 +0100
@@ -44,6 +44,16 @@
 #ifdef HAVE_SYS_STAT_H
 #include <sys/stat.h>
 #endif
+/* The old names of the owner permission bits, where the libc lacks them */
+#ifndef S_IREAD
+#define S_IREAD S_IRUSR
+#endif
+#ifndef S_IWRITE
+#define S_IWRITE S_IWUSR
+#endif
+#ifndef S_IEXEC
+#define S_IEXEC S_IXUSR
+#endif
 
 #include <unistd.h>
 #include <pwd.h>

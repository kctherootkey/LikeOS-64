--- a/src/dumpkeys.c
+++ b/src/dumpkeys.c
@@ -11,8 +11,15 @@
 #include <fcntl.h>
 #include <getopt.h>
 #include <unistd.h>
+/* The console keyboard interface is reached through this platform's
+ * own headers; requests, structures and symbols are the same. */
+#ifdef __LIKEOS__
+#include <sys/kd.h>
+#include <sys/keyboard.h>
+#else
 #include <linux/kd.h>
 #include <linux/keyboard.h>
+#endif
 #include <sys/ioctl.h>
 #include <string.h>
 #include <errno.h>

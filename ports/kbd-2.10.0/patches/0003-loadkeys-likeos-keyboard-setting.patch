+/* likeos-keyboard.c - loadkeys and the system keyboard setting
+ *
+ * The keyboard layout of the system is one setting, /etc/likeos/keyboard.conf,
+ * shared by the console and the X session; its layouts are the lines of the
+ * catalogue /usr/share/likeos/keyboard/layouts.tsv, whose first field (the
+ * id) is also the name of the console keymap /usr/share/keymaps/<id>.map.
+ * Loading one of those keymaps with loadkeys therefore changes the setting:
+ *
+ *  - when the keymap was loaded, loadkeys runs
+ *        likeos-keyboard-save --console <id>
+ *    which records the layout (the X session follows the file);
+ *
+ *  - when this process may not load a keymap at all (an ordinary user in a
+ *    terminal window, where the console is not this process's terminal),
+ *    loadkeys hands the request to the helper's other form,
+ *        likeos-keyboard-save LAYOUT VARIANT OPTIONS
+ *    which records the layout and loads the console keymap itself.
+ *
+ * The helper is setuid root and checks everything it is given; this file
+ * only works out which catalogue entry a keymap file is.  --no-save turns
+ * all of it off (the helper itself and the boot use it).
+ *
+ * Copyright (C) 2026 The LikeOS Project
+ */
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <sys/kd.h>
+#include <sys/keyboard.h>
+
+#include "likeos-keyboard.h"
+
+#ifndef LIKEOS_KEYBOARD_CATALOGUE
+#define LIKEOS_KEYBOARD_CATALOGUE "/usr/share/likeos/keyboard/layouts.tsv"
+#endif
+#ifndef LIKEOS_KEYBOARD_CONF
+#define LIKEOS_KEYBOARD_CONF "/etc/likeos/keyboard.conf"
+#endif
+#ifndef LIKEOS_KEYBOARD_SAVE
+#define LIKEOS_KEYBOARD_SAVE "/usr/libexec/likeos-keyboard-save"
+#endif
+#ifndef LIKEOS_KEYMAP_DIR
+#define LIKEOS_KEYMAP_DIR "/usr/share/keymaps"
+#endif
+
+/* The catalogue line of `id': its XKB layout and variant (each at most
+ * cap - 1 bytes).  Returns 1 when `id' is in the catalogue. */
+static int catalogue_lookup(const char *id, char *layout, char *variant,
+			    size_t cap)
+{
+	FILE *f = fopen(LIKEOS_KEYBOARD_CATALOGUE, "r");
+	char line[512];
+	int found = 0;
+
+	if (!f)
+		return 0;
+	while (!found && fgets(line, sizeof(line), f)) {
+		char *field[5] = { 0 };
+		char *p = line;
+		int n = 0;
+
+		if (line[0] == '#' || line[0] == '\n')
+			continue;
+		line[strcspn(line, "\r\n")] = 0;
+		while (n < 5) {
+			field[n++] = p;
+			p = strchr(p, '\t');
+			if (!p)
+				break;
+			*p++ = 0;
+		}
+		if (n < 4 || strcmp(field[0], id) != 0)
+			continue;
+		snprintf(layout, cap, "%s", field[3]);
+		snprintf(variant, cap, "%s", n >= 5 ? field[4] : "");
+		found = 1;
+	}
+	fclose(f);
+	return found;
+}
+
+/* The console, as getfd() finds it, but without giving up the process when
+ * there is none: -1 then. */
+static int is_a_console(int fd)
+{
+	char arg = 0;
+
+	return isatty(fd) && ioctl(fd, KDGKBTYPE, &arg) == 0 &&
+	       (arg == KB_101 || arg == KB_84);
+}
+
+static int open_a_console(const char *name)
+{
+	/* O_NOCTTY: looking at the console must not make it the controlling
+	 * terminal of a session leader that has none (the boot's loadkeys). */
+	int fd = open(name, O_RDWR | O_NOCTTY);
+
+	if (fd < 0)
+		fd = open(name, O_WRONLY | O_NOCTTY);
+	if (fd < 0)
+		fd = open(name, O_RDONLY | O_NOCTTY);
+	if (fd >= 0 && !is_a_console(fd)) {
+		close(fd);
+		fd = -1;
+	}
+	return fd;
+}
+
+int likeos_console_fd(const char *name)
+{
+	static const char *const paths[] = { "/proc/self/fd/0", "/dev/tty",
+					     "/dev/tty0", "/dev/console", NULL };
+	int fd;
+
+	if (name)
+		return open_a_console(name);
+	for (int i = 0; paths[i]; i++)
+		if ((fd = open_a_console(paths[i])) >= 0)
+			return fd;
+	for (fd = 0; fd < 3; fd++)
+		if (is_a_console(fd))
+			return dup(fd);
+	return -1;
+}
+
+int likeos_may_load_keymap(int fd)
+{
+	/* Entry 0 of a keymap only checks the request; what it answers is
+	 * whether this process may change the keymap at all. */
+	struct kbentry ke = { 0, 0, K_HOLE };
+
+	return ioctl(fd, KDSKBENT, &ke) == 0 || errno != EPERM;
+}
+
+char *likeos_keymap_catalogue_id(const char *arg, const char *pathname)
+{
+	char real[PATH_MAX];
+	char layout[128], variant[128];
+	const char *base;
+	size_t dirlen = strlen(LIKEOS_KEYMAP_DIR);
+	size_t len;
+	char *id;
+
+	if (!arg || !pathname || !strcmp(arg, "-"))
+		return NULL;
+	/* The file that was found, through any alias link (de-latin1.map ->
+	 * de.map).  Only the system's own keymaps stand for a layout: a file
+	 * elsewhere that happens to be called de.map is not the German
+	 * layout. */
+	if (!realpath(pathname, real))
+		return NULL;
+	if (strncmp(real, LIKEOS_KEYMAP_DIR, dirlen) != 0 || real[dirlen] != '/')
+		return NULL;
+	base = real + dirlen + 1;
+	if (strchr(base, '/'))
+		return NULL;
+	len = strlen(base);
+	if (len > 4 && !strcmp(base + len - 4, ".map"))
+		len -= 4;
+	else if (len > 5 && !strcmp(base + len - 5, ".kmap"))
+		len -= 5;
+	id = strndup(base, len);
+	if (!id)
+		return NULL;
+	if (!catalogue_lookup(id, layout, variant, sizeof(layout))) {
+		free(id);
+		return NULL;
+	}
+	return id;
+}
+
+/* Run the helper with `argv'; its exit status, or -1 when it could not be
+ * run (errno says why). */
+static int run_helper(char *const argv[])
+{
+	pid_t pid;
+	int status;
+
+	pid = fork();
+	if (pid < 0)
+		return -1;
+	if (pid == 0) {
+		execv(LIKEOS_KEYBOARD_SAVE, argv);
+		_exit(errno == ENOENT ? 127 : 126);
+	}
+	while (waitpid(pid, &status, 0) < 0) {
+		if (errno != EINTR)
+			return -1;
+	}
+	if (!WIFEXITED(status))
+		return -1;
+	if (WEXITSTATUS(status) == 127) {
+		errno = ENOENT;
+		return -1;
+	}
+	return WEXITSTATUS(status);
+}
+
+static void warn_helper(int rc, const char *id, int quiet)
+{
+	if (rc == 0 || quiet)
+		return;
+	if (rc < 0)
+		fprintf(stderr,
+			"loadkeys: warning: the keyboard setting was not saved: "
+			"%s: %s\n",
+			LIKEOS_KEYBOARD_SAVE, strerror(errno));
+	else
+		fprintf(stderr,
+			"loadkeys: warning: the keyboard setting was not saved "
+			"(%s --console %s failed)\n",
+			LIKEOS_KEYBOARD_SAVE, id);
+}
+
+void likeos_keyboard_save_console(const char *id, int quiet)
+{
+	char *argv[] = { (char *)"likeos-keyboard-save", (char *)"--console",
+			 (char *)id, NULL };
+
+	warn_helper(run_helper(argv), id, quiet);
+}
+
+/* OPTIONS of the current setting (empty when there is none). */
+static void current_options(char *out, size_t cap)
+{
+	FILE *f = fopen(LIKEOS_KEYBOARD_CONF, "r");
+	char line[512];
+
+	out[0] = 0;
+	if (!f)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		char *v;
+		size_t n;
+
+		if (strncmp(line, "OPTIONS=", 8) != 0)
+			continue;
+		v = line + 8;
+		v[strcspn(v, "\r\n#")] = 0;
+		n = strlen(v);
+		while (n && (v[n - 1] == ' ' || v[n - 1] == '\t'))
+			v[--n] = 0;
+		if (n >= 2 && (v[0] == '"' || v[0] == '\'') && v[n - 1] == v[0]) {
+			v[n - 1] = 0;
+			v++;
+		}
+		snprintf(out, cap, "%s", v);
+	}
+	fclose(f);
+}
+
+int likeos_keyboard_delegate(const char *id)
+{
+	char layout[128], variant[128], options[512];
+	char *argv[] = { (char *)"likeos-keyboard-save", layout, variant,
+			 options, NULL };
+	int rc;
+
+	if (!catalogue_lookup(id, layout, variant, sizeof(layout)))
+		return -1;
+	current_options(options, sizeof(options));
+	rc = run_helper(argv);
+	if (rc < 0)
+		fprintf(stderr, "loadkeys: %s: %s\n", LIKEOS_KEYBOARD_SAVE,
+			strerror(errno));
+	return rc;
+}

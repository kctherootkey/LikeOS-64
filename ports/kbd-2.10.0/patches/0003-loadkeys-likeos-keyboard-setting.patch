+/* likeos-keyboard.h - loadkeys and the system keyboard setting
+ *
+ * See likeos-keyboard.c.
+ *
+ * Copyright (C) 2026 The LikeOS Project
+ */
+#ifndef LIKEOS_KEYBOARD_H
+#define LIKEOS_KEYBOARD_H
+
+/* A descriptor of the console (`name', or the usual places when NULL), or
+ * -1 when this process can reach none. */
+int likeos_console_fd(const char *name);
+
+/* Whether the process may load a keymap through `fd'. */
+int likeos_may_load_keymap(int fd);
+
+/* The catalogue id the keymap file `pathname' (found for the argument
+ * `arg') stands for: a keymap of the system's keymap directory, directly or
+ * through an alias link, whose name is a catalogue entry.  Malloc'd, or
+ * NULL when it is none. */
+char *likeos_keymap_catalogue_id(const char *arg, const char *pathname);
+
+/* After loading the keymap of catalogue entry `id': record it as the
+ * system's layout (likeos-keyboard-save --console).  A failure is a warning,
+ * printed unless `quiet'. */
+void likeos_keyboard_save_console(const char *id, int quiet);
+
+/* This process may not load a keymap: have the helper record the layout of
+ * catalogue entry `id' and load its keymap.  Returns the helper's exit
+ * status, or -1 when it could not be run. */
+int likeos_keyboard_delegate(const char *id);
+
+#endif

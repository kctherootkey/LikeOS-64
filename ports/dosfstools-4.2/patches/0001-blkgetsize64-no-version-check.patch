--- a/src/blkdev/blkdev.c	2021-01-31 13:49:12.000000000 +0100
+++ b/src/blkdev/blkdev.c	2026-11-11 15:02:49.391796713 +0100
@@ -95,7 +95,7 @@
 
 #ifdef BLKGETSIZE64
 	{
-#ifdef __linux__
+#if defined(__linux__) && !defined(__LIKEOS__)
 		int ver = get_linux_version();
 
 		/* kernels 2.4.15-2.4.17, had a broken BLKGETSIZE64 */

# config.subst - the values GNU tar's configure substitutes for the LikeOS
# libc, one "NAME<tab>VALUE" line per variable: what config.status would
# put for @NAME@ into gnu/, lib/ and src/Makefile.in and, through the
# Makefiles' header rules, into gnulib's replacement headers.
#
# Recorded by likeos-survey.sh (see there) and used by config-status.sh;
# CC, the flags and the directory names are Makefile.likeos's own.  Lines
# starting with # (they have no tab) are not values.
#
# Copyright (C) 2026 The LikeOS Project
ac_ct_AR	ar
ac_ct_CC	
ACLOCAL	${SHELL} '$(abs_top_srcdir)/build-aux/missing' aclocal-1.16
ALLOCA	
ALLOCA_H	alloca.h
AM_BACKSLASH	\
AM_DEFAULT_V	$(AM_DEFAULT_VERBOSITY)
AM_DEFAULT_VERBOSITY	0
AMDEPBACKSLASH	\
AMDEP_FALSE	#
AMDEP_TRUE	
am__EXEEXT_FALSE	
am__EXEEXT_TRUE	#
am__fastdepCC_FALSE	#
am__fastdepCC_TRUE	
am__include	include
am__isrc	 -I$(srcdir)
am__leading_dot	.
am__nodep	_no
am__quote	
am__tar	tar --format=ustar -chf - "$$tardir"
AMTAR	$${TAR-tar}
am__untar	tar -xf -
AM_V	$(V)
APPLE_UNIVERSAL_BUILD	0
AR	ar
ARFLAGS	cr
ASSERT_H	
AUTOCONF	${SHELL} '$(abs_top_srcdir)/build-aux/missing' autoconf
AUTOHEADER	${SHELL} '$(abs_top_srcdir)/build-aux/missing' autoheader
AUTOM4TE	${SHELL} '$(abs_top_srcdir)/build-aux/missing' autom4te
AUTOMAKE	${SHELL} '$(abs_top_srcdir)/build-aux/missing' automake-1.16
AWK	gawk
BACKUP_LIBEXEC_SCRIPTS	
BACKUP_SBIN_SCRIPTS	
BACKUP_SED_COND	/^\#ELSE_DATE_FORMAT_OK/,/^\#ENDIF_DATE_FORMAT_OK/d;/^\#IF_DATE_FORMAT_OK/d
bindir	${exec_prefix}/bin
bindir_c	"/usr/bin"
bindir_c_make	\"$(bindir)\"
BITSIZEOF_PTRDIFF_T	64
BITSIZEOF_SIG_ATOMIC_T	32
BITSIZEOF_SIZE_T	64
BITSIZEOF_WCHAR_T	32
BITSIZEOF_WINT_T	32
build	x86_64-pc-linux-gnu
build_alias	x86_64-linux-gnu
build_cpu	x86_64
build_os	linux-gnu
build_vendor	pc
CC	gcc
CCDEPMODE	depmode=gcc3
CFLAGS	-O2
CFLAG_VISIBILITY	-fvisibility=hidden
CLOCK_TIME_LIB	
CPP	gcc -E
CPPFLAGS	
CSCOPE	cscope
CTAGS	ctags
CXX_HAS_CHAR8_TYPE	0
CXX_HAS_UCHAR_TYPES	0
CYGPATH_W	echo
datadir	${datarootdir}
datadir_c	"/usr/share"
datadir_c_make	\"$(datadir)\"
datarootdir	${prefix}/share
datarootdir_c	"/usr/share"
datarootdir_c_make	\"$(datarootdir)\"
DEFAULT_ARCHIVE	-
DEFAULT_ARCHIVE_FORMAT	GNU
DEFAULT_BLOCKING	20
DEFAULT_QUOTING_STYLE	escape_quoting_style
DEFAULT_RMT_COMMAND	/usr/libexec/rmt
DEFAULT_RMT_DIR	$(libexecdir)
DEFS	-DHAVE_CONFIG_H
DEPDIR	.deps
DIR_HAS_FD_MEMBER	1
docdir	${datarootdir}/doc/${PACKAGE_TARNAME}
docdir_c	"/usr/share/doc/tar"
docdir_c_make	\"$(docdir)\"
dvidir	${docdir}
dvidir_c	"/usr/share/doc/tar"
dvidir_c_make	\"$(dvidir)\"
ECHO_C	
ECHO_N	-n
ECHO_T	
EGREP	/usr/bin/grep -E
EMULTIHOP_HIDDEN	
EMULTIHOP_VALUE	
ENOLINK_HIDDEN	
ENOLINK_VALUE	
EOVERFLOW_HIDDEN	
EOVERFLOW_VALUE	
ERRNO_H	
ETAGS	etags
EUIDACCESS_LIBGEN	
exec_prefix	${prefix}
exec_prefix_c	"/usr"
exec_prefix_c_make	\"$(exec_prefix)\"
EXEEXT	
FILE_HAS_ACL_LIB	-lacl
FLOAT_H	
FNMATCH_H	fnmatch.h
GETOPT_CDEFS_H	getopt-cdefs.h
GETOPT_H	getopt.h
GETRANDOM_LIB	
GETTEXT_MACRO_VERSION	0.20
GL_CFLAG_ALLOW_WARNINGS	-Wno-error

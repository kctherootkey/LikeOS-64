# Generated by unpack.sh and the build; the tarball plus patches/ are the
# source of truth and are what stay tracked.
/src/
/build/

# The target-prefixed cross-tool symlinks likeos-configure.sh writes, so gdb's
# recursive makes can find x86_64-unknown-likeos-ar and friends by name.  They
# point at ABSOLUTE paths on the build host (/usr/bin/ar, ...), so committing
# them would bake one machine's layout into the tree.
/toolbin/

# Build stamps.  The .likeos-configured* rule in the top-level .gitignore
# already covers the other one; this port has a second stamp for the
# unpack-and-patch step, which that rule does not match.  Committing it would
# be worse than untidy: a fresh clone would find the stamp newer than the
# tarball, skip unpack.sh entirely, and try to build with no src/ at all.
/.likeos-unpacked

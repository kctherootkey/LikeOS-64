+bool
+likeos_process_target::supports_qxfer_siginfo ()
+{
+  return true;
+}
+
+/* $_siginfo -- WHY the inferior stopped, not just which signal.  si_code and
+   si_addr are the difference between "SIGSEGV" and "wrote to 0x1, which is
+   not mapped".  */
+
+int
+likeos_process_target::qxfer_siginfo (const char *annex,
+				      unsigned char *readbuf,
+				      unsigned const char *writebuf,
+				      CORE_ADDR offset, int len)
+{
+  if (current_thread == nullptr)
+    return -1;
+
+  /* Read-only.  The kernel keeps this for the signal a tracee is stopped for
+     and rebuilds it at the next stop, so a write would be discarded rather
+     than honoured -- and answering "unsupported" is how a target says so.  */
+  if (writebuf != nullptr)
+    return -2;
+
+  pid_t tid = likeos_current_tid ();
+  siginfo_t siginfo;
+
+  if (tid == 0 || offset >= sizeof (siginfo))
+    return -1;
+
+  if (ptrace (PT_GETSIGINFO, tid, &siginfo, 0) == -1)
+    return -1;
+
+  unsigned long avail = sizeof (siginfo) - offset;
+
+  if ((unsigned long) len > avail)
+    len = avail;
+
+  memcpy (readbuf, (char *) &siginfo + offset, len);
+  return len;
+}
+
+bool
+likeos_process_target::supports_non_stop ()
+{
+  /* Every trace stop parks the whole thread group, so a thread cannot be
+     examined while its siblings run.  All-stop is what the kernel offers.  */
+  return false;
+}

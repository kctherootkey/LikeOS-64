+
+bool
+likeos_process_target::supports_pid_to_exec_file ()
+{
+  return true;
+}
+
+/* The executable a process is running.
+
+   This is what makes attaching useful: gdb asks for it right after an attach
+   and reads symbols from whatever comes back.  The process name is only a
+   basename and argv[0] is whatever the program was invoked as -- a login
+   shell's is "-bash", which names no file at all -- so neither can stand in
+   for it.  Systems with a per-process filesystem read /proc/PID/exe; this one
+   asks the kernel.  */
+
+const char *
+likeos_process_target::pid_to_exec_file (int pid)
+{
+  static char path[512];
+
+  errno = 0;
+  long n = ptrace (PT_GETEXECPATH, pid, path, (long) sizeof (path));
+
+  /* Zero is a real answer -- a task that has not exec'd has no executable --
+     and so is a failure; both mean "cannot tell you".  */
+  if (n <= 0)
+    return nullptr;
+
+  return path;
+}
+
+/* The singleton target, and the only thing server.cc asks this file for.  */
+
+static likeos_process_target the_likeos_target;
+
+void
+initialize_low ()
+{
+  set_target_ops (&the_likeos_target);
+}

+/* This is the same kernel interface gdb/likeos-nat.c is written against --
+   LikeOS's own ptrace(2), described in <sys/ptrace.h> -- reached through
+   gdbserver's target vector instead of gdb's.  The two files agree on every
+   decision that the kernel forces, and each of those is commented where it is
+   made rather than cross-referenced, because reading one should not require
+   the other.
+
+   LikeOS is amd64 only, so unlike the NetBSD and Linux ports there is no
+   architecture split: one file, one register layout, one target description.
+
+   What is NOT here, deliberately:
+
+     - Fork and vfork events.  gdbserver would then owe gdb a follow_fork, and
+       the child of a traced process is parked by the kernel until somebody
+       detaches from it; getting that wrong leaves a shell under the debugger
+       hanging on the first command it runs.  Without TRACEFORK the child is
+       never traced and simply runs, which is what "always follow the parent"
+       means and is all this port claims.  netbsd-low.cc makes the same choice.
+     - Syscall catching, tracepoints and the in-process agent.
+     - qXfer:libraries-svr4.  gdb reads the loader's link map through ordinary
+       memory reads when the target does not offer this, which works and is one
+       fewer thing to keep in step with the loader.  */
+
+#include "target.h"
+#include "regcache.h"
+#include "gdbthread.h"
+#include "tdesc.h"
+#include "i387-fp.h"
+#include "x86-low.h"
+#include "x86-tdesc.h"
+
+#include "arch/amd64.h"
+#include "nat/fork-inferior.h"
+#include "nat/x86-dregs.h"
+#include "gdbsupport/x86-xstate.h"
+#include "gdbsupport/osabi.h"
+#include "gdbsupport/eintr.h"
+#include "gdbsupport/gdb_wait.h"
+#include "gdbsupport/common-inferior.h"
+
+#include <sys/types.h>
+#include <sys/ptrace.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <signal.h>
+#include <unistd.h>
+#include <vector>
+
+/* Every process here has threads, and they are what the (pid, lwp) ptids this
+   target hands out are for.  Reported to remote-utils.cc so that stop replies
+   carry the thread they belong to.  */
+
+int using_threads = 1;
+
+/* ------------------------------------------------------------------------ */
+/* Registers                                                                 */
+/* ------------------------------------------------------------------------ */
+
+/* Where each register lives inside `struct ptrace_regs' (<sys/ptrace.h>),
+   named rather than numbered.
+
+   The kernel's block is ordered the way the interrupt frame it is built from
+   is ordered, which is nothing like the order of gdb's register numbering, so
+   this table is the whole of the translation.  It is keyed by NAME and the
+   numbers are looked up once from the target description, which is stronger
+   than an array indexed by register number: a table in the wrong order still
+   compiles and simply reports one register's value under another's name,
+   whereas a name that does not exist in the description throws at start-up.
+
+   struct ptrace_regs, in slots of 8 bytes:
+
+      0 r15   1 r14   2 r13   3 r12   4 rbp   5 rbx   6 r11   7 r10
+      8 r9    9 r8   10 rax  11 rcx  12 rdx  13 rsi  14 rdi  15 rip
+     16 cs   17 rflags 18 rsp 19 ss  20 fs_base 21 gs_base
+     22 ds   23 es   24 fs   25 gs
+
+   The four data-segment selectors are at the end because they were added to
+   the kernel's block after the rest; appending them left every register a
+   debugger already read where it was.  They are reported and not written --
+   the kernel does not restore them on the way back to user mode, so a value
+   accepted for one would be a value that never took effect.  CS and SS are
+   not written either, and for a stronger reason: a tracee returning through a
+   segment selector of the debugger's choosing is a way out of user mode.  */
+
+struct likeos_reg
+{
+  /* The register's name in the target description.  */
+  const char *name;
+
+  /* Its slot in `struct ptrace_regs', counted in 8-byte words.  */
+  int slot;
+
+  /* Whether PTRACE_SETREGS honours a write to it.  Reading is always
+     honoured; see above for why some of these are read-only.  */
+  bool writable;
+};
+
+static const struct likeos_reg likeos_gregs[] =
+{
+  { "rax",	10,	true },
+  { "rbx",	 5,	true },
+  { "rcx",	11,	true },
+  { "rdx",	12,	true },
+  { "rsi",	13,	true },
+  { "rdi",	14,	true },
+  { "rbp",	 4,	true },
+  { "rsp",	18,	true },
+  { "r8",	 9,	true },
+  { "r9",	 8,	true },
+  { "r10",	 7,	true },
+  { "r11",	 6,	true },
+  { "r12",	 3,	true },
+  { "r13",	 2,	true },
+  { "r14",	 1,	true },
+  { "r15",	 0,	true },
+  { "rip",	15,	true },
+  { "eflags",	17,	true },
+  { "cs",	16,	false },
+  { "ss",	19,	false },
+  { "ds",	22,	false },
+  { "es",	23,	false },
+  { "fs",	24,	false },
+  { "gs",	25,	false },
+  { "fs_base",	20,	true },
+  { "gs_base",	21,	true },
+};
+
+/* The register numbers the names above resolve to, filled in by
+   likeos_arch_setup.  A separate array rather than a mutable field in the
+   table so that the table itself stays constant data.  */
+
+static int likeos_greg_regnum[ARRAY_SIZE (likeos_gregs)];
+
+/* Read the whole general-purpose block of the task TID.  */
+
+static void
+likeos_fetch_gregs (pid_t tid, struct ptrace_regs *regs)
+{
+  if (ptrace (PT_GETREGS, tid, regs, 0) == -1)
+    perror_with_name ("Couldn't get registers");
+}
+
+/* ------------------------------------------------------------------------ */
+/* Hardware watchpoints                                                      */
+/* ------------------------------------------------------------------------ */
+
+/* nat/x86-dregs.c owns the allocation of the four address registers and the
+   assembly of DR7; all it wants from a particular system is five functions
+   that move one register in or out, and a per-process place to keep its
+   mirror of the hardware.  Writing any of that here would be reimplementing
+   shared code that is already correct.
+
+   The kernel reports all eight registers at once, indexed as the hardware
+   numbers them, so a read is one request and a write is read-modify-write.  */
+
+struct process_info_private
+{
+  /* nat/x86-dregs.c's view of this process's debug registers.  A watchpoint
+     is a property of the address space, so it belongs to the process and not
+     to any one of its threads -- which is also why arming one writes it to
+     every thread.  */
+  struct x86_debug_reg_state debug_reg_state;
+
+  /* Whether PTRACE_SETOPTIONS has been issued for this process yet, which on
+     this system is the same question as "is an exec stop an EVENT or is it the
+     bootstrap?"  See likeos_wants_trace_events.  */
+  bool trace_options_set = false;
+};
+
+/* nat/x86-dregs.c's mirror for the current process, or null if there is no
+   current process to have one.  Every caller checks: a Z-packet arrives with
+   whatever context the previous packet left, so "there is no process" is a
+   state to answer rather than one to assume away.  */
+
+static struct x86_debug_reg_state *
+likeos_debug_reg_state (void)
+{
+  process_info *proc = current_process ();
+
+  return (proc != nullptr && proc->priv != nullptr)
+	   ? &proc->priv->debug_reg_state
+	   : nullptr;
+}
+
+static struct ptrace_dbregs
+likeos_dr_fetch (pid_t tid)
+{
+  struct ptrace_dbregs dbregs;
+
+  if (tid == 0)
+    error ("no process selected for a debug-register access");
+
+  if (ptrace (PT_GETDBREGS, tid, &dbregs, 0) == -1)
+    perror_with_name ("Couldn't read debug registers");
+
+  return dbregs;
+}
+
+/* The task id to aim a THREAD-scoped request at -- registers, siginfo, a
+   single-step.  A thread is a task in its own right on this system, so the lwp
+   half of the ptid is the id whenever it is set.
+
+   Zero when there is no current thread, which is a state gdbserver puts itself
+   in deliberately rather than an error: see likeos_process_tid.  Callers
+   check.  */
+
+static pid_t
+likeos_current_tid (void)
+{
+  if (current_thread == nullptr)
+    return 0;
+
+  ptid_t ptid = current_thread->id;
+
+  return (pid_t) (ptid.lwp () != 0 ? ptid.lwp () : ptid.pid ());
+}
+
+/* The task id to aim a PROCESS-scoped request at -- memory, the debug
+   registers.  Both are properties of an address space, which every thread of a
+   process shares, so the thread group leader answers for all of them.
+
+   This is not interchangeable with likeos_current_tid, and using that one here
+   was a null dereference rather than a wrong answer.  gdbserver distinguishes
+   the two explicitly: gdb_read_memory calls set_desired_process(), whose
+   switch_to_process() sets the current process and CLEARS current_thread --
+
+     switch_to_process (process_info *proc)
+     { current_process_ = proc;  current_thread = nullptr; }
+
+   -- so a memory read arrives with no current thread BY DESIGN.  Reading
+   current_thread->id there faulted at offset 0x18, which is where ptid_t's lwp
+   sits, the moment gdb asked for its first byte of memory.  linux-low and
+   netbsd-low both answer memory from current_process()->pid.
+
+   Zero when there is no current process either; callers check.  */
+
+static pid_t
+likeos_process_tid (void)
+{
+  process_info *proc = current_process ();
+
+  return proc != nullptr ? (pid_t) proc->pid : 0;
+}
+
+static void
+likeos_dr_store (const struct ptrace_dbregs *dbregs)
+{
+  /* Written to every thread of the process, not just the current one: a
+     watchpoint is on an address in an address space they all share, and one
+     armed only on the thread that set it would miss the write it was armed
+     for.  */
+  process_info *proc = current_process ();
+
+  if (proc == nullptr)
+    error ("no process selected for a debug-register access");
+
+  proc->for_each_thread ([dbregs] (thread_info *thread)
+    {
+      ptid_t ptid = thread->id;
+      pid_t tid = (pid_t) (ptid.lwp () != 0 ? ptid.lwp () : ptid.pid ());
+
+      if (ptrace (PT_SETDBREGS, tid, (void *) dbregs, 0) == -1)
+	perror_with_name ("Couldn't write debug registers");
+    });
+}
+
+static void
+likeos_dr_set (int regnum, unsigned long value)
+{
+  struct ptrace_dbregs dbregs = likeos_dr_fetch (likeos_process_tid ());
+
+  dbregs.dr[regnum] = value;
+  likeos_dr_store (&dbregs);
+}
+
+static unsigned long
+likeos_dr_get (int regnum)
+{
+  struct ptrace_dbregs dbregs = likeos_dr_fetch (likeos_process_tid ());
+
+  return dbregs.dr[regnum];
+}
+
+static void
+likeos_dr_set_control (unsigned long control)
+{
+  likeos_dr_set (DR_CONTROL, control);
+}
+
+static void
+likeos_dr_set_addr (int regnum, CORE_ADDR addr)
+{
+  gdb_assert (regnum >= 0 && regnum <= DR_LASTADDR - DR_FIRSTADDR);
+  likeos_dr_set (DR_FIRSTADDR + regnum, (unsigned long) addr);
+}
+
+static CORE_ADDR
+likeos_dr_get_addr (int regnum)
+{
+  return likeos_dr_get (DR_FIRSTADDR + regnum);
+}
+
+static unsigned long
+likeos_dr_get_status (void)
+{
+  return likeos_dr_get (DR_STATUS);
+}
+
+static unsigned long
+likeos_dr_get_control (void)
+{
+  return likeos_dr_get (DR_CONTROL);
+}
+
+struct x86_dr_low_type x86_dr_low =
+  {
+    likeos_dr_set_control,
+    likeos_dr_set_addr,
+    likeos_dr_get_addr,
+    likeos_dr_get_status,
+    likeos_dr_get_control,
+    sizeof (unsigned long),
+  };
+
+/* ------------------------------------------------------------------------ */
+/* The target                                                                */
+/* ------------------------------------------------------------------------ */
+

#!/bin/sh
# Cross compiler driver for the X.Org port.
#
# autoconf and meson both use $CC as the LINK driver as well as the compiler,
# so this has to behave as both: it detects whether the command line is a
# compile or a link and supplies the right pieces for each.  Derived from the
# openssh port's likeos-cc, extended with the shared sysroot every X package
# installs its headers, libraries and .pc files into.
#
# The include order is load-bearing: the port sysroot first, then the LikeOS
# libc, and GCC's own headers LAST.  GCC's directory contains a float.h/stddef.h
# we do want, but also a stdlib.h etc. we very much do not.
#
# Sysroot ahead of libc, rather than the other way round, because of exactly one
# header: GNU libiconv's.  The libc has an iconv(3) of its own covering four
# character sets, which is enough for the X core fonts and nowhere near enough
# for a mail client, so libiconv is ported alongside it.  The two coexist only
# through libiconv's header, which renames its entry points to libiconv_open and
# friends -- and with the libc's include directory searched first, that header is
# never the one that gets included.  The renaming then silently does not happen
# and every caller binds to the four-charset implementation instead.
#
# Nothing is shadowed the other way: the two directories had no file in common
# when this was changed (verified across all 1127 sysroot headers), so for every
# package built before it the order is not observable.  A package that installs
# a header named like one of the libc's would now win, which is the hazard to
# remember if a build ever starts using a declaration it should not have.

set -e

self=$0
case "$self" in
/*) ;;
*) self=$(pwd)/$self ;;
esac
TOOLCHAIN=$(cd "$(dirname "$self")" && pwd)
ROOT=$(cd "$TOOLCHAIN/../../.." && pwd)

LIBC="$ROOT/user/lib/libc"
RTLD="$ROOT/user/lib/rtld"
LDS="$ROOT/user/bin/user_dyn.lds"
CRT1="$LIBC/crt1.o"
SYSROOT="${LIKEOS_SYSROOT:-$ROOT/build/xorg-sysroot}"
ZLIB="$ROOT/ports/lib/zlib-1.3.1"
# The X server wants a SHA-1 implementation; OpenSSL is already ported, so use
# that rather than adding another crypto library to the tree.
OPENSSL="$ROOT/ports/openssl-3.5.6"

GCC_INC="$(gcc -print-file-name=include)"

INCLUDES="-nostdinc \
  -isystem $SYSROOT/usr/include \
  -isystem $LIBC/include \
  -isystem $ZLIB \
  -isystem $OPENSSL/include \
  -isystem $GCC_INC"

# The -U flags matter more than they look.  We build with the HOST's gcc, which
# defines __linux__/linux/__gnu_linux__ automatically — so every package has
# been compiling as though it were targeting Linux, silently taking Linux code
# paths for things this system does not have.  The X server is where that
# surfaces first (it reaches for <sys/kd.h> and the VT ioctls behind
# `#ifdef __linux__`), but it would have produced quieter wrongness elsewhere.
# The kernel build already does exactly this for the same reason.
#
# __unix__ is deliberately LEFT defined: that one is true.
#
# -DXOS_USE_MTSAFE_PWDAPI: X11's Xos_r.h chooses between three spellings of
# getpwnam depending on what it believes the platform offers.  LikeOS is not a
# system it has heard of, so it falls back to the "threads but no _r API"
# branch and calls a four-argument variant that does not exist here.  We do
# provide the POSIX getpwnam_r/getpwuid_r, so state that rather than patching
# the header.
#
# -fno-strict-aliasing: several X packages punt types through pointers.
# -fno-stack-protector: the canary lives at %fs:0x28, which is valid only once
# libc's thread control block is in place; library code that runs earlier must
# not depend on it.
COMPILE_FLAGS="-O2 -fPIC -fno-builtin -ffreestanding -mno-red-zone \
  -fno-stack-protector -fno-strict-aliasing -fno-tree-vectorize \
  -D__LIKEOS__ -D_GNU_SOURCE \
  -DXOS_USE_MTSAFE_PWDAPI \
  -U__linux__ -U__linux -Ulinux -U__gnu_linux__ -U_LINUX"

# Every token this invocation was given, INCLUDING the contents of any
# response file.
#
# ninja hands the compiler `@some.rsp` when the command line would be too long
# for the kernel to exec, and meson generates those routinely for a link with
# several hundred objects.  gcc expands them itself, so the build works -- but
# this script has to classify the invocation before handing it over, and the
# flag that decides everything is inside the file rather than on the command
# line.  Scanning only "$@" saw no -shared when linking libgtk-3.so, took the
# executable path, and put crt1.o into a shared library: the link then failed
# with "undefined reference to `main'", naming neither the response file nor
# the wrapper.
#
# Quotes are stripped because a response file may quote a token; only whole
# tokens are matched, so a FILE named "-shared" cannot be mistaken for the flag.
scan_tokens() {
	for a in "$@"; do
		case "$a" in
		@?*)
			[ -f "${a#@}" ] && tr -d "'\"" <"${a#@}"
			;;
		*) printf '%s\n' "$a" ;;
		esac
	done
}

# A link step is anything that is not -c / -E / -S; -shared decides between a
# shared library and an executable.
is_link=1
is_shared=0
set -f # the token list is not a glob pattern
for tok in $(scan_tokens "$@"); do
	case "$tok" in
	-c | -E | -S) is_link=0 ;;
	-shared) is_shared=1 ;;
	esac
done
set +f

# Appended AFTER the package's own flags, which is the only position that can
# undo one of them: last -W wins.
#
# util-macros turns -Warray-bounds into -Werror=array-bounds for every package
# that uses XORG_DEFAULT_OPTIONS, so the build host's gcc decides whether these
# releases compile at all.  gcc 11 reports libX11's XDefaultOMIF.c:402 as
# "array subscript -3 is outside array bounds of char[4096]" -- the guarded
# `length > 3 && *(last-3) == '-'`, where it has not carried the guard into the
# dereference.  The access cannot happen; newer gcc does not report it.  That
# is a property of the compiler on this machine, not of the port, so only the
# error promotion is dropped: the warning is still printed, and the other
# eleven -Werror= flags (notably -Werror=implicit, which catches a prototype
# this libc is missing) keep their teeth.
NOT_FATAL="-Wno-error=array-bounds"

if [ "$is_link" = "0" ]; then
	exec gcc $INCLUDES $COMPILE_FLAGS "$@" $NOT_FATAL
fi

# Shared library or executable?  Both need the sysroot on the library path.
LIBDIRS="-L$LIBC -L$RTLD -L$SYSROOT/usr/lib -L$ROOT/build -L$OPENSSL"

# Stop -lfoo from ever reaching a build-host library.
#
# -nostdlib drops the default startup files and libraries, but NOT the
# directories the linker searches: ld carries a built-in list (/usr/lib,
# /lib/x86_64-linux-gnu, ...) and will happily satisfy -lncurses from it.  What
# comes back is a library built against the host libc, and the link then either
# fails with an error about errno and .tbss that says nothing about the real
# cause, or -- worse -- succeeds, because not every host library drags the host
# libc in visibly.
#
# Those built-in entries are all "=" prefixed (see `ld --verbose`), which means
# they are relative to the linker sysroot.  Pointing that at our own sysroot
# redirects every one of them inside it, so an unsatisfiable -lfoo now fails
# with a plain "cannot find -lfoo" instead of quietly finding the wrong file.
# The explicit -L paths above are absolute and unaffected.
NO_HOST_LIBS="-Wl,--sysroot=$SYSROOT"

# Where ld should look when resolving the DT_NEEDED of the libraries named on
# the command line.  That search does NOT use -L: without this, ld falls back
# to its built-in directories, finds the HOST's /usr/lib/.../libc.so linker
# script while trying to satisfy our libraries' need for "libc.so", and pulls
# the host C library into the link.  The failure names errno and TLS sections
# and says nothing about the real cause.
RPATH_LINK="-Wl,-rpath-link,$LIBC:$RTLD:$SYSROOT/usr/lib:$ROOT/build:$OPENSSL"

if [ "$is_shared" = "1" ]; then
	# -Bsymbolic-functions: bind a library's own calls internally, which
	# keeps the loader's work down and matches how the other ports link.
	# -l:ld-likeos.so as well as -lc: a shared library that uses __thread
	# in the general-dynamic model emits calls to __tls_get_addr, which the
	# dynamic linker provides (libc.so carries no DT_NEEDED on it, so it
	# cannot resolve transitively).  pixman is the first library here to do
	# that; without this the link fails with an undefined reference that
	# says nothing about TLS.
	exec gcc $INCLUDES $COMPILE_FLAGS -nostdlib -shared \
		-Wl,--hash-style=gnu -Wl,-Bsymbolic-functions \
		-Wl,-z,relro \
		$LIBDIRS $NO_HOST_LIBS $RPATH_LINK "$@" -lc -l:ld-likeos.so -lgcc
fi

# Executable.  crt1.o goes BEFORE "$@" because configure appends its test
# objects after the flags.  --export-dynamic matters for the X server: its
# modules are dlopen'd and resolve back into the binary's own symbols.
exec gcc $INCLUDES $COMPILE_FLAGS \
	-nostdlib -pie \
	-Wl,-T,"$LDS" -Wl,--hash-style=gnu -Wl,-z,now -Wl,-z,relro \
	-Wl,--export-dynamic \
	-Wl,-rpath,/lib -Wl,-dynamic-linker,/lib/ld-likeos.so \
	$LIBDIRS $NO_HOST_LIBS $RPATH_LINK \
	"$CRT1" "$@" -lc -l:ld-likeos.so -lgcc

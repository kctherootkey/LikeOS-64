+#define SVGA_VIDEO_FLAG_COLORKEY 0x0001
+
+#define VMWARE_VID_MAX_WIDTH    2048
+#define VMWARE_VID_MAX_HEIGHT   2048
+
+static XF86VideoEncodingRec vmwareVideoEncodings[] = {
+    {
+     0,
+     "XV_IMAGE",
+     VMWARE_VID_MAX_WIDTH, VMWARE_VID_MAX_HEIGHT,

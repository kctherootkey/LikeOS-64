+
+static XF86VideoFormatRec vmwareVideoFormats[] = {
+    {16, TrueColor},
+    {24, TrueColor}
+};
+
+static XF86ImageRec vmwareVideoImages[] = {
+    XVIMAGE_YV12,
+    XVIMAGE_YUY2,
+    XVIMAGE_UYVY
+};
+
+static char xv_colorkey_name[] = "XV_COLORKEY";
+static char xv_autopaint_name[] = "XV_AUTOPAINT_COLORKEY";
+
+static XF86AttributeRec vmwareVideoAttributes[] = {
+    {
+     XvGettable | XvSettable,
+     0x000000,
+     0xffffff,
+     xv_colorkey_name,
+     },
+    {
+     XvGettable | XvSettable,

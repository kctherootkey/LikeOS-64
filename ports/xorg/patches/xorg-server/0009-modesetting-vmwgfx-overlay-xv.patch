+/* ---- the display manager's stream and buffer calls ---------------------- */
+
+static int
+vmwgfx_num_streams(int drm_fd, uint32_t *ntot, uint32_t *nfree)
+{
+    struct drm_vmw_getparam_arg arg;
+    int ret;
+
+    memset(&arg, 0, sizeof(arg));
+    arg.param = DRM_VMW_PARAM_NUM_STREAMS;
+    ret = drmCommandWriteRead(drm_fd, DRM_VMW_GET_PARAM, &arg, sizeof(arg));
+    if (ret)
+        return ret;
+    *ntot = (uint32_t) arg.value;
+
+    memset(&arg, 0, sizeof(arg));
+    arg.param = DRM_VMW_PARAM_NUM_FREE_STREAMS;
+    ret = drmCommandWriteRead(drm_fd, DRM_VMW_GET_PARAM, &arg, sizeof(arg));
+    if (ret)
+        return ret;
+    *nfree = (uint32_t) arg.value;
+    return 0;
+}
+
+static int
+vmwgfx_claim_stream(int drm_fd, uint32_t *out)
+{
+    struct drm_vmw_stream_arg s_arg;
+    int ret;
+
+    memset(&s_arg, 0, sizeof(s_arg));
+    ret = drmCommandRead(drm_fd, DRM_VMW_CLAIM_STREAM, &s_arg, sizeof(s_arg));
+    if (ret)
+        return -1;
+    *out = s_arg.stream_id;
+    return 0;
+}
+
+static int
+vmwgfx_unref_stream(int drm_fd, uint32_t stream_id)
+{
+    struct drm_vmw_stream_arg s_arg;
+
+    memset(&s_arg, 0, sizeof(s_arg));
+    s_arg.stream_id = stream_id;
+    return drmCommandWrite(drm_fd, DRM_VMW_UNREF_STREAM, &s_arg,
+                           sizeof(s_arg)) ? -1 : 0;
+}
+
+static int
+vmw_video_buffer_alloc(int drm_fd, int size, struct vmw_video_buffer *out)
+{
+    union drm_vmw_alloc_dmabuf_arg arg;
+    struct drm_vmw_unref_dmabuf_arg u_arg;
+
+    memset(&arg, 0, sizeof(arg));
+    arg.req.size = size;
+    if (drmCommandWriteRead(drm_fd, DRM_VMW_ALLOC_DMABUF, &arg, sizeof(arg)))
+        return XvBadAlloc;
+    out->handle = arg.rep.handle;
+    out->map_handle = arg.rep.map_handle;
+    out->data = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, drm_fd,
+                     (off_t) arg.rep.map_handle);
+    if (out->data == MAP_FAILED) {
+        out->data = NULL;
+        memset(&u_arg, 0, sizeof(u_arg));
+        u_arg.handle = out->handle;
+        drmCommandWrite(drm_fd, DRM_VMW_UNREF_DMABUF, &u_arg, sizeof(u_arg));
+        out->handle = 0;
+        return XvBadAlloc;
+    }
+    out->size = size;
+    return Success;
+}
+
+static int
+vmw_video_buffer_free(int drm_fd, struct vmw_video_buffer *out)
+{
+    struct drm_vmw_unref_dmabuf_arg u_arg;
+
+    if (out->size == 0)
+        return Success;
+    munmap(out->data, out->size);
+    memset(&u_arg, 0, sizeof(u_arg));
+    u_arg.handle = out->handle;
+    drmCommandWrite(drm_fd, DRM_VMW_UNREF_DMABUF, &u_arg, sizeof(u_arg));
+    out->handle = 0;
+    out->data = NULL;
+    out->size = 0;
+    return Success;
+}
+
+/* ---- the adaptor ------------------------------------------------------- */
+
+static struct vmwgfx_overlay_port *
+vmwgfx_overlay_port_create(int drm_fd)
+{
+    struct vmwgfx_overlay_port *port = calloc(1, sizeof(*port));
+
+    if (!port)
+        return NULL;
+    port->drm_fd = drm_fd;
+    port->play = vmw_video_port_init;
+    port->flags = SVGA_VIDEO_FLAG_COLORKEY;
+    port->colorKey = VMWARE_VIDEO_COLORKEY;
+    port->isAutoPaintColorkey = TRUE;
+    return port;
+}
+
+/* The adaptor, when the display manager is vmwgfx with a free stream;
+ * NULL otherwise (the caller then registers nothing for it). */
+XF86VideoAdaptorPtr
+likeos_vmw_overlay_init(ScrnInfoPtr pScrn)
+{
+    modesettingPtr ms = modesettingPTR(pScrn);
+    XF86VideoAdaptorPtr adaptor;
+    DevUnion *dev_unions;
+    uint32_t ntot = 0, nfree = 0;
+    drmVersionPtr v;
+    Bool is_vmw;
+    int i;
+
+    v = drmGetVersion(ms->fd);
+    if (!v)
+        return NULL;
+    is_vmw = strcmp(v->name, "vmwgfx") == 0;
+    drmFreeVersion(v);
+    if (!is_vmw)
+        return NULL;
+    if (vmwgfx_num_streams(ms->fd, &ntot, &nfree) != 0 || ntot == 0) {
+        xf86DrvMsg(pScrn->scrnIndex, X_INFO,
+                   "The display manager offers no video overlay stream.\n");
+        return NULL;
+    }
+    if (nfree == 0) {
+        xf86DrvMsg(pScrn->scrnIndex, X_INFO,
+                   "Every video overlay stream is taken.\n");
+        return NULL;
+    }
+    adaptor = xf86XVAllocateVideoAdaptorRec(pScrn);
+    dev_unions = calloc(VMWARE_VID_NUM_PORTS, sizeof(DevUnion));
+    if (adaptor == NULL || dev_unions == NULL) {
+        xf86XVFreeVideoAdaptorRec(adaptor);
+        free(dev_unions);
+        return NULL;
+    }
+
+    adaptor->type = XvInputMask | XvImageMask | XvWindowMask;
+    /* not CLIP_TO_VIEWPORT: with crtc/output mode setting the viewport is
+     * not kept up to date across RandR changes, and the video would be
+     * clipped away */
+    adaptor->flags = VIDEO_OVERLAID_IMAGES;
+    adaptor->name = "VMware Overlay Video Engine";
+    adaptor->nEncodings = sizeof(vmwareVideoEncodings) / sizeof(vmwareVideoEncodings[0]);
+    adaptor->pEncodings = vmwareVideoEncodings;
+    adaptor->nFormats = sizeof(vmwareVideoFormats) / sizeof(vmwareVideoFormats[0]);
+    adaptor->pFormats = vmwareVideoFormats;
+    adaptor->nPorts = VMWARE_VID_NUM_PORTS;
+    adaptor->pPortPrivates = dev_unions;
+
+    for (i = 0; i < VMWARE_VID_NUM_PORTS; ++i)
+        adaptor->pPortPrivates[i].ptr = (void *) vmwgfx_overlay_port_create(ms->fd);
+
+    adaptor->nAttributes = sizeof(vmwareVideoAttributes) / sizeof(vmwareVideoAttributes[0]);
+    adaptor->pAttributes = vmwareVideoAttributes;
+    adaptor->nImages = sizeof(vmwareVideoImages) / sizeof(vmwareVideoImages[0]);
+    adaptor->pImages = vmwareVideoImages;
+
+    adaptor->PutVideo = NULL;
+    adaptor->PutStill = NULL;
+    adaptor->GetVideo = NULL;
+    adaptor->GetStill = NULL;
+    adaptor->StopVideo = vmw_xv_stop_video;
+    adaptor->SetPortAttribute = vmw_xv_set_port_attribute;
+    adaptor->GetPortAttribute = vmw_xv_get_port_attribute;
+    adaptor->QueryBestSize = vmw_xv_query_best_size;
+    adaptor->PutImage = vmw_xv_put_image;
+    adaptor->QueryImageAttributes = vmw_xv_query_image_attributes;
+
+    xf86DrvMsg(pScrn->scrnIndex, X_INFO,
+               "Video overlay through the display manager's stream (%u of %u free).\n",
+               nfree, ntot);
+    return adaptor;
+}
+
+void
+likeos_vmw_overlay_free(XF86VideoAdaptorPtr adaptor)
+{
+    int i;
+
+    if (!adaptor)
+        return;
+    for (i = 0; i < adaptor->nPorts; ++i)
+        free(adaptor->pPortPrivates[i].ptr);
+    free(adaptor->pPortPrivates);
+    xf86XVFreeVideoAdaptorRec(adaptor);
+}
+
+/* The first frame on a port: claim a stream, size the buffers, then play. */
+static int
+vmw_video_port_init(ScrnInfoPtr pScrn, struct vmwgfx_overlay_port *port,
+                    short src_x, short src_y, short drw_x,
+                    short drw_y, short src_w, short src_h,
+                    short drw_w, short drw_h, int format,
+                    unsigned char *buf, short width,
+                    short height, RegionPtr clipBoxes, DrawablePtr pDraw)
+{
+    unsigned short w, h;
+    int i, ret;
+
+    ret = vmwgfx_claim_stream(port->drm_fd, &port->streamId);
+    if (ret != 0)
+        return XvBadAlloc;
+
+    w = width;
+    h = height;
+    port->size = vmw_xv_query_image_attributes(pScrn, format, &w, &h,
+                                               port->pitches, port->offsets);
+    if (port->size == -1) {
+        ret = XvBadAlloc;
+        goto out_bad_size;
+    }
+    for (i = 0; i < VMWARE_VID_NUM_BUFFERS; ++i) {
+        ret = vmw_video_buffer_alloc(port->drm_fd, port->size, &port->bufs[i]);
+        if (ret != Success)
+            goto out_no_buffer;
+    }
+    port->currBuf = 0;
+    REGION_NULL(pScrn->pScreen, &port->clipBoxes);
+    port->play = vmw_video_port_play;
+    return port->play(pScrn, port, src_x, src_y, drw_x, drw_y, src_w, src_h,
+                      drw_w, drw_h, format, buf, width, height, clipBoxes,
+                      pDraw);
+
+ out_no_buffer:
+    while (i-- != 0)
+        vmw_video_buffer_free(port->drm_fd, &port->bufs[i]);
+ out_bad_size:
+    (void) vmwgfx_unref_stream(port->drm_fd, port->streamId);
+    return ret;
+}
+
+/* A frame: copied into the stream's buffer, the colour key painted where
+ * the video goes, the stream's registers sent. */
+static int
+vmw_video_port_play(ScrnInfoPtr pScrn, struct vmwgfx_overlay_port *port,
+                    short src_x, short src_y, short drw_x,
+                    short drw_y, short src_w, short src_h,
+                    short drw_w, short drw_h, int format,
+                    unsigned char *buf, short width,
+                    short height, RegionPtr clipBoxes, DrawablePtr pDraw)
+{
+    struct drm_vmw_control_stream_arg arg;
+    unsigned short w, h;
+    int size;
+    int ret;
+
+    w = width;
+    h = height;
+    size = vmw_xv_query_image_attributes(pScrn, format, &w, &h,
+                                         port->pitches, port->offsets);
+    if (size != port->size) {
+        /* another frame size: buffers of the new size, then this frame */
+        vmw_xv_stop_video(pScrn, port, TRUE);
+        return port->play(pScrn, port, src_x, src_y, drw_x, drw_y, src_w,
+                          src_h, drw_w, drw_h, format, buf, width, height,
+                          clipBoxes, pDraw);
+    }
+
+    memcpy(port->bufs[port->currBuf].data, buf, port->size);
+
+    memset(&arg, 0, sizeof(arg));
+    arg.stream_id = port->streamId;
+    arg.enabled = TRUE;
+    arg.flags = port->flags;
+    arg.color_key = port->colorKey;
+    arg.handle = port->bufs[port->currBuf].handle;
+    arg.format = format;
+    arg.size = port->size;
+    arg.width = w;
+    arg.height = h;
+    arg.src.x = src_x;
+    arg.src.y = src_y;
+    arg.src.w = src_w;
+    arg.src.h = src_h;
+    arg.dst.x = drw_x;
+    arg.dst.y = drw_y;
+    arg.dst.w = drw_w;
+    arg.dst.h = drw_h;
+    arg.pitch[0] = port->pitches[0];
+    arg.pitch[1] = port->pitches[1];
+    arg.pitch[2] = port->pitches[2];
+    arg.offset = 0;
+
+    /* the clip list changed: paint the key where the video may show */
+    if (!REGION_EQUAL(pScrn->pScreen, &port->clipBoxes, clipBoxes)) {
+        REGION_COPY(pScrn->pScreen, &port->clipBoxes, clipBoxes);
+        if (port->isAutoPaintColorkey) {
+            if (pDraw->type == DRAWABLE_WINDOW) {
+                xf86XVFillKeyHelperDrawable(pDraw, port->colorKey, clipBoxes);
+                DamageDamageRegion(pDraw, clipBoxes);
+            }
+            else {
+                xf86XVFillKeyHelper(pScrn->pScreen, port->colorKey, clipBoxes);
+            }
+        }
+    }
+
+    ret = drmCommandWrite(port->drm_fd, DRM_VMW_CONTROL_STREAM, &arg,
+                          sizeof(arg));
+    if (ret) {
+        vmw_video_port_cleanup(pScrn, port);
+        return XvBadAlloc;
+    }
+    if (++(port->currBuf) >= VMWARE_VID_NUM_BUFFERS)
+        port->currBuf = 0;
+    return Success;
+}
+
+static void
+vmw_video_port_cleanup(ScrnInfoPtr pScrn, struct vmwgfx_overlay_port *port)
+{
+    int i;
+
+    if (port->play == vmw_video_port_init)
+        return;
+    port->play = vmw_video_port_init;
+    (void) vmwgfx_unref_stream(port->drm_fd, port->streamId);
+    for (i = 0; i < VMWARE_VID_NUM_BUFFERS; i++)
+        vmw_video_buffer_free(port->drm_fd, &port->bufs[i]);
+    REGION_UNINIT(pScrn->pScreen, &port->clipBoxes);
+}
+
+static int
+vmw_xv_put_image(ScrnInfoPtr pScrn, short src_x, short src_y,
+                 short drw_x, short drw_y, short src_w, short src_h,
+                 short drw_w, short drw_h, int format,
+                 unsigned char *buf, short width, short height,
+                 Bool sync, RegionPtr clipBoxes, void *data, DrawablePtr dst)
+{
+    struct vmwgfx_overlay_port *port = data;
+
+    return port->play(pScrn, port, src_x, src_y, drw_x, drw_y, src_w, src_h,
+                      drw_w, drw_h, format, buf, width, height, clipBoxes,
+                      dst);
+}
+
+static void
+vmw_xv_stop_video(ScrnInfoPtr pScrn, void *data, Bool cleanup)
+{
+    struct vmwgfx_overlay_port *port = data;
+
+    REGION_EMPTY(pScrn->pScreen, &port->clipBoxes);
+    if (!cleanup)
+        return;
+    vmw_video_port_cleanup(pScrn, port);
+}
+
+static int
+vmw_xv_query_image_attributes(ScrnInfoPtr pScrn, int format,
+                              unsigned short *width, unsigned short *height,
+                              int *pitches, int *offsets)
+{
+    INT32 size, tmp;
+
+    if (*width > VMWARE_VID_MAX_WIDTH)
+        *width = VMWARE_VID_MAX_WIDTH;
+    if (*height > VMWARE_VID_MAX_HEIGHT)
+        *height = VMWARE_VID_MAX_HEIGHT;
+
+    *width = (*width + 1) & ~1;
+    if (offsets != NULL)
+        offsets[0] = 0;
+
+    switch (format) {
+    case FOURCC_YV12:
+        *height = (*height + 1) & ~1;
+        size = (*width + 3) & ~3;
+        if (pitches)
+            pitches[0] = size;
+        size *= *height;
+        if (offsets)
+            offsets[1] = size;
+        tmp = ((*width >> 1) + 3) & ~3;
+        if (pitches)
+            pitches[1] = pitches[2] = tmp;
+        tmp *= (*height >> 1);
+        size += tmp;
+        if (offsets)
+            offsets[2] = size;
+        size += tmp;
+        break;
+    case FOURCC_UYVY:
+    case FOURCC_YUY2:
+        size = *width * 2;
+        if (pitches)
+            pitches[0] = size;
+        size *= *height;
+        break;
+    default:
+        return -1;
+    }
+    return size;
+}
+
+static int
+vmw_xv_set_port_attribute(ScrnInfoPtr pScrn, Atom attribute,
+                          INT32 value, void *data)
+{
+    struct vmwgfx_overlay_port *port = data;
+    Atom xvColorKey = MAKE_ATOM("XV_COLORKEY");
+    Atom xvAutoPaint = MAKE_ATOM("XV_AUTOPAINT_COLORKEY");
+
+    if (attribute == xvColorKey)
+        port->colorKey = value;
+    else if (attribute == xvAutoPaint)
+        port->isAutoPaintColorkey = value;
+    else
+        return XvBadAlloc;
+    return Success;
+}
+
+static int
+vmw_xv_get_port_attribute(ScrnInfoPtr pScrn, Atom attribute,
+                          INT32 *value, void *data)
+{
+    struct vmwgfx_overlay_port *port = data;
+    Atom xvColorKey = MAKE_ATOM("XV_COLORKEY");
+    Atom xvAutoPaint = MAKE_ATOM("XV_AUTOPAINT_COLORKEY");
+
+    if (attribute == xvColorKey)
+        *value = port->colorKey;
+    else if (attribute == xvAutoPaint)
+        *value = port->isAutoPaintColorkey;
+    else
+        return XvBadAlloc;
+    return Success;
+}
+
+static void
+vmw_xv_query_best_size(ScrnInfoPtr pScrn, Bool motion,
+                       short vid_w, short vid_h, short drw_w,
+                       short drw_h, unsigned int *p_w,
+                       unsigned int *p_h, void *data)
+{
+    *p_w = (drw_w + 1) & ~1;
+    *p_h = drw_h;
+}

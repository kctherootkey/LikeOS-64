+struct vmwgfx_overlay_port {
+    /* vmw_video_port_init until the stream is claimed and the buffers
+     * exist, vmw_video_port_play after */
+    int (*play) (ScrnInfoPtr, struct vmwgfx_overlay_port *,
+                 short, short, short, short, short,
+                 short, short, short, int, unsigned char *,
+                 short, short, RegionPtr, DrawablePtr);
+
+    uint32_t streamId;
+    uint32_t colorKey;
+    uint32_t flags;
+
+    unsigned currBuf;
+    struct vmw_video_buffer bufs[VMWARE_VID_NUM_BUFFERS];
+
+    int size;
+    int pitches[3];
+    int offsets[3];
+

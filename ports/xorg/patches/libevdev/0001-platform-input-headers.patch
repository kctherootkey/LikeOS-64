Include this platform's evdev and uinput UAPI headers.

The event structure, the event codes and the ioctl encoding are all the same;
only the header's name differs, so the change is one #ifdef per include site
and nothing else in the library is affected.

sys/uinput.h describes a real ABI that the kernel here does not implement yet,
so libevdev's uinput half builds with its full API and its calls fail cleanly
at open("/dev/uinput") instead of being compiled out.

--- a/libevdev/libevdev.h
+++ b/libevdev/libevdev.h
@@ -30,7 +30,13 @@
 extern "C" {
 #endif
 
+/* This platform's evdev UAPI header. Same event structure, event codes and
+ * ioctl encoding; it is only reached under a different name. */
+#ifdef __LIKEOS__
+#include <sys/input.h>
+#else
 #include <linux/input.h>
+#endif
 #include <stdarg.h>
 
 #define LIBEVDEV_ATTRIBUTE_PRINTF(_format, _args) __attribute__ ((format (printf, _format, _args)))
--- a/libevdev/libevdev-uinput.c
+++ b/libevdev/libevdev-uinput.c
@@ -7,7 +7,14 @@
 #include <dirent.h>
 #include <errno.h>
 #include <fcntl.h>
+/* This platform's uinput UAPI header. See the note in sys/uinput.h: the ABI is
+ * real, the device is not implemented yet, so the calls below build and fail
+ * cleanly at open() rather than being compiled out. */
+#ifdef __LIKEOS__
+#include <sys/uinput.h>
+#else
 #include <linux/uinput.h>
+#endif
 #include <poll.h>
 #include <stdio.h>
 #include <string.h>

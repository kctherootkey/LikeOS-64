+/*
+ * Sort the fonts for `name' (the pattern after "xft:") the way XftFontMatch
+ * would match it: the configuration's pattern substitutions, then Xft's
+ * defaults (size in pixels from the screen's resolution, rendering options).
+ * Trimmed, so a font that adds no coverage to those before it is left out.
+ */
+static void
+xft_fallback_build(struct xft_fallback *fb, const char *name)
+{
+	FcPattern *pat;
+	FcResult res;
+
+	pat = FcNameParse((const FcChar8 *)name);
+	if(pat == NULL) {
+		return;
+	}
+	FcConfigSubstitute(NULL, pat, FcMatchPattern);
+	XftDefaultSubstitute(dpy, Scr->screen, pat);
+	fb->set = FcFontSort(NULL, pat, FcTrue, NULL, &res);
+	if(fb->set == NULL || fb->set->nfont == 0) {
+		FcPatternDestroy(pat);
+		xft_fallback_drop(fb);
+		return;
+	}
+	fb->pattern = pat;
+	fb->open = calloc(fb->set->nfont, sizeof(XftFont *));
+	fb->tried = calloc(fb->set->nfont, 1);
+	if(fb->open == NULL || fb->tried == NULL) {
+		xft_fallback_drop(fb);
+	}
+}

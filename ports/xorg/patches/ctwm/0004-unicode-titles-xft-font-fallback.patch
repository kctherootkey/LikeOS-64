+/*
+ * The font to draw `ucs4' with: the slot's own font when it has the glyph,
+ * otherwise the first font in the sorted list that does.  A character no
+ * font has stays with the primary font, which draws its .notdef.
+ */
+static XftFont *
+xft_font_for_char(int slot, FcChar32 ucs4)
+{
+	MyFont *mf = xft_fonts[slot];
+	struct xft_fallback *fb = &xft_fallbacks[slot];
+	XftFont *xf = mf->xft;
+
+	if(XftCharExists(dpy, xf, ucs4)) {
+		return xf;
+	}
+	if(fb->primary != xf) {
+		xft_fallback_drop(fb);
+		fb->primary = xf;
+	}
+	if(!fb->built) {
+		fb->built = true;
+		xft_fallback_build(fb, mf->basename + 4);
+	}
+	if(fb->set == NULL) {
+		return xf;
+	}
+	for(int i = 0; i < fb->set->nfont; i++) {
+		FcCharSet *cs;
+
+		if(FcPatternGetCharSet(fb->set->fonts[i], FC_CHARSET, 0, &cs)
+		                != FcResultMatch || !FcCharSetHasChar(cs, ucs4)) {
+			continue;
+		}
+		if(!fb->tried[i]) {
+			FcPattern *p = FcFontRenderPrepare(NULL, fb->pattern,
+			                                   fb->set->fonts[i]);
+
+			fb->tried[i] = 1;
+			if(p != NULL) {
+				/* On success the font owns the pattern. */
+				fb->open[i] = XftFontOpenPattern(dpy, p);
+				if(fb->open[i] == NULL) {
+					FcPatternDestroy(p);
+				}
+			}
+		}
+		if(fb->open[i] != NULL) {
+			return fb->open[i];
 		}
 	}
-	return NULL;
+	return xf;
+}

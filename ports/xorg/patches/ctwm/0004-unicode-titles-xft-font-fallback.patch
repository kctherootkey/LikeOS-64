+/*
+ * An XftColor for a pixel.  The last one is kept, since a run of draws
+ * usually shares a colour.
+ */
+static XftColor *
+xft_color_for(Display *d, Pixel pixel)
+{
+	static Pixel last_pixel;
+	static XftColor last_color;
+	static bool have_color = false;
+	XColor xc;
+	XRenderColor rc;
+
+	if(have_color && pixel == last_pixel) {
+		return &last_color;
+	}
+	xc.pixel = pixel;
+	XQueryColor(d, DefaultColormap(d, Scr->screen), &xc);
+	rc.red = xc.red;
+	rc.green = xc.green;
+	rc.blue = xc.blue;
+	rc.alpha = 0xffff;
+	if(have_color) {
+		XftColorFree(d, Scr->d_visual, DefaultColormap(d, Scr->screen),
+		             &last_color);
+	}
+	have_color = XftColorAllocValue(d, Scr->d_visual,
+	                                DefaultColormap(d, Scr->screen),
+	                                &rc, &last_color);
+	last_pixel = pixel;
+	return have_color ? &last_color : NULL;
 }
 

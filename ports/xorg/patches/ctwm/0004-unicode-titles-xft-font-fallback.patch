+/*
+ * XmbDrawImageString: the text's logical rectangle filled with the GC's
+ * background, then the text in its foreground.  The size and position
+ * window draws this way, and so do menus in some modes.
+ */
+void
+ctwm_XmbDrawImageString(Display *d, Drawable w, XFontSet fs, GC gc,
+                        int x, int y, const char *text, int len)
+{
+	XRectangle logical;
+	XGCValues gv;
+
+	if(xft_slot(fs) < 0) {
+		XmbDrawImageString(d, w, fs, gc, x, y, text, len);
+		return;
+	}
+	ctwm_XmbTextExtents(fs, text, len, NULL, &logical);
+	XGetGCValues(d, gc, GCForeground | GCBackground, &gv);
+	XSetForeground(d, gc, gv.background);
+	XFillRectangle(d, w, gc, x + logical.x, y + logical.y,
+	               logical.width, logical.height);
+	XSetForeground(d, gc, gv.foreground);
+	ctwm_XmbDrawString(d, w, fs, gc, x, y, text, len);
+}

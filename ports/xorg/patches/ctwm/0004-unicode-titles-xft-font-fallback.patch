+ * same layout, fallback fonts included, as the fontset calls above.
+ */
+int
+ctwm_XftTextWidth(const MyFont *font, const char *text, int len)
+{
+	int slot = xft_slot_font(font);
+
+	if(slot < 0) {
+		XGlyphInfo gi;
+
+		if(font->xft == NULL) {
+			return 0;
+		}
+		XftTextExtentsUtf8(dpy, font->xft, (const FcChar8 *)text, len, &gi);
+		return gi.xOff;
+	}
+	return xft_layout(slot, text, len, 0, 0, NULL, NULL, NULL);
+}
+
+void
+ctwm_XftDrawText(XftDraw *draw, const XftColor *color, const MyFont *font,
+                 int x, int y, const char *text, int len)
+{
+	int slot = xft_slot_font(font);
+
+	if(slot < 0) {
+		if(font->xft != NULL) {
+			XftDrawStringUtf8(draw, color, font->xft, x, y,
+			                  (const FcChar8 *)text, len);
+		}
+		return;
+	}
+	xft_draw(slot, draw, color, x, y, text, len);
+}
+
 

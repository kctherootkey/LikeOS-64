+	XftFont *primary;       /* the font the list below was made for */
+	bool built;             /* the list was made (successfully or not) */
+	FcPattern *pattern;     /* the request, substituted as for its match */
+	FcFontSet *set;         /* every candidate, most preferred first */
+	XftFont **open;         /* set->nfont fonts, opened on first use */
+	char *tried;            /* set->nfont flags: opening was attempted */

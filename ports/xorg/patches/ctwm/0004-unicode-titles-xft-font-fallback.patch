+/* Called before a MyFont's Xft font is closed (GetFont reloads it). */
+static void
+xft_fallback_forget(MyFont *font)
+{
+	for(int i = 0; i < XFT_FONTS_MAX; i++) {
+		if(xft_fonts[i] == font) {
+			xft_fallback_drop(&xft_fallbacks[i]);
+		}
+	}

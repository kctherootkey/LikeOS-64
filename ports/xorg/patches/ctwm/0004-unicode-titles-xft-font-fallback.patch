+static void
+xft_fallback_drop(struct xft_fallback *fb)
+{
+	if(fb->set) {
+		for(int i = 0; i < fb->set->nfont; i++) {
+			if(fb->open && fb->open[i]) {
+				XftFontClose(dpy, fb->open[i]);
+			}
+		}
+		FcFontSetDestroy(fb->set);
+	}
+	if(fb->pattern) {
+		FcPatternDestroy(fb->pattern);
+	}
+	free(fb->open);
+	free(fb->tried);
+	memset(fb, 0, sizeof(*fb));
+}

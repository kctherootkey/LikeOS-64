+/*
+ * Lay out `len' bytes of UTF-8 for the slot's font: each character with the
+ * font that has its glyph, on one baseline, from (x, y).  Fills `specs'
+ * (room for `len' entries) when it is not NULL and `*nspecs' with their
+ * number; returns the advance, and the union of the glyphs' ink, relative
+ * to the origin, in `ink' when that is not NULL.  A byte that does not
+ * start a valid UTF-8 sequence is skipped -- a name cut short in the middle
+ * of a character loses that character, not the rest of the string.
+ */
+static int
+xft_layout(int slot, const char *text, int len, int x, int y,
+           XftCharFontSpec *specs, int *nspecs, XRectangle *ink)
+{
+	const FcChar8 *s = (const FcChar8 *)text;
+	int pen = 0, n = 0;
+	int ix0 = 0, iy0 = 0, ix1 = 0, iy1 = 0;
+	bool have_ink = false;
+
+	while(len > 0) {
+		FcChar32 ucs4;
+		XGlyphInfo gi;
+		XftFont *f;
+		int used = FcUtf8ToUcs4(s, &ucs4, len);
+
+		if(used <= 0) {
+			s++;
+			len--;
+			continue;
+		}
+		s += used;
+		len -= used;
+
+		f = xft_font_for_char(slot, ucs4);
+		XftTextExtents32(dpy, f, &ucs4, 1, &gi);
+		if(specs) {
+			specs[n].font = f;
+			specs[n].ucs4 = ucs4;
+			specs[n].x = (short)(x + pen);
+			specs[n].y = (short)y;
+		}
+		n++;
+		if(gi.width > 0 && gi.height > 0) {
+			int gx0 = pen - gi.x, gy0 = -gi.y;
+			int gx1 = gx0 + gi.width, gy1 = gy0 + gi.height;
+
+			if(!have_ink) {
+				ix0 = gx0;
+				iy0 = gy0;
+				ix1 = gx1;
+				iy1 = gy1;
+				have_ink = true;
+			}
+			else {
+				ix0 = MinSize(ix0, gx0);
+				iy0 = MinSize(iy0, gy0);
+				ix1 = MaxSize(ix1, gx1);
+				iy1 = MaxSize(iy1, gy1);
+			}
+		}
+		pen += gi.xOff;
+	}
+	if(nspecs) {
+		*nspecs = n;
+	}
+	if(ink) {
+		ink->x = ix0;
+		ink->y = iy0;
+		ink->width = ix1 - ix0;
+		ink->height = iy1 - iy0;
+	}
+	return pen;
+}
+
+/* Draw UTF-8 text with the slot's font and its fallbacks. */
+static void
+xft_draw(int slot, XftDraw *draw, const XftColor *color, int x, int y,
+         const char *text, int len)
+{
+	XftCharFontSpec local[128];
+	XftCharFontSpec *specs = local;
+	int n;
+
+	if(len <= 0) {
+		return;
+	}
+	if(len > (int)(sizeof(local) / sizeof(local[0]))) {
+		specs = malloc(len * sizeof(*specs));
+		if(specs == NULL) {
+			return;
+		}
+	}
+	xft_layout(slot, text, len, x, y, specs, &n, NULL);
+	if(n > 0) {
+		XftDrawCharFontSpec(draw, color, specs, n);
+	}
+	if(specs != local) {
+		free(specs);
+	}
 }
 

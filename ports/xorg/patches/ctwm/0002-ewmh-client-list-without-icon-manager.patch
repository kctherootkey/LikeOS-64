 /*
+ * Does this window belong in _NET_CLIENT_LIST?
+ *
+ * The iconmanagerlist test is a shortcut for the IconMgrNoShow lookup, and it
+ * is only valid while there IS an icon manager to have an entry in.  Under
+ * NoIconManagers there is not, so every window failed it and the property was
+ * never written -- see the patch header.
+ */
+static bool EwmhInClientList(TwmWindow *win)
+{
+	if(win->iswspmgr || win->isiconmgr) {
+		return false;
+	}
+	if(win->iconmanagerlist != NULL) {
+		return true;
+	}
+#ifdef __LIKEOS__
+	if(Scr->NoIconManagers) {
+		return !LookInList(Scr->IconMgrNoShow, win->name, &win->class);
+	}
+#endif
+	return false;
+}

+/* ------------------------------------------------------------------------ */
+/* What a window may do                                                     */
+/* ------------------------------------------------------------------------ */
+
+static void
+fl_caps(TwmWindow *t)
+{
+	MotifWmHints mwm;
+	XSizeHints *h = &t->hints;
+	bool have_funcs = GetMWMHints(t->w, &mwm) &&
+	                  (mwm.flags & MWM_HINTS_FUNCTIONS);
+	bool fixed = (h->flags & PMinSize) && (h->flags & PMaxSize) &&
+	             h->min_width == h->max_width &&
+	             h->min_height == h->max_height;
+
+	t->fluent_can_maximize = !fixed &&
+	                         !(have_funcs && !(mwm.functions & MWM_FUNC_MAXIMIZE));
+	t->fluent_can_minimize = !t->istransient &&
+	                         !(have_funcs && !(mwm.functions & MWM_FUNC_MINIMIZE));
+	t->fluent_caps_known = true;
+}
+
+bool
+FluentCanMaximize(TwmWindow *tmp_win)
+{
+	if(!tmp_win->fluent_caps_known) {
+		fl_caps(tmp_win);
+	}
+	return tmp_win->fluent_can_maximize;
+}
+
+bool
+FluentCanMinimize(TwmWindow *tmp_win)
+{
+	if(!tmp_win->fluent_caps_known) {
+		fl_caps(tmp_win);
+	}
+	return tmp_win->fluent_can_minimize;
+}
+
+typedef enum { FL_BTN_ENABLED, FL_BTN_DISABLED, FL_BTN_HIDDEN } FluentButtonState;
+
+static FluentButtonState
+fl_button_state(TwmWindow *t, FluentKind kind)
+{
+	bool max, min;
+
+	if(kind != FL_MINIMIZE && kind != FL_MAXIMIZE) {
+		return FL_BTN_ENABLED;
+	}
+	max = FluentCanMaximize(t);
+	min = FluentCanMinimize(t);
+	/* A window that is zoomed can always be restored. */
+	if(t->zoomed != ZOOM_NONE) {
+		max = true;
+	}
+	if(!max && !min) {
+		return FL_BTN_HIDDEN;
+	}
+	if((kind == FL_MAXIMIZE && !max) || (kind == FL_MINIMIZE && !min)) {
+		return FL_BTN_DISABLED;
+	}
+	return FL_BTN_ENABLED;
+}
+
+bool
+FluentButtonInert(TwmWindow *tmp_win, TBWindow *tbw)
+{
+	if(!fl_usable() || !tmp_win || !tbw) {
+		return false;
+	}
+	return fl_button_state(tmp_win, fl_kind(tbw->info)) != FL_BTN_ENABLED;
+}
+
+void
+FluentCapsChanged(TwmWindow *tmp_win)
+{
+	TBWindow *tbw;
+	int nb;
+
+	if(!tmp_win) {
+		return;
+	}
+	fl_caps(tmp_win);
+	if(!fl_usable() || !tmp_win->titlebuttons) {
+		return;
+	}
+	nb = Scr->TBInfo.nleft + Scr->TBInfo.nright;
+	tbw = tmp_win->titlebuttons;
+	for(int i = 0; i < nb; i++, tbw++) {
+		if(!FluentPaintTitleButton(tmp_win, tbw)) {
+			PaintTitleButton(tmp_win, tbw);
+		}
+	}
+}

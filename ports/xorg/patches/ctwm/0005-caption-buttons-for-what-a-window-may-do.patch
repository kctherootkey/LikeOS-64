+/* ------------------------------------------------------------------------ */
+/* What a window may do                                                     */
+/* ------------------------------------------------------------------------ */
+
+static void
+md_caps(TwmWindow *t)
+{
+	MotifWmHints mwm;
+	XSizeHints *h = &t->hints;
+	bool have_funcs = GetMWMHints(t->w, &mwm) &&
+	                  (mwm.flags & MWM_HINTS_FUNCTIONS);
+	bool fixed = (h->flags & PMinSize) && (h->flags & PMaxSize) &&
+	             h->min_width == h->max_width &&
+	             h->min_height == h->max_height;
+
+	t->modern_can_maximize = !fixed &&
+	                         !(have_funcs && !(mwm.functions & MWM_FUNC_MAXIMIZE));
+	t->modern_can_minimize = !t->istransient &&
+	                         !(have_funcs && !(mwm.functions & MWM_FUNC_MINIMIZE));
+	t->modern_caps_known = true;
+}
+
+bool
+ModernCanMaximize(TwmWindow *tmp_win)
+{
+	if(!tmp_win->modern_caps_known) {
+		md_caps(tmp_win);
+	}
+	return tmp_win->modern_can_maximize;
+}
+
+bool
+ModernCanMinimize(TwmWindow *tmp_win)
+{
+	if(!tmp_win->modern_caps_known) {
+		md_caps(tmp_win);
+	}
+	return tmp_win->modern_can_minimize;
+}
+
+typedef enum { MD_BTN_ENABLED, MD_BTN_DISABLED, MD_BTN_HIDDEN } ModernButtonState;
+
+static ModernButtonState
+md_button_state(TwmWindow *t, ModernKind kind)
+{
+	bool max, min;
+
+	if(kind != MD_MINIMIZE && kind != MD_MAXIMIZE) {
+		return MD_BTN_ENABLED;
+	}
+	max = ModernCanMaximize(t);
+	min = ModernCanMinimize(t);
+	/* A window that is zoomed can always be restored. */
+	if(t->zoomed != ZOOM_NONE) {
+		max = true;
+	}
+	if(!max && !min) {
+		return MD_BTN_HIDDEN;
+	}
+	if((kind == MD_MAXIMIZE && !max) || (kind == MD_MINIMIZE && !min)) {
+		return MD_BTN_DISABLED;
+	}
+	return MD_BTN_ENABLED;
+}
+
+bool
+ModernButtonInert(TwmWindow *tmp_win, TBWindow *tbw)
+{
+	if(!md_usable() || !tmp_win || !tbw) {
+		return false;
+	}
+	return md_button_state(tmp_win, md_kind(tbw->info)) != MD_BTN_ENABLED;
+}
+
+void
+ModernCapsChanged(TwmWindow *tmp_win)
+{
+	TBWindow *tbw;
+	int nb;
+
+	if(!tmp_win) {
+		return;
+	}
+	md_caps(tmp_win);
+	if(!md_usable() || !tmp_win->titlebuttons) {
+		return;
+	}
+	nb = Scr->TBInfo.nleft + Scr->TBInfo.nright;
+	tbw = tmp_win->titlebuttons;
+	for(int i = 0; i < nb; i++, tbw++) {
+		if(!ModernPaintTitleButton(tmp_win, tbw)) {
+			PaintTitleButton(tmp_win, tbw);
+		}
+	}
+}

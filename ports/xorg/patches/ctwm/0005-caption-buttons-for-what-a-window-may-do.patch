+/*
+ * What a window may do, which decides its caption buttons:
+ *
+ *   maximise -- not when its size is fixed (the same minimum and maximum
+ *               size, which is how GTK marks a dialog that is not resizable)
+ *               or its Motif hints leave the maximise function out;
+ *   minimise -- not when it is a dialog (transient for another window) or
+ *               its Motif hints leave the minimise function out.
+ *
+ * A caption button for something the window may not do is drawn greyed and
+ * does nothing; when it may do neither, the minimise and maximise buttons are
+ * not drawn at all and only Close remains -- a Properties box, a message box.
+ * Zooming by any other way (a double click on the title, a key, an EWMH
+ * request) is refused the same way.
+ */
+bool ModernCanMaximize(TwmWindow *tmp_win);
+bool ModernCanMinimize(TwmWindow *tmp_win);
+/* The hints changed (or the window is new): work it out again and repaint
+ * the caption buttons. */
+void ModernCapsChanged(TwmWindow *tmp_win);
+/* Whether a press on this caption button is to be ignored (greyed or not
+ * shown). */
+bool ModernButtonInert(TwmWindow *tmp_win, TBWindow *tbw);
+
 /* Create the border for a newly managed window (frame already created). */
 void ModernGripCreate(TwmWindow *tmp_win);
 

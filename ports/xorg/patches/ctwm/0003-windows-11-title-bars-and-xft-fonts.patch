--- a/win_fluent.c
+++ b/win_fluent.c
@@ -0,0 +1,1144 @@
+/*
+ * LikeOS -- Windows 11 style title bars for ctwm ("FluentTitles").
+ *
+ * See win_fluent.h for what this draws.  Everything is drawn client-side into
+ * small XImages and blitted, rather than with core X lines: Windows 11's
+ * caption glyphs are one-pixel strokes with anti-aliased diagonals, and the
+ * application icon is blended onto the title colour, neither of which the
+ * core protocol can draw.  Blending against a known, opaque background is all
+ * that is needed -- the title bar is a solid colour -- so no compositing or
+ * Render extension is involved.
+ *
+ * The colours are Windows 11's light caption colours, measured from the real
+ * desktop: a focused title is #f0f3f9 with black text, an unfocused one
+ * #f3f3f3 with grey text and glyphs.  A caption button under the pointer is
+ * washed 6% darker, or for close, filled with Windows' close red (#c42b1c)
+ * with a white glyph.
+ *
+ * The resize border at the end of this file is the other half of a Windows
+ * window's frame: the band outside the visible edge that resizes it.
+ *
+ * Copyright (C) 2026 The LikeOS Project
+ */
+
+/* This file implements the frame-call wrappers ctwm.h routes everything
+ * else through, so it has to see the real Xlib calls. */
+#define CTWM_NO_FRAME_REDIRECT
+#include "ctwm.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#include <X11/Xatom.h>
+#include <X11/Xutil.h>
+#include <X11/Xft/Xft.h>
+
+#include "functions_defs.h"
+#include "screen.h"
+#include "win_decorations.h"
+#include "win_fluent.h"
+
+#define FL_ACTIVE_BG     0xf0f3f9
+#define FL_INACTIVE_BG   0xf3f3f3
+#define FL_ACTIVE_FG     0x000000
+#define FL_INACTIVE_FG   0x8f8f8f
+#define FL_HOVER_ALPHA   0.06
+#define FL_CLOSE_BG      0xc42b1c
+#define FL_CLOSE_FG      0xffffff
+
+#define FL_GLYPH         10   /* caption glyph box, pixels */
+#define FL_ICON          16   /* title icon, pixels */
+#define FL_LEFT_PAD      8    /* title bar edge to the icon or the text */
+#define FL_ICON_ADVANCE  22   /* icon's left edge to the text */
+#define FL_RIGHT_PAD     8    /* text to the first caption button */
+
+typedef enum { FL_NONE, FL_MINIMIZE, FL_MAXIMIZE, FL_CLOSE } FluentKind;
+
+/* The application icon at title size, kept per window: 16x16 ARGB. */
+struct fluent_icon {
+	unsigned int px[FL_ICON * FL_ICON];
+};
+
+/* ------------------------------------------------------------------------ */
+/* Colour helpers                                                           */
+/* ------------------------------------------------------------------------ */
+
+static unsigned long
+chan(unsigned int c8, unsigned long mask)
+{
+	int shift = 0, bits = 0;
+	unsigned long v;
+
+	if(mask == 0) {
+		return 0;
+	}
+	while(!(mask & 1)) {
+		mask >>= 1;
+		shift++;
+	}
+	while(mask & 1) {
+		mask >>= 1;
+		bits++;
+	}
+	v = (bits >= 8) ? ((unsigned long)c8 << (bits - 8)) : (c8 >> (8 - bits));
+	return v << shift;
+}
+
+static unsigned long
+fl_pixel(unsigned int rgb)
+{
+	Visual *v = Scr->d_visual;
+
+	return chan((rgb >> 16) & 0xff, v->red_mask) |
+	       chan((rgb >> 8) & 0xff, v->green_mask) |
+	       chan(rgb & 0xff, v->blue_mask);
+}
+
+/* `a' of `fg' over `bg', both 0xRRGGBB. */
+static unsigned int
+fl_blend(unsigned int bg, unsigned int fg, double a)
+{
+	unsigned int out = 0;
+
+	if(a <= 0) {
+		return bg;
+	}
+	if(a >= 1) {
+		return fg;
+	}
+	for(int s = 0; s <= 16; s += 8) {
+		double b = (bg >> s) & 0xff, f = (fg >> s) & 0xff;
+		unsigned int c = (unsigned int)(b + (f - b) * a + 0.5);
+
+		out |= (c > 255 ? 255 : c) << s;
+	}
+	return out;
+}
+
+/* Everything here assumes a TrueColor screen, which is what every modern
+ * server offers; on anything else the classic decorations are used. */
+static bool
+fl_usable(void)
+{
+	return Scr->FluentTitles && Scr->d_visual &&
+	       Scr->d_visual->class == TrueColor;
+}
+
+static XImage *
+fl_image(int w, int h)
+{
+	char *data = malloc((size_t)w * h * 4);
+	XImage *img;
+
+	if(!data) {
+		return NULL;
+	}
+	img = XCreateImage(dpy, Scr->d_visual, Scr->d_depth, ZPixmap, 0, data,
+	                   w, h, 32, 0);
+	if(!img) {
+		free(data);
+	}
+	return img;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Caption glyphs                                                           */
+/* ------------------------------------------------------------------------ */
+
+/* Distance from (px, py) to the segment (ax, ay)-(bx, by). */
+static double
+seg_dist(double px, double py, double ax, double ay, double bx, double by)
+{
+	double dx = bx - ax, dy = by - ay;
+	double t = ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy);
+
+	if(t < 0) {
+		t = 0;
+	}
+	if(t > 1) {
+		t = 1;
+	}
+	dx = px - (ax + t * dx);
+	dy = py - (ay + t * dy);
+	return sqrt(dx * dx + dy * dy);
+}
+
+/* Signed distance to the outline of the rounded square centred on (cx, cy)
+ * with half-size `h' and corner radius `r'. */
+static double
+rbox_dist(double px, double py, double cx, double cy, double h, double r)
+{
+	double qx = fabs(px - cx) - (h - r), qy = fabs(py - cy) - (h - r);
+	double ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+	double in = (qx > qy ? qx : qy);
+
+	return sqrt(ox * ox + oy * oy) + (in < 0 ? in : 0) - r;
+}
+
+/* Is glyph-space point (x, y) on the stroke of the glyph?  The glyph box is
+ * FL_GLYPH square, pixel (i, j) covering [i, i+1) x [j, j+1), and strokes are
+ * one pixel wide and laid along pixel centres so that the straight ones come
+ * out crisp. */
+static bool
+glyph_hit(FluentKind kind, bool restore, double x, double y)
+{
+	const double lo = 0.5, hi = FL_GLYPH - 0.5;
+
+	switch(kind) {
+		case FL_MINIMIZE:
+			return x >= 0 && x < FL_GLYPH && y >= 5 && y < 6;
+
+		case FL_CLOSE:
+			return seg_dist(x, y, lo, lo, hi, hi) <= 0.5 ||
+			       seg_dist(x, y, lo, hi, hi, lo) <= 0.5;
+
+		case FL_MAXIMIZE:
+			if(!restore) {
+				return fabs(rbox_dist(x, y, FL_GLYPH / 2.0, FL_GLYPH / 2.0,
+				                      (hi - lo) / 2, 1.0)) <= 0.5;
+			}
+			/* Restore: an 8-pixel square at the bottom left, and the top
+			 * and right edges of a second one behind it. */
+			if(fabs(rbox_dist(x, y, lo + 3.5, hi - 3.5, 3.5, 1.0)) <= 0.5) {
+				return true;
+			}
+			if(x >= lo + 2 && y <= hi - 2 &&
+			                fabs(rbox_dist(x, y, hi - 3.5, lo + 3.5, 3.5, 1.0)) <= 0.5) {
+				/* only the part not hidden by the front square */
+				return !(x <= lo + 7.5 && y >= lo + 2);
+			}
+			return false;
+
+		default:
+			return false;
+	}
+}
+
+/* Coverage of pixel (i, j) of the glyph, 0..1, by 4x4 supersampling. */
+static double
+glyph_cover(FluentKind kind, bool restore, int i, int j)
+{
+	int n = 0;
+
+	for(int sy = 0; sy < 4; sy++) {
+		for(int sx = 0; sx < 4; sx++) {
+			if(glyph_hit(kind, restore, i + (sx + 0.5) / 4.0,
+			                j + (sy + 0.5) / 4.0)) {
+				n++;
+			}
+		}
+	}
+	return n / 16.0;
+}
+
+static FluentKind
+fl_kind(TitleButton *tb)
+{
+	TitleButtonFunc *tbf;
+
+	if(!tb) {
+		return FL_NONE;
+	}
+	for(tbf = tb->funs; tbf; tbf = tbf->next) {
+		switch(tbf->func) {
+			case F_ICONIFY:
+				return FL_MINIMIZE;
+			case F_ZOOM: case F_HORIZOOM: case F_FULLZOOM:
+			case F_FULLSCREENZOOM: case F_LEFTZOOM: case F_RIGHTZOOM:
+			case F_TOPZOOM: case F_BOTTOMZOOM: case F_XZOOM:
+			case F_XHORIZOOM: case F_XFULLZOOM: case F_XFULLSCREENZOOM:
+			case F_XLEFTZOOM: case F_XRIGHTZOOM: case F_XTOPZOOM:
+			case F_XBOTTOMZOOM:
+				return FL_MAXIMIZE;
+			case F_DELETE: case F_DESTROY: case F_DELETEORDESTROY:
+				return FL_CLOSE;
+			default:
+				break;
+		}
+	}
+	return FL_NONE;
+}
+
+bool
+FluentPaintTitleButton(TwmWindow *tmp_win, TBWindow *tbw)
+{
+	FluentKind kind;
+	bool focus, restore;
+	unsigned int bg, fg;
+	int w, h, gx, gy;
+	XImage *img;
+
+	if(!fl_usable() || !tbw || !tbw->window) {
+		return false;
+	}
+	kind = fl_kind(tbw->info);
+	if(kind == FL_NONE) {
+		return false;
+	}
+
+	focus = tmp_win->hasfocusvisible;
+	restore = (tmp_win->zoomed != ZOOM_NONE);
+	bg = focus ? FL_ACTIVE_BG : FL_INACTIVE_BG;
+	fg = focus ? FL_ACTIVE_FG : FL_INACTIVE_FG;
+	if(tbw->hover) {
+		if(kind == FL_CLOSE) {
+			bg = FL_CLOSE_BG;
+			fg = FL_CLOSE_FG;
+		}
+		else {
+			bg = fl_blend(bg, 0x000000, FL_HOVER_ALPHA);
+			fg = FL_ACTIVE_FG;
+		}
+	}
+
+	w = Scr->TBInfo.width;
+	h = Scr->TitleHeight;
+	img = fl_image(w, h);
+	if(!img) {
+		return false;
+	}
+
+	unsigned long bgpix = fl_pixel(bg);
+
+	for(int y = 0; y < h; y++) {
+		for(int x = 0; x < w; x++) {
+			XPutPixel(img, x, y, bgpix);
+		}
+	}
+
+	gx = (w - FL_GLYPH) / 2;
+	gy = (h - FL_GLYPH) / 2;
+	for(int j = 0; j < FL_GLYPH; j++) {
+		for(int i = 0; i < FL_GLYPH; i++) {
+			double c = glyph_cover(kind, restore, i, j);
+
+			if(c > 0 && gx + i >= 0 && gx + i < w && gy + j >= 0 && gy + j < h) {
+				XPutPixel(img, gx + i, gy + j, fl_pixel(fl_blend(bg, fg, c)));
+			}
+		}
+	}
+
+	XPutImage(dpy, tbw->window, Scr->NormalGC, img, 0, 0, 0, 0, w, h);
+	XDestroyImage(img);
+	return true;
+}
+
+bool
+FluentButtonCrossing(TwmWindow *tmp_win, Window w, bool entered)
+{
+	TBWindow *tbw;
+	int nb;
+
+	if(!fl_usable() || !tmp_win || !tmp_win->titlebuttons) {
+		return false;
+	}
+	nb = Scr->TBInfo.nleft + Scr->TBInfo.nright;
+	tbw = tmp_win->titlebuttons;
+	for(int i = 0; i < nb; i++, tbw++) {
+		if(tbw->window == w) {
+			tbw->hover = entered;
+			if(!FluentPaintTitleButton(tmp_win, tbw)) {
+				PaintTitleButton(tmp_win, tbw);
+			}
+			return true;
+		}
+	}
+	return false;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Title icon                                                               */
+/* ------------------------------------------------------------------------ */
+
+/* The application's icon at 16x16, from _NET_WM_ICON.
+ *
+ * The property holds a list of (width, height, ARGB pixels...) images.  The
+ * smallest that is at least 16 pixels is taken -- downsampling a 256-pixel
+ * icon to 16 turns detail into mud -- and box-filtered down to size, in
+ * premultiplied alpha so that transparent pixels do not darken the edges. */
+static struct fluent_icon *
+fl_load_icon(TwmWindow *tmp_win)
+{
+	static Atom net_wm_icon = None;
+	Atom type;
+	int fmt;
+	unsigned long n, after;
+	unsigned char *data = NULL;
+	struct fluent_icon *ic = NULL;
+
+	if(net_wm_icon == None) {
+		net_wm_icon = XInternAtom(dpy, "_NET_WM_ICON", False);
+	}
+	if(XGetWindowProperty(dpy, tmp_win->w, net_wm_icon, 0, 1 << 20, False,
+	                      XA_CARDINAL, &type, &fmt, &n, &after,
+	                      &data) != Success || !data) {
+		return NULL;
+	}
+	if(type != XA_CARDINAL || fmt != 32) {
+		XFree(data);
+		return NULL;
+	}
+
+	/* Format-32 properties come back as an array of longs. */
+	unsigned long *p = (unsigned long *)data;
+	unsigned long i = 0, best = 0, bw = 0, bh = 0;
+
+	while(i + 2 <= n) {
+		unsigned long iw = p[i], ih = p[i + 1];
+
+		if(iw == 0 || ih == 0 || iw > 4096 || ih > 4096 ||
+		                i + 2 + iw * ih > n) {
+			break;
+		}
+		if((iw >= FL_ICON && (bw < FL_ICON || iw < bw)) ||
+		                (bw < FL_ICON && iw > bw)) {
+			best = i + 2;
+			bw = iw;
+			bh = ih;
+		}
+		i += 2 + iw * ih;
+	}
+
+	if(bw > 0 && (ic = calloc(1, sizeof(*ic)))) {
+		for(int y = 0; y < FL_ICON; y++) {
+			for(int x = 0; x < FL_ICON; x++) {
+				unsigned long x0 = x * bw / FL_ICON, x1 = (x + 1) * bw / FL_ICON;
+				unsigned long y0 = y * bh / FL_ICON, y1 = (y + 1) * bh / FL_ICON;
+				double a = 0, r = 0, g = 0, b = 0;
+				unsigned long cnt = 0;
+
+				if(x1 <= x0) {
+					x1 = x0 + 1;
+				}
+				if(y1 <= y0) {
+					y1 = y0 + 1;
+				}
+				for(unsigned long yy = y0; yy < y1 && yy < bh; yy++) {
+					for(unsigned long xx = x0; xx < x1 && xx < bw; xx++) {
+						unsigned long v = p[best + yy * bw + xx];
+						double al = ((v >> 24) & 0xff) / 255.0;
+
+						a += al;
+						r += ((v >> 16) & 0xff) * al;
+						g += ((v >> 8) & 0xff) * al;
+						b += (v & 0xff) * al;
+						cnt++;
+					}
+				}
+				if(cnt == 0 || a <= 0) {
+					continue;
+				}
+				r /= a;
+				g /= a;
+				b /= a;
+				a /= cnt;
+				ic->px[y * FL_ICON + x] =
+				        ((unsigned int)(a * 255 + 0.5) << 24) |
+				        ((unsigned int)(r + 0.5) << 16) |
+				        ((unsigned int)(g + 0.5) << 8) |
+				        (unsigned int)(b + 0.5);
+			}
+		}
+	}
+	XFree(data);
+	return ic;
+}
+
+void
+FluentIconChanged(TwmWindow *tmp_win)
+{
+	if(!tmp_win) {
+		return;
+	}
+	free(tmp_win->fluent_icon);
+	tmp_win->fluent_icon = NULL;
+	tmp_win->fluent_icon_tried = false;
+	if(fl_usable() && tmp_win->title_w) {
+		FluentPaintTitle(tmp_win);
+	}
+}
+
+static void fl_grip_destroy(TwmWindow *tmp_win);
+
+void
+FluentForgetWindow(TwmWindow *tmp_win)
+{
+	if(!tmp_win) {
+		return;
+	}
+	free(tmp_win->fluent_icon);
+	tmp_win->fluent_icon = NULL;
+	tmp_win->fluent_icon_tried = false;
+	fl_grip_destroy(tmp_win);
+}

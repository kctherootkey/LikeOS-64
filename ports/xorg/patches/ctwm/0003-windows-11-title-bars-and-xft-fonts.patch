+/* ------------------------------------------------------------------------ */
+/* Title bar                                                                */
+/* ------------------------------------------------------------------------ */
+
+/* Shorten `s' (UTF-8) so that it and an ellipsis fit in `avail' pixels. */
+static char *
+fl_fit(XftFont *font, const char *s, int avail)
+{
+	XGlyphInfo gi;
+	size_t len = strlen(s);
+	char *out;
+
+	XftTextExtentsUtf8(dpy, font, (const FcChar8 *)s, (int)len, &gi);
+	if(gi.xOff <= avail) {
+		return strdup(s);
+	}
+	out = malloc(len + 4);
+	if(!out) {
+		return NULL;
+	}
+	while(len > 0) {
+		/* step back one whole UTF-8 character */
+		do {
+			len--;
+		}
+		while(len > 0 && ((unsigned char)s[len] & 0xc0) == 0x80);
+		memcpy(out, s, len);
+		memcpy(out + len, "\xe2\x80\xa6", 4);
+		XftTextExtentsUtf8(dpy, font, (const FcChar8 *)out, (int)len + 3, &gi);
+		if(gi.xOff <= avail) {
+			return out;
+		}
+	}
+	free(out);
+	return NULL;
+}
+
+void
+FluentPaintTitle(TwmWindow *tmp_win)
+{
+	bool focus;
+	unsigned int bg, fg;
+	int x, h, avail;
+	MyFont *font = &Scr->TitleBarFont;
+
+	if(!tmp_win->title_w) {
+		return;
+	}
+	focus = tmp_win->hasfocusvisible;
+	bg = focus ? FL_ACTIVE_BG : FL_INACTIVE_BG;
+	fg = focus ? FL_ACTIVE_FG : FL_INACTIVE_FG;
+	h = Scr->TitleHeight;
+
+	XSetForeground(dpy, Scr->NormalGC, fl_pixel(bg));
+	XFillRectangle(dpy, tmp_win->title_w, Scr->NormalGC, 0, 0,
+	               tmp_win->title_width, h);
+
+	/*
+	 * The title window has a border as wide as the frame's, and the frame
+	 * clips all of it except the bottom edge -- which would draw a line in
+	 * the border colour between the title and the window contents.  Windows
+	 * has no such line, so that edge takes the title's own colour.  (The
+	 * focus code sets the border colour on every change; this runs after
+	 * it.)
+	 */
+	if(tmp_win->frame_bw > 0) {
+		XSetWindowBorder(dpy, tmp_win->title_w, fl_pixel(bg));
+	}
+
+	x = FL_LEFT_PAD + Scr->TBInfo.titlex;
+
+	if(!tmp_win->fluent_icon_tried) {
+		tmp_win->fluent_icon = fl_load_icon(tmp_win);
+		tmp_win->fluent_icon_tried = true;
+	}
+	if(tmp_win->fluent_icon && h >= FL_ICON) {
+		XImage *img = fl_image(FL_ICON, FL_ICON);
+
+		if(img) {
+			for(int y = 0; y < FL_ICON; y++) {
+				for(int xx = 0; xx < FL_ICON; xx++) {
+					unsigned int v = tmp_win->fluent_icon->px[y * FL_ICON + xx];
+					double a = ((v >> 24) & 0xff) / 255.0;
+
+					XPutPixel(img, xx, y,
+					          fl_pixel(fl_blend(bg, v & 0xffffff, a)));
+				}
+			}
+			XPutImage(dpy, tmp_win->title_w, Scr->NormalGC, img, 0, 0,
+			          x, (h - FL_ICON) / 2, FL_ICON, FL_ICON);
+			XDestroyImage(img);
+		}
+		x += FL_ICON_ADVANCE;
+	}
+
+	if(!tmp_win->name || !*tmp_win->name) {
+		return;
+	}
+	avail = (int)tmp_win->title_width - Scr->TBInfo.rightoff - FL_RIGHT_PAD - x;
+	if(avail <= 0) {
+		return;
+	}
+
+	if(font->xft) {
+		XftDraw *d = XftDrawCreate(dpy, tmp_win->title_w, Scr->d_visual,
+		                           DefaultColormap(dpy, Scr->screen));
+		XRenderColor rc = {
+			.red = ((fg >> 16) & 0xff) * 257,
+			.green = ((fg >> 8) & 0xff) * 257,
+			.blue = (fg & 0xff) * 257,
+			.alpha = 0xffff,
+		};
+		XftColor col;
+		char *text = fl_fit(font->xft, tmp_win->name, avail);
+
+		if(d && text && XftColorAllocValue(dpy, Scr->d_visual,
+		                                   DefaultColormap(dpy, Scr->screen),
+		                                   &rc, &col)) {
+			int base = (h - (font->xft->ascent + font->xft->descent)) / 2 +
+			           font->xft->ascent;
+
+			XftDrawStringUtf8(d, &col, font->xft, x, base,
+			                  (const FcChar8 *)text, (int)strlen(text));
+			XftColorFree(dpy, Scr->d_visual,
+			             DefaultColormap(dpy, Scr->screen), &col);
+		}
+		free(text);
+		if(d) {
+			XftDrawDestroy(d);
+		}
+	}
+	else {
+		XRectangle ink, logical;
+		int len = (int)strlen(tmp_win->name);
+
+		XSetForeground(dpy, Scr->NormalGC, fl_pixel(fg));
+		XmbTextExtents(font->font_set, tmp_win->name, len, &ink, &logical);
+		while(len > 0 && logical.width > avail) {
+			len--;
+			XmbTextExtents(font->font_set, tmp_win->name, len, &ink, &logical);
+		}
+		XmbDrawString(dpy, tmp_win->title_w, font->font_set, Scr->NormalGC, x,
+		              (h - logical.height) / 2 - logical.y, tmp_win->name, len);
+	}
+}
+
+void
+FluentFocusChanged(TwmWindow *tmp_win, bool focus)
+{
+	(void)focus;
+	if(!fl_usable() || !tmp_win || !tmp_win->title_w) {
+		return;
+	}
+	FluentPaintTitle(tmp_win);
+	/* AddWindow sets the focus look before the buttons exist. */
+	if(tmp_win->titlebuttons) {
+		PaintTitleButtons(tmp_win);
+	}
+}
+
+/* ------------------------------------------------------------------------ */
+/* The resize border                                                        */
+/* ------------------------------------------------------------------------ */
+
+#define FL_GRIP          6    /* the band outside the frame, pixels */
+#define FL_GRIP_CORNER   16   /* along an edge from a corner: the corner */
+
+/* Borders in existence; the frame-call wrappers do nothing extra while it
+ * is 0, which it is whenever FluentTitles is off. */
+static int fl_grips;
+
+/* Does the window get a border at all?  Not without a frame edge (docks,
+ * the desktop, NoBorder windows), and not for a window whose size is fixed
+ * -- Windows draws no resize border on those either. */
+static bool
+fl_resizable(TwmWindow *t)
+{
+	const XSizeHints *h = &t->hints;
+
+	if((h->flags & PMinSize) && (h->flags & PMaxSize) &&
+	                h->min_width == h->max_width &&
+	                h->min_height == h->max_height) {
+		return false;
+	}
+	return true;
+}
+
+/* Show the border while the frame is shown, the window is not maximised
+ * (a maximised Windows window cannot be resized by its edges) and its size
+ * is not fixed; bring it to the frame's geometry and, when the frame was
+ * restacked, put it back directly beneath the frame. */
+static void
+fl_grip_sync(TwmWindow *t, bool restack)
+{
+	bool want;
+
+	int gx, gy;
+	unsigned int gw, gh;
+
+	if(t->fluent_grip == None) {
+		return;
+	}
+	/* Only when it changed: this runs for every move step and every
+	 * restack, and a configure request is never free. */
+	gx = t->fluent_fx - FL_GRIP;
+	gy = t->fluent_fy - FL_GRIP;
+	gw = t->fluent_fw + 2 * t->fluent_fbw + 2 * FL_GRIP;
+	gh = t->fluent_fh + 2 * t->fluent_fbw + 2 * FL_GRIP;
+	if(gx != t->fluent_gx || gy != t->fluent_gy || gw != t->fluent_gw ||
+	                gh != t->fluent_gh) {
+		XMoveResizeWindow(dpy, t->fluent_grip, gx, gy, gw, gh);
+		t->fluent_gx = gx;
+		t->fluent_gy = gy;
+		t->fluent_gw = gw;
+		t->fluent_gh = gh;
+	}
+	if(restack) {
+		XWindowChanges xwc;
+
+		xwc.sibling = t->frame;
+		xwc.stack_mode = Below;
+		XConfigureWindow(dpy, t->fluent_grip, CWSibling | CWStackMode, &xwc);
+	}
+	want = t->fluent_frame_mapped && t->zoomed == ZOOM_NONE &&
+	       fl_resizable(t);
+	if(want && !t->fluent_grip_mapped) {
+		if(!restack) {
+			XWindowChanges xwc;
+
+			xwc.sibling = t->frame;
+			xwc.stack_mode = Below;
+			XConfigureWindow(dpy, t->fluent_grip, CWSibling | CWStackMode,
+			                 &xwc);
+		}
+		XMapWindow(dpy, t->fluent_grip);
+		t->fluent_grip_mapped = true;
+	}
+	else if(!want && t->fluent_grip_mapped) {
+		XUnmapWindow(dpy, t->fluent_grip);
+		t->fluent_grip_mapped = false;
+	}
+}
+
+void
+FluentGripCreate(TwmWindow *tmp_win)
+{
+	XSetWindowAttributes attr;
+	XWindowAttributes wa;
+	Window root, parent, *kids = NULL;
+	unsigned int nkids;
+
+	if(!fl_usable() || !tmp_win || tmp_win->frame == None ||
+	                tmp_win->frame_bw <= 0 || tmp_win->fluent_grip != None) {
+		return;
+	}
+	/* ctwm's own windows (icon and workspace managers, the occupy
+	 * dialog) are not resized by hand. */
+	if(tmp_win->isiconmgr || tmp_win->iswspmgr || tmp_win->isoccupy) {
+		return;
+	}
+	/* Where the frame really is: the placement code may have moved it
+	 * since it was created. */
+	if(!XGetWindowAttributes(dpy, tmp_win->frame, &wa) ||
+	                !XQueryTree(dpy, tmp_win->frame, &root, &parent, &kids,
+	                            &nkids)) {
+		return;
+	}
+	if(kids) {
+		XFree(kids);
+	}
+	tmp_win->fluent_grip_parent = parent;
+	tmp_win->fluent_gx = wa.x - FL_GRIP;
+	tmp_win->fluent_gy = wa.y - FL_GRIP;
+	tmp_win->fluent_gw = (unsigned int)wa.width + 2 * (unsigned int)wa.border_width + 2 * FL_GRIP;
+	tmp_win->fluent_gh = (unsigned int)wa.height + 2 * (unsigned int)wa.border_width + 2 * FL_GRIP;
+	tmp_win->fluent_fx = wa.x;
+	tmp_win->fluent_fy = wa.y;
+	tmp_win->fluent_fw = (unsigned int)wa.width;
+	tmp_win->fluent_fh = (unsigned int)wa.height;
+	tmp_win->fluent_fbw = (unsigned int)wa.border_width;
+	tmp_win->fluent_frame_mapped = (wa.map_state != IsUnmapped);
+	tmp_win->fluent_grip_edges = -1;
+
+	/* Override-redirect: it is ctwm's own furniture, not a window for
+	 * anyone to manage or list. */
+	attr.override_redirect = True;
+	attr.event_mask = ButtonPressMask | ButtonReleaseMask | PointerMotionMask;
+	attr.cursor = Scr->FrameCursor;
+	tmp_win->fluent_grip = XCreateWindow(dpy, parent,
+	                                     wa.x - FL_GRIP, wa.y - FL_GRIP,
+	                                     (unsigned int)wa.width + 2 * (unsigned int)wa.border_width + 2 * FL_GRIP,
+	                                     (unsigned int)wa.height + 2 * (unsigned int)wa.border_width + 2 * FL_GRIP,
+	                                     0, 0, InputOnly, CopyFromParent,
+	                                     CWOverrideRedirect | CWEventMask | CWCursor,
+	                                     &attr);
+	if(tmp_win->fluent_grip == None) {
+		return;
+	}
+	if(Scr->NameDecorations) {
+		XStoreName(dpy, tmp_win->fluent_grip, "CTWM resize border");
+	}
+	XSaveContext(dpy, tmp_win->fluent_grip, TwmContext, (XPointer) tmp_win);
+	XSaveContext(dpy, tmp_win->fluent_grip, ScreenContext, (XPointer) Scr);
+	fl_grips++;
+	fl_grip_sync(tmp_win, true);
+}
+
+static void
+fl_grip_destroy(TwmWindow *tmp_win)
+{
+	if(tmp_win->fluent_grip == None) {
+		return;
+	}
+	XDeleteContext(dpy, tmp_win->fluent_grip, TwmContext);
+	XDeleteContext(dpy, tmp_win->fluent_grip, ScreenContext);
+	XDestroyWindow(dpy, tmp_win->fluent_grip);
+	tmp_win->fluent_grip = None;
+	tmp_win->fluent_grip_mapped = false;
+	fl_grips--;
+}
+
+/* The edges at (x, y), frame coordinates (the frame's outer top-left corner
+ * is 0,0, so the band around it is negative or beyond its size): the frame's
+ * own one-pixel edge counts, the band outside it, and near a corner the
+ * corner -- FL_GRIP_CORNER pixels along either edge, as on Windows. */
+static int
+fl_edges_at(TwmWindow *t, int x, int y)
+{
+	int w = (int)(t->fluent_fw + 2 * t->fluent_fbw);
+	int h = (int)(t->fluent_fh + 2 * t->fluent_fbw);
+	int bw = (int)t->fluent_fbw;
+	int e = 0;
+
+	if(x < bw) {
+		e |= FLUENT_EDGE_LEFT;
+	}
+	else if(x >= w - bw) {
+		e |= FLUENT_EDGE_RIGHT;
+	}
+	if(y < bw) {
+		e |= FLUENT_EDGE_TOP;
+	}
+	else if(y >= h - bw) {
+		e |= FLUENT_EDGE_BOTTOM;
+	}
+	if(e & (FLUENT_EDGE_TOP | FLUENT_EDGE_BOTTOM)) {
+		if(x < FL_GRIP_CORNER) {
+			e |= FLUENT_EDGE_LEFT;
+		}
+		else if(x >= w - FL_GRIP_CORNER) {
+			e |= FLUENT_EDGE_RIGHT;
+		}
+	}
+	if(e & (FLUENT_EDGE_LEFT | FLUENT_EDGE_RIGHT)) {
+		if(y < FL_GRIP_CORNER) {
+			e |= FLUENT_EDGE_TOP;
+		}
+		else if(y >= h - FL_GRIP_CORNER) {
+			e |= FLUENT_EDGE_BOTTOM;
+		}
+	}
+	return e;
+}
+
+Cursor
+FluentEdgeCursor(int edges)
+{
+	switch(edges) {
+		case FLUENT_EDGE_TOP | FLUENT_EDGE_LEFT:
+			return TopLeftCursor;
+		case FLUENT_EDGE_TOP | FLUENT_EDGE_RIGHT:
+			return TopRightCursor;
+		case FLUENT_EDGE_BOTTOM | FLUENT_EDGE_LEFT:
+			return BottomLeftCursor;
+		case FLUENT_EDGE_BOTTOM | FLUENT_EDGE_RIGHT:
+			return BottomRightCursor;
+		case FLUENT_EDGE_TOP:
+			return TopCursor;
+		case FLUENT_EDGE_BOTTOM:
+			return BottomCursor;
+		case FLUENT_EDGE_LEFT:
+			return LeftCursor;
+		case FLUENT_EDGE_RIGHT:
+			return RightCursor;
+		default:
+			return Scr->FrameCursor;
+	}
+}
+
+void
+FluentGripMotion(TwmWindow *tmp_win, int x, int y)
+{
+	int e;
+
+	if(!tmp_win || tmp_win->fluent_grip == None) {
+		return;
+	}
+	e = fl_edges_at(tmp_win, x - FL_GRIP, y - FL_GRIP);
+	if(e != tmp_win->fluent_grip_edges) {
+		XDefineCursor(dpy, tmp_win->fluent_grip, FluentEdgeCursor(e));
+		tmp_win->fluent_grip_edges = e;
+	}
+}
+
+int
+FluentResizeEdges(TwmWindow *tmp_win, XEvent *evp, int fx, int fy, int fw,
+                  int fh)
+{
+	int bw;
+
+	if(!fl_usable() || !tmp_win || evp->type != ButtonPress) {
+		return 0;
+	}
+	if(evp->xbutton.window != tmp_win->frame &&
+	                (tmp_win->fluent_grip == None ||
+	                 evp->xbutton.window != tmp_win->fluent_grip)) {
+		return 0;
+	}
+	/* fx..fh are the inner geometry; the edges are measured from the
+	 * outer corner, where the frame's border begins. */
+	bw = tmp_win->frame_bw;
+	(void)fw;
+	(void)fh;
+	return fl_edges_at(tmp_win, evp->xbutton.x_root - (fx - bw),
+	                   evp->xbutton.y_root - (fy - bw));
+}
+
+/* ---- The frame-call wrappers (see ctwm.h) -------------------------------- */
+
+/*
+ * Before the frame itself is restacked, its border goes to the bottom of the
+ * stack, out of everything's way; fl_grip_sync() puts it back under the frame
+ * afterwards.
+ *
+ * Without this the restack passes through a state where the border is ABOVE
+ * its own frame: ctwm raises a window by placing it directly above the next
+ * frame down ("Above sibling"), which lands it underneath its border still
+ * sitting there.  For the moment between that request and the border's own
+ * restack the pointer is over the border, not the application -- and the
+ * application is told it left its window and came back.  ctwm raises on every
+ * click, the wheel included, and GDK takes each such re-entry as a new
+ * scrolling gesture and drops the scroll position it measures smooth scrolling
+ * from: the wheel did nothing in most GTK programs.
+ */
+static void
+fl_grip_out_of_the_way(Display *d, TwmWindow *t)
+{
+	if(t->fluent_grip_mapped) {
+		XLowerWindow(d, t->fluent_grip);
+	}
+}
+
+/* The window `w' is a frame that has a border: its TwmWindow, else NULL. */
+static TwmWindow *
+fl_frame_owner(Display *d, Window w)
+{
+	TwmWindow *t;
+
+	if(fl_grips == 0 ||
+	                XFindContext(d, w, TwmContext, (XPointer *)&t) != XCSUCCESS) {
+		return NULL;
+	}
+	return (t && t->frame == w && t->fluent_grip != None) ? t : NULL;
+}
+
+int
+ctwm_XMapWindow(Display *d, Window w)
+{
+	int r = XMapWindow(d, w);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		t->fluent_frame_mapped = true;
+		fl_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XMapRaised(Display *d, Window w)
+{
+	int r = XMapRaised(d, w);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		t->fluent_frame_mapped = true;
+		fl_grip_sync(t, true);
+	}
+	return r;
+}
+
+int
+ctwm_XUnmapWindow(Display *d, Window w)
+{
+	int r = XUnmapWindow(d, w);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		t->fluent_frame_mapped = false;
+		fl_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XMoveWindow(Display *d, Window w, int x, int y)
+{
+	int r = XMoveWindow(d, w, x, y);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		t->fluent_fx = x;
+		t->fluent_fy = y;
+		fl_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XResizeWindow(Display *d, Window w, unsigned int width,
+                   unsigned int height)
+{
+	int r = XResizeWindow(d, w, width, height);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		t->fluent_fw = width;
+		t->fluent_fh = height;
+		fl_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XMoveResizeWindow(Display *d, Window w, int x, int y,
+                       unsigned int width, unsigned int height)
+{
+	int r = XMoveResizeWindow(d, w, x, y, width, height);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		t->fluent_fx = x;
+		t->fluent_fy = y;
+		t->fluent_fw = width;
+		t->fluent_fh = height;
+		fl_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XConfigureWindow(Display *d, Window w, unsigned int mask,
+                      XWindowChanges *xwc)
+{
+	TwmWindow *t = fl_frame_owner(d, w);
+	int r;
+
+	if(t && (mask & CWStackMode)) {
+		fl_grip_out_of_the_way(d, t);
+	}
+	r = XConfigureWindow(d, w, mask, xwc);
+
+	if(t) {
+		if(mask & CWX) {
+			t->fluent_fx = xwc->x;
+		}
+		if(mask & CWY) {
+			t->fluent_fy = xwc->y;
+		}
+		if(mask & CWWidth) {
+			t->fluent_fw = (unsigned int)xwc->width;
+		}
+		if(mask & CWHeight) {
+			t->fluent_fh = (unsigned int)xwc->height;
+		}
+		if(mask & CWBorderWidth) {
+			t->fluent_fbw = (unsigned int)xwc->border_width;
+		}
+		fl_grip_sync(t, (mask & CWStackMode) != 0);
+	}
+	return r;
+}
+
+int
+ctwm_XSetWindowBorderWidth(Display *d, Window w, unsigned int width)
+{
+	int r = XSetWindowBorderWidth(d, w, width);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		t->fluent_fbw = width;
+		fl_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XRaiseWindow(Display *d, Window w)
+{
+	int r = XRaiseWindow(d, w);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		fl_grip_sync(t, true);
+	}
+	return r;
+}
+
+int
+ctwm_XLowerWindow(Display *d, Window w)
+{
+	TwmWindow *t = fl_frame_owner(d, w);
+	int r;
+
+	if(t) {
+		fl_grip_out_of_the_way(d, t);
+	}
+	r = XLowerWindow(d, w);
+
+	if(t) {
+		fl_grip_sync(t, true);
+	}
+	return r;
+}
+
+int
+ctwm_XRestackWindows(Display *d, Window *ws, int n)
+{
+	int r;
+
+	for(int i = 0; i < n; i++) {
+		TwmWindow *t = fl_frame_owner(d, ws[i]);
+
+		if(t) {
+			fl_grip_out_of_the_way(d, t);
+		}
+	}
+	r = XRestackWindows(d, ws, n);
+
+	for(int i = 0; i < n; i++) {
+		TwmWindow *t = fl_frame_owner(d, ws[i]);
+
+		if(t) {
+			fl_grip_sync(t, true);
+		}
+	}
+	return r;
+}
+
+int
+ctwm_XReparentWindow(Display *d, Window w, Window parent, int x, int y)
+{
+	int r = XReparentWindow(d, w, parent, x, y);
+	TwmWindow *t = fl_frame_owner(d, w);
+
+	if(t) {
+		/* Reparenting unmaps and remaps a mapped window; the border
+		 * goes along the same way, into the same parent. */
+		XReparentWindow(d, t->fluent_grip, parent, x - FL_GRIP, y - FL_GRIP);
+		t->fluent_grip_parent = parent;
+		t->fluent_fx = x;
+		t->fluent_fy = y;
+		t->fluent_gx = x - FL_GRIP;
+		t->fluent_gy = y - FL_GRIP;
+		fl_grip_sync(t, true);
+	}
+	return r;
+}
diff -Nur a/win_fluent.h b/win_fluent.h
--- a/win_fluent.h
+++ b/win_fluent.h
@@ -0,0 +1,87 @@
+/*
+ * LikeOS -- Windows 11 style title bars for ctwm ("FluentTitles").
+ *
+ * With the FluentTitles keyword set, ctwm draws its title bars the way
+ * Windows 11 draws a desktop application's caption: a flat band whose colour
+ * says whether the window has the focus, the application's icon and its title
+ * on the left in an anti-aliased font, and caption buttons on the right that
+ * are 46 pixels wide, carry thin anti-aliased glyphs instead of bitmaps, and
+ * highlight under the pointer -- the close button in red.
+ *
+ * The glyph a button gets follows from the function bound to it: f.iconify
+ * draws the minimise line, the zoom functions the maximise square (or the
+ * restore glyph while the window is zoomed), f.delete and f.destroy the cross.
+ * A button bound to anything else keeps its configured image.
+ *
+ * Copyright (C) 2026 The LikeOS Project
+ */
+
+#ifndef _CTWM_WIN_FLUENT_H
+#define _CTWM_WIN_FLUENT_H
+
+/* Draw the whole title bar band: background, icon and name. */
+void FluentPaintTitle(TwmWindow *tmp_win);
+
+/* Draw one caption button in its current state.  Returns false for a button
+ * whose function has no Windows glyph, which the caller then draws the
+ * classic way. */
+bool FluentPaintTitleButton(TwmWindow *tmp_win, TBWindow *tbw);
+
+/* The window gained or lost the focus: redraw the title and its buttons in
+ * the colours for the new state. */
+void FluentFocusChanged(TwmWindow *tmp_win, bool focus);
+
+/* An EnterNotify or LeaveNotify on window `w'.  Returns true when `w' is one
+ * of tmp_win's caption buttons, which have then been redrawn hovered or not;
+ * false means the event is for somebody else. */
+bool FluentButtonCrossing(TwmWindow *tmp_win, Window w, bool entered);
+
+/* The window's _NET_WM_ICON changed: forget the cached title icon. */
+void FluentIconChanged(TwmWindow *tmp_win);
+
+/* The window is going away: free what FluentPaintTitle cached for it, and
+ * its resize border. */
+void FluentForgetWindow(TwmWindow *tmp_win);
+
+/*
+ * The resize border.
+ *
+ * A Windows 11 window has a one-pixel visible edge, and the band that resizes
+ * it lies OUTSIDE that edge, where nothing is drawn: the pointer turns into a
+ * double arrow a few pixels short of the window, and a drag there resizes it.
+ * Without a compositor nothing can be drawn transparently, so the band is an
+ * InputOnly window -- invisible by definition -- a few pixels larger than the
+ * frame on every side and stacked directly beneath it.  The frame covers its
+ * middle; the ring around the frame is the band.  Being directly beneath its
+ * own frame, it is covered by every window above that frame, exactly as the
+ * window itself is.
+ *
+ * It has to follow the frame through every move, resize, restack, map, unmap
+ * and reparent.  ctwm does those in some thirty places, so rather than hook
+ * each one, ctwm.h routes the Xlib calls that do them through the wrappers
+ * below, which make the call and then bring the border along when the window
+ * is a frame that has one.
+ */
+
+/* Create the border for a newly managed window (frame already created). */
+void FluentGripCreate(TwmWindow *tmp_win);
+
+/* Pointer motion over the border, in its coordinates: set the cursor for the
+ * edge or corner the pointer is on. */
+void FluentGripMotion(TwmWindow *tmp_win, int x, int y);
+
+/* Edges a resize started by `evp' moves, as FLUENT_EDGE_* bits: the edges
+ * nearest the pointer when the press was on the border (or on the frame's
+ * own one-pixel edge), 0 otherwise.  fx..fh are the frame's inner geometry,
+ * as StartResize() has it. */
+#define FLUENT_EDGE_TOP    1
+#define FLUENT_EDGE_BOTTOM 2
+#define FLUENT_EDGE_LEFT   4
+#define FLUENT_EDGE_RIGHT  8
+int FluentResizeEdges(TwmWindow *tmp_win, XEvent *evp, int fx, int fy,
+                      int fw, int fh);
+
+/* The cursor for a set of FLUENT_EDGE_* bits. */
+Cursor FluentEdgeCursor(int edges);
+
+#endif /* _CTWM_WIN_FLUENT_H */

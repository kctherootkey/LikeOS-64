+/*
+ * Which fontsets stand for an Xft font.  A handful at most -- one per font
+ * keyword -- so a linear table is all it needs.  Keyed on the MyFont, whose
+ * font_set changes when the font is reloaded.
+ */
+#define XFT_FONTS_MAX 16
+static MyFont *xft_fonts[XFT_FONTS_MAX];
+
+static void
+xft_register(MyFont *font)
+{
+	int free_slot = -1;
+
+	for(int i = 0; i < XFT_FONTS_MAX; i++) {
+		if(xft_fonts[i] == font) {
+			return;
+		}
+		if(xft_fonts[i] == NULL && free_slot < 0) {
+			free_slot = i;
+		}
+	}
+	if(free_slot >= 0) {
+		xft_fonts[free_slot] = font;
+	}
+}
+
+static XftFont *
+xft_for(XFontSet fs)
+{
+	if(fs == NULL) {
+		return NULL;
+	}
+	for(int i = 0; i < XFT_FONTS_MAX; i++) {
+		if(xft_fonts[i] && xft_fonts[i]->font_set == fs) {
+			return xft_fonts[i]->xft;
+		}
+	}
+	return NULL;
+}
+
+int
+ctwm_XmbTextExtents(XFontSet fs, const char *text, int len,
+                    XRectangle *ink, XRectangle *logical)
+{
+	XftFont *xf = xft_for(fs);
+	XGlyphInfo gi;
+
+	if(xf == NULL) {
+		return XmbTextExtents(fs, text, len, ink, logical);
+	}
+	XftTextExtentsUtf8(dpy, xf, (const FcChar8 *)text, len, &gi);
+	if(ink) {
+		ink->x = -gi.x;
+		ink->y = -gi.y;
+		ink->width = gi.width;
+		ink->height = gi.height;
+	}
+	if(logical) {
+		logical->x = 0;
+		logical->y = -xf->ascent;
+		logical->width = gi.xOff;
+		logical->height = xf->ascent + xf->descent;
+	}
+	return gi.xOff;
+}
+
+/*
+ * The colour comes from the GC's foreground, which is how every caller sets
+ * it; the last pixel is cached, since a run of draws usually shares one.
+ */
+void
+ctwm_XmbDrawString(Display *d, Drawable w, XFontSet fs, GC gc,
+                   int x, int y, const char *text, int len)
+{
+	static Pixel last_pixel;
+	static XftColor last_color;
+	static bool have_color = false;
+	XftFont *xf = xft_for(fs);
+	XGCValues gv;
+	XftDraw *draw;
+
+	if(xf == NULL) {
+		XmbDrawString(d, w, fs, gc, x, y, text, len);
+		return;
+	}
+
+	XGetGCValues(d, gc, GCForeground, &gv);
+	if(!have_color || gv.foreground != last_pixel) {
+		XColor xc;
+		XRenderColor rc;
+
+		xc.pixel = gv.foreground;
+		XQueryColor(d, DefaultColormap(d, Scr->screen), &xc);
+		rc.red = xc.red;
+		rc.green = xc.green;
+		rc.blue = xc.blue;
+		rc.alpha = 0xffff;
+		if(have_color) {
+			XftColorFree(d, Scr->d_visual, DefaultColormap(d, Scr->screen),
+			             &last_color);
+		}
+		have_color = XftColorAllocValue(d, Scr->d_visual,
+		                                DefaultColormap(d, Scr->screen),
+		                                &rc, &last_color);
+		last_pixel = gv.foreground;
+		if(!have_color) {
+			return;
+		}
+	}
+
+	draw = XftDrawCreate(d, w, Scr->d_visual, DefaultColormap(d, Scr->screen));
+	if(draw) {
+		XftDrawStringUtf8(draw, &last_color, xf, x, y, (const FcChar8 *)text,
+		                  len);
+		XftDrawDestroy(draw);
+	}
+}

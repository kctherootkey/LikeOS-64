+/* The caption button held down, the window it is on, what it runs and the
+ * mouse button holding it. */
+static struct {
+	TwmWindow *win;
+	TBWindow *tbw;
+	int func;
+	char *action;
+	unsigned int button;
+} md_press;
+
+bool
+ModernCaptionPress(TwmWindow *tmp_win, TBWindow *tbw, int func, char *action)
+{
+	if(!md_usable() || !tmp_win || !tbw || func == F_MENU ||
+	                md_kind(tbw->info) == MD_NONE) {
+		return false;
+	}
+	md_press.win = tmp_win;
+	md_press.tbw = tbw;
+	md_press.func = func;
+	md_press.action = action;
+	md_press.button = Event.xbutton.button;
+	tbw->pressed = true;
+	tbw->hover = true;
+	ModernPaintTitleButton(tmp_win, tbw);
+	return true;
+}
+
+bool
+ModernCaptionRelease(XEvent *ev)
+{
+	TwmWindow *t = md_press.win;
+	TBWindow *tbw = md_press.tbw;
+	bool over;

+/* ------------------------------------------------------------------------ */
+/* Rounded corners                                                          */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * A window has corners rounded to a 10-pixel radius, except while it is
+ * maximised, snapped to half the screen or fullscreen, where it meets the
+ * screen's edges square.
+ *
+ * Without a compositor the outside of the curve can only be cut away: the
+ * frame's bounding shape (X Shape extension) is the rounded rectangle, and
+ * what is behind the window shows through the cut-off pixels -- among them
+ * the invisible resize border, which lies right under the frame, so the
+ * corner resizes as before.  The frame's shape clips everything in it, the
+ * title bar and the application's own window alike.
+ *
+ * The one-pixel border is the frame's X border, which the server draws on
+ * the straight edges.  Along the curves it has to be drawn: the pixels there
+ * lie inside the frame, under the title bar or the application.  Each corner
+ * gets a small child window of the frame, stacked above both, whose shape is
+ * exactly the pixels of the curve and whose background is a pixmap of them
+ * in the border colour, so that the server paints them by itself.  Its input
+ * shape is empty, so the pointer goes through it to whatever lies
+ * underneath.  Where the colour inside the curve is known -- the title bar's,
+ * for the top corners of a window that has one -- the curve is anti-aliased
+ * against it; elsewhere (the application's corners) it is a crisp one-pixel
+ * line.
+ */
+#define MD_RADIUS        10
+
+/* Pixels cut off at the start of row `j' of a corner of radius `r' (row 0
+ * is the outermost row): those whose centres lie outside the circle of
+ * radius `r' around the corner's centre. */
+static int
+md_inset(int r, int j)
+{
+	double dy, dx;
+	int i;
+
+	if(j < 0) {
+		return r;
+	}
+	if(j >= r) {
+		return 0;
+	}
+	dy = r - (j + 0.5);
+	dx = sqrt((double)r * r - dy * dy);
+	i = (int)ceil(r - dx - 0.5);
+	return i < 0 ? 0 : i;
+}
+
+static int
+md_corner_inset(int j)
+{
+	return md_inset(MD_RADIUS, j);
+}
+
+/* How much of pixel (i, j) of the top-left corner (outer frame coordinates)
+ * the curved border covers, 0..1: a one-pixel stroke whose outside follows
+ * the cut, so every pixel between the stroke and the cut is fully covered. */
+static double
+md_corner_alpha(int i, int j)
+{
+	double dx = MD_RADIUS - (i + 0.5), dy = MD_RADIUS - (j + 0.5);
+	double d, a;
+
+	if(dx <= 0 || dy <= 0 || i < md_corner_inset(j)) {
+		return 0;
+	}
+	d = sqrt(dx * dx + dy * dy);
+	if(d >= MD_RADIUS - 0.5) {
+		return 1;
+	}
+	a = 1 - ((MD_RADIUS - 0.5) - d);
+	return a > 0 ? a : 0;
+}
+
+/* Is pixel (i, j) of the top-left corner on the crisp curve: inside the
+ * shape, with the pixel to its left or the one above it cut off? */
+static bool
+md_corner_edge(int i, int j)
+{
+	int in = md_corner_inset(j);
+
+	return i >= in && i < MD_RADIUS && (i == in || i < md_corner_inset(j - 1));
+}
+
+/* Should the frame be rounded?  Not when it has no border to draw the curve
+ * with (docks, the desktop, NoBorder windows), not while the window is
+ * zoomed in any way, not for shaped or squeezed windows, whose frame shape
+ * ctwm makes itself, and not for ctwm's own windows. */
+static bool
+md_want_round(TwmWindow *t)
+{
+	if(!md_usable() || !HasShape || t->frame == None || t->frame_bw <= 0 ||
+	                t->frame_bw >= MD_RADIUS) {
+		return false;
+	}
+	if(t->wShaped || t->squeeze_info || t->squeezed) {
+		return false;
+	}
+	if(t->isiconmgr || t->iswspmgr || t->isoccupy) {
+		return false;
+	}
+	if(t->zoomed != ZOOM_NONE) {
+		return false;
+	}
+	return t->frame_width >= 2 * MD_RADIUS && t->frame_height >= 2 * MD_RADIUS;
+}
+
+/* Should the frame lose its border?  While the window is maximised: a
+ * maximised window shows no edge, its caption and contents fill the work
+ * area to the screen's edges.
+ * fullzoom() places such a frame with its border just outside the work area,
+ * and the shape takes the border away so that it does not show on a
+ * neighbouring monitor (or over a panel) either. */
+static bool
+md_want_clip(TwmWindow *t)
+{
+	return md_usable() && HasShape && t->frame != None && t->frame_bw > 0 &&
+	       !t->wShaped && !t->squeeze_info && !t->squeezed &&
+	       (t->zoomed == F_FULLZOOM || t->zoomed == F_XFULLZOOM);
+}
+
+/* Where corner `c' (0 top left, 1 top right, 2 bottom left, 3 bottom right)
+ * lies in the frame, and which pixel of the top-left corner its pixel (u, v)
+ * mirrors. */
+static void
+md_corner_place(TwmWindow *t, int c, int *x, int *y)
+{
+	int bw = t->frame_bw;
+
+	*x = (c & 1) ? (int)t->frame_width + bw - MD_RADIUS : 0;
+	*y = (c & 2) ? (int)t->frame_height + bw - MD_RADIUS : 0;
+}
+
+static void
+md_corner_mirror(TwmWindow *t, int c, int u, int v, int *i, int *j)
+{
+	int bw = t->frame_bw;
+
+	*i = (c & 1) ? MD_RADIUS - 1 - u : u + bw;
+	*j = (c & 2) ? MD_RADIUS - 1 - v : v + bw;
+}
+
+/* Paint the curves in the border colour for the window's focus state, and
+ * shape them; anti-aliased against the title bar for the top corners when
+ * there is one.  (The caption buttons are inset from the corner, so the
+ * curve always meets the title bar's own colour.)  Only when a colour
+ * changed, since the focus changes often and the pixels never move within
+ * their windows. */
+static void
+md_corners_paint(TwmWindow *t)
+{
+	bool focus;
+	unsigned long line;
+	unsigned int line_rgb, fill_rgb;
+	int s;
+
+	if(!t->modern_rounded || t->modern_corner[0] == None) {
+		return;
+	}
+	focus = t->hasfocusvisible || !t->highlight;
+	line = focus ? t->borderC.back : t->border_tile.back;
+	/* Inside the top corners: the title bar. */
+	fill_rgb = t->title_w ? (focus ? MD_ACTIVE_BG : MD_INACTIVE_BG) : 0;
+	if(line == t->modern_corner_line && fill_rgb == t->modern_corner_fill) {
+		return;
+	}
+	t->modern_corner_line = line;
+	t->modern_corner_fill = fill_rgb;
+	line_rgb = md_rgb(line);
+
+	s = MD_RADIUS - t->frame_bw;
+	for(int c = 0; c < 4; c++) {
+		bool smooth = t->title_w && !(c & 2);
+		XRectangle rects[MD_RADIUS * MD_RADIUS];
+		int n = 0;
+		XImage *img = md_image(s, s);
+		Pixmap pm;
+
+		if(!img) {
+			continue;
+		}
+		for(int v = 0; v < s; v++) {
+			for(int u = 0; u < s; u++) {
+				int i, j;
+				double a;
+
+				md_corner_mirror(t, c, u, v, &i, &j);
+				if(smooth) {
+					a = md_corner_alpha(i, j);
+				}
+				else {
+					a = md_corner_edge(i, j) ? 1 : 0;
+				}
+				XPutPixel(img, u, v,
+				          md_pixel(md_blend(fill_rgb, line_rgb, a)));
+				if(a > 0.02) {
+					rects[n].x = (short)u;
+					rects[n].y = (short)v;
+					rects[n].width = rects[n].height = 1;
+					n++;
+				}
+			}
+		}
+		pm = XCreatePixmap(dpy, t->modern_corner[c], (unsigned int)s,
+		                   (unsigned int)s, (unsigned int)Scr->d_depth);
+		XPutImage(dpy, pm, Scr->NormalGC, img, 0, 0, 0, 0, (unsigned int)s,
+		          (unsigned int)s);
+		XDestroyImage(img);
+		XSetWindowBackgroundPixmap(dpy, t->modern_corner[c], pm);
+		XFreePixmap(dpy, pm);
+		XShapeCombineRectangles(dpy, t->modern_corner[c], ShapeBounding, 0, 0,
+		                        rects, n, ShapeSet, Unsorted);
+		XClearWindow(dpy, t->modern_corner[c]);
+	}
+}
+
+void
+ModernFrameShape(TwmWindow *tmp_win)
+{
+	TwmWindow *t = tmp_win;
+	XRectangle rects[2 * MD_RADIUS + 1];
+	int n = 0, bw, W, H, s;
+
+	if(!t || t->frame == None) {
+		return;
+	}
+	if(!md_want_round(t)) {
+		bool clip = md_want_clip(t);
+
+		if(t->modern_rounded) {
+			for(int c = 0; c < 4; c++) {
+				if(t->modern_corner[c] != None) {
+					XUnmapWindow(dpy, t->modern_corner[c]);
+				}
+			}
+			t->modern_rounded = false;
+		}
+		if(clip) {
+			/* Maximised: the border is shaped away. */
+			XRectangle r = { 0, 0, (unsigned short)t->frame_width,
+			                 (unsigned short)t->frame_height
+			               };
+
+			XShapeCombineRectangles(dpy, t->frame, ShapeBounding, 0, 0, &r, 1,
+			                        ShapeSet, YXBanded);
+			t->modern_clipped = true;
+		}
+		else if(t->modern_clipped || t->modern_shape_w) {
+			/* Square again: give the frame back its plain shape, unless
+			 * ctwm shapes it itself. */
+			if(!t->wShaped && !t->squeeze_info) {
+				XShapeCombineMask(dpy, t->frame, ShapeBounding, 0, 0, None,
+				                  ShapeSet);
+			}
+			t->modern_clipped = false;
+			t->modern_shape_w = 0;
+		}
+		return;
+	}
+	t->modern_clipped = false;
+	if(t->modern_rounded && t->modern_shape_w == t->frame_width &&
+	                t->modern_shape_h == t->frame_height &&
+	                t->modern_shape_bw == (unsigned int)t->frame_bw) {
+		return;
+	}
+
+	bw = t->frame_bw;
+	W = (int)t->frame_width + 2 * bw;
+	H = (int)t->frame_height + 2 * bw;
+	/* One band per row through the curves, one for the straight middle;
+	 * in outer coordinates, offset by the border when applied. */
+	for(int j = 0; j < MD_RADIUS; j++) {
+		int in = md_corner_inset(j);
+
+		rects[n].x = (short)in;
+		rects[n].y = (short)j;
+		rects[n].width = (unsigned short)(W - 2 * in);
+		rects[n].height = 1;
+		n++;
+	}
+	rects[n].x = 0;
+	rects[n].y = MD_RADIUS;
+	rects[n].width = (unsigned short)W;
+	rects[n].height = (unsigned short)(H - 2 * MD_RADIUS);
+	n++;
+	for(int j = MD_RADIUS - 1; j >= 0; j--) {
+		int in = md_corner_inset(j);
+
+		rects[n].x = (short)in;
+		rects[n].y = (short)(H - 1 - j);
+		rects[n].width = (unsigned short)(W - 2 * in);
+		rects[n].height = 1;
+		n++;
+	}
+	XShapeCombineRectangles(dpy, t->frame, ShapeBounding, -bw, -bw, rects, n,
+	                        ShapeSet, YXBanded);
+
+	/* The curves: created the first time, moved to the new corners, and
+	 * raised over the title bar and the application, which ctwm may have
+	 * restacked or reparented since. */
+	s = MD_RADIUS - bw;
+	if(t->modern_shape_bw != (unsigned int)bw) {
+		for(int c = 0; c < 4; c++) {
+			if(t->modern_corner[c] != None) {
+				XDestroyWindow(dpy, t->modern_corner[c]);
+				t->modern_corner[c] = None;
+			}
+		}
+	}
+	for(int c = 0; c < 4; c++) {
+		int x, y;
+
+		md_corner_place(t, c, &x, &y);
+		if(t->modern_corner[c] == None) {
+			XSetWindowAttributes attr;
+
+			attr.background_pixel = t->borderC.back;
+			t->modern_corner[c] = XCreateWindow(dpy, t->frame, x, y,
+			                                    (unsigned int)s, (unsigned int)s,
+			                                    0, CopyFromParent, InputOutput,
+			                                    CopyFromParent, CWBackPixel,
+			                                    &attr);
+			if(t->modern_corner[c] == None) {
+				continue;
+			}
+			if(Scr->NameDecorations) {
+				XStoreName(dpy, t->modern_corner[c], "CTWM rounded corner");
+			}
+			/* Clicks go through to the window underneath. */
+			XShapeCombineRectangles(dpy, t->modern_corner[c], ShapeInput, 0, 0,
+			                        NULL, 0, ShapeSet, Unsorted);
+			/* Nothing painted yet: the next paint must not be skipped. */
+			t->modern_corner_line = ~0UL;
+		}
+		else {
+			XMoveWindow(dpy, t->modern_corner[c], x, y);
+		}
+		XMapRaised(dpy, t->modern_corner[c]);
+	}
+	t->modern_rounded = true;
+	t->modern_shape_w = t->frame_width;
+	t->modern_shape_h = t->frame_height;
+	t->modern_shape_bw = (unsigned int)bw;
+	md_corners_paint(t);
+}

+/*
+ * _NET_WM_STATE_FOCUSED (ModernTitles): the window that has the focus has it
+ * in its _NET_WM_STATE, and no other window does.
+ *
+ * Without it a GTK application never learns that one of its windows lost the
+ * focus -- GDK then takes every window to be the focused one -- so none is
+ * ever drawn in the theme's "backdrop" state, and an application that draws
+ * its own title bar cannot show it inactive the way ctwm shows its own.
+ */
+void
+EwmhSetFocused(TwmWindow *twm_win, bool focus)
+{
+	if(!twm_win || !Scr->ModernTitles ||
+	                !!(twm_win->ewmhFlags & EWMH_STATE_FOCUSED) == focus) {
+		return;
+	}
+	if(focus) {
+		twm_win->ewmhFlags |= EWMH_STATE_FOCUSED;
+	}
+	else {
+		twm_win->ewmhFlags &= ~EWMH_STATE_FOCUSED;
+	}
+	EwmhSet_NET_WM_STATE(twm_win, EWMH_STATE_FOCUSED);
+}

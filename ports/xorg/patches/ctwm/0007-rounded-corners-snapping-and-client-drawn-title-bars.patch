+/* The _NET_WM_STATE_FOCUSED atom, interned the first time it is needed:
+ * ctwm's own list of atoms is generated at build time, and this one is only
+ * used with ModernTitles. */
+static Atom
+net_wm_state_focused(void)
+{
+	static Atom atom = None;
+
+	if(atom == None) {
+		atom = XInternAtom(dpy, "_NET_WM_STATE_FOCUSED", False);
+	}
+	return atom;
+}
+
+/*
+ * ModernTitles: a move or resize an application asks for starts from where
+ * the button was pressed -- the message's x_root and y_root -- not from where
+ * the pointer is when the message arrives.  An application that draws its own
+ * title bar starts the move only once the pointer has gone past the drag
+ * threshold, as it must for a double click on that title bar to reach it; by
+ * then the pointer is a few pixels on, and the window would trail it by that
+ * much for the whole drag.  A position far from the pointer is stale and
+ * left alone.
+ */
+static void
+moveresize_from_press(XEvent *xevent, TwmWindow *twm_win,
+                      XClientMessageEvent *msg)
+{
+	int px = (int)msg->data.l[0], py = (int)msg->data.l[1];
+	int x, y;
+	Window junk;
+
+	if(!Scr->ModernTitles ||
+	                abs(px - xevent->xbutton.x_root) > 64 ||
+	                abs(py - xevent->xbutton.y_root) > 64) {
+		return;
+	}
+	if(XTranslateCoordinates(dpy, Scr->Root, twm_win->frame, px, py, &x, &y,
+	                         &junk)) {
+		xevent->xbutton.x_root = px;
+		xevent->xbutton.y_root = py;
+		xevent->xbutton.x = x;
+		xevent->xbutton.y = y;
+	}
+}

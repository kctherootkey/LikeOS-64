+/* ------------------------------------------------------------------------ */
+/* Snapping                                                                 */
+/* ------------------------------------------------------------------------ */
+
+typedef enum { MD_SNAP_NONE, MD_SNAP_MAX, MD_SNAP_LEFT, MD_SNAP_RIGHT } ModernSnap;
+
+#define MD_SNAP_EDGE     1    /* pointer this close to a screen edge snaps */
+#define MD_PREVIEW_INSET 8    /* the outline, inside the area it shows */
+#define MD_PREVIEW_RING  2    /* its width */
+#define MD_PREVIEW_RADIUS 12  /* its corners */
+#define MD_PREVIEW_LINE  0x3b74f0  /* the LikeOS highlight blue */
+
+/* The move in progress: its window, that window's geometry before the move
+ * (where a later restore puts it back), the zone the pointer is in and the
+ * area the window would take there, and the outline -- a thin rounded ring in
+ * the highlight colour, a shaped window with a plain background -- with the
+ * area it was last fitted to. */
+static struct {
+	TwmWindow *win;
+	int x, y;
+	unsigned int w, h;
+	ModernSnap zone;
+	RArea area;
+	Window outline, parent;
+	RArea shown;
+} md_move;
+
+bool
+ModernIsSnapped(TwmWindow *tmp_win)
+{
+	return tmp_win && (tmp_win->zoomed == F_LEFTZOOM ||
+	                   tmp_win->zoomed == F_RIGHTZOOM);
+}
+
+/* Is (x, y) on one of the monitors? */
+static bool
+md_on_screen(int x, int y)
+{
+	for(int i = 0; ; i++) {
+		RArea a = RLayoutGetAreaIndex(Scr->Layout, i);
+
+		if(!RAreaIsValid(&a)) {
+			return false;
+		}
+		if(RAreaContainsXY(&a, x, y)) {
+			return true;
+		}
+	}
+}
+
+/* The zone the pointer at (x, y) is in, and the outer frame geometry the
+ * window would take there: the edges are the monitor's own, where no other
+ * monitor continues the screen; the area is that monitor's work area, the
+ * strip the taskbar keeps for itself left out. */
+static ModernSnap
+md_snap_zone(int x, int y, RArea *out)
+{
+	RArea mon, work;
+	ModernSnap zone = MD_SNAP_NONE;
+
+	if(!md_on_screen(x, y)) {
+		return MD_SNAP_NONE;
+	}
+	mon = RLayoutGetAreaAtXY(Scr->Layout, x, y);
+	if(y < mon.y + MD_SNAP_EDGE && !md_on_screen(x, mon.y - 1)) {
+		zone = MD_SNAP_MAX;
+	}
+	else if(x < mon.x + MD_SNAP_EDGE && !md_on_screen(mon.x - 1, y)) {
+		zone = MD_SNAP_LEFT;
+	}
+	else if(x >= mon.x + mon.width - MD_SNAP_EDGE &&
+	                !md_on_screen(mon.x + mon.width, y)) {
+		zone = MD_SNAP_RIGHT;
+	}
+	if(zone == MD_SNAP_NONE) {
+		return zone;
+	}
+	work = RLayoutFull1(Scr->BorderedLayout, &mon);
+	if(!RAreaIsValid(&work)) {
+		work = mon;
+	}
+	switch(zone) {
+		case MD_SNAP_LEFT:
+			work.width = work.width / 2;
+			break;
+		case MD_SNAP_RIGHT:
+			work.x += work.width / 2;
+			work.width -= work.width / 2;
+			break;
+		default:
+			break;
+	}
+	*out = work;
+	return zone;
+}
+
+/* The shape of a rounded ring `ring' pixels wide just inside a w x h box
+ * with corner radius `r', starting `off' pixels in. */
+static void
+md_ring_shape(Window win, int w, int h, int off, int ring, int r)
+{
+	int ow = w - 2 * off, oh = h - 2 * off, ir = r - ring;
+	XRectangle *rects;
+	int n = 0;
+
+	if(ow <= 2 * r || oh <= 2 * r) {
+		return;
+	}
+	rects = calloc((size_t)(2 * oh + 2), sizeof(*rects));
+	if(!rects) {
+		return;
+	}
+	for(int y = 0; y < oh; y++) {
+		int j = y < oh / 2 ? y : oh - 1 - y;
+		int in = md_inset(r, j);
+		int left = off + in, right = off + ow - in;
+
+		/* Rows through the middle are all the same: one band for them. */
+		if(y >= r && y < oh - r) {
+			int x0 = off + ring, x1 = off + ow - ring;
+
+			rects[n++] = (XRectangle) {
+				(short)left, (short)(off + y), (unsigned short)(x0 - left),
+				(unsigned short)(oh - 2 * r)
+			};
+			rects[n++] = (XRectangle) {
+				(short)x1, (short)(off + y), (unsigned short)(right - x1),
+				(unsigned short)(oh - 2 * r)
+			};
+			y = oh - r - 1;
+			continue;
+		}
+		if(j < ring || ir <= 0) {
+			rects[n++] = (XRectangle) {
+				(short)left, (short)(off + y), (unsigned short)(right - left), 1
+			};
+		}
+		else {
+			int iin = md_inset(ir, j - ring);
+			int x0 = off + ring + iin, x1 = off + ow - ring - iin;
+
+			rects[n++] = (XRectangle) {
+				(short)left, (short)(off + y), (unsigned short)(x0 - left), 1
+			};
+			rects[n++] = (XRectangle) {
+				(short)x1, (short)(off + y), (unsigned short)(right - x1), 1
+			};
+		}
+	}
+	XShapeCombineRectangles(dpy, win, ShapeBounding, 0, 0, rects, n, ShapeSet,
+	                        YXBanded);
+	free(rects);
+}
+
+/* Show the outline over `area' (root coordinates), directly beneath the
+ * window being moved; or hide it when the zone is none. */
+static void
+md_preview(TwmWindow *t, ModernSnap zone, const RArea *area)
+{
+	XWindowChanges xwc;
+	int x, y, w, h;
+	Window cr;
+
+	if(zone == MD_SNAP_NONE) {
+		if(md_move.outline != None) {
+			XUnmapWindow(dpy, md_move.outline);
+		}
+		return;
+	}
+	/* The outline lives with the frames, in their parent, so that it can
+	 * be stacked right under the one being moved. */
+	Window parent = t->modern_grip_parent;
+
+	if(parent == None) {
+		Window root, *kids = NULL;
+		unsigned int nkids;
+
+		if(!XQueryTree(dpy, t->frame, &root, &parent, &kids, &nkids)) {
+			return;
+		}
+		if(kids) {
+			XFree(kids);
+		}
+	}
+	if(md_move.outline == None || md_move.parent != parent) {
+		XSetWindowAttributes attr;
+
+		if(md_move.outline != None) {
+			XDestroyWindow(dpy, md_move.outline);
+		}
+		attr.override_redirect = True;
+		attr.background_pixel = md_pixel(MD_PREVIEW_LINE);
+		md_move.outline = XCreateWindow(dpy, parent, 0, 0, 1, 1, 0,
+		                                CopyFromParent, InputOutput,
+		                                CopyFromParent,
+		                                CWOverrideRedirect | CWBackPixel, &attr);
+		/* It never takes the pointer: the drag goes on over it. */
+		XShapeCombineRectangles(dpy, md_move.outline, ShapeInput, 0, 0, NULL, 0,
+		                        ShapeSet, Unsorted);
+		md_move.parent = parent;
+		md_move.shown = RAreaInvalid();
+	}
+	if(md_move.shown.x != area->x || md_move.shown.y != area->y ||
+	                md_move.shown.width != area->width ||
+	                md_move.shown.height != area->height) {
+		/* The area is in root coordinates, the outline in its parent's. */
+		XTranslateCoordinates(dpy, Scr->Root, parent, area->x, area->y, &x, &y,
+		                      &cr);
+		w = area->width;
+		h = area->height;
+		XMoveResizeWindow(dpy, md_move.outline, x, y, (unsigned int)w,
+		                  (unsigned int)h);
+		md_ring_shape(md_move.outline, w, h, MD_PREVIEW_INSET, MD_PREVIEW_RING,
+		              MD_PREVIEW_RADIUS);
+		md_move.shown = *area;
+	}
+	xwc.sibling = t->frame;
+	xwc.stack_mode = Below;
+	XConfigureWindow(dpy, md_move.outline, CWSibling | CWStackMode, &xwc);
+	XMapWindow(dpy, md_move.outline);
+}
+
+void
+ModernMoveBegin(TwmWindow *tmp_win)
+{
+	md_move.win = NULL;
+	md_move.zone = MD_SNAP_NONE;
+	if(!md_usable() || !tmp_win || tmp_win->frame == None) {
+		return;
+	}
+	/* ctwm's own windows, a panel and the desktop are not snapped. */
+	if(tmp_win->isiconmgr || tmp_win->iswspmgr || tmp_win->isoccupy) {
+		return;
+	}
+#ifdef EWMH
+	if(tmp_win->ewmhWindowType == wt_Dock ||
+	                tmp_win->ewmhWindowType == wt_Desktop) {
+		return;
+	}
+#endif
+	md_move.win = tmp_win;
+	md_move.x = tmp_win->frame_x;
+	md_move.y = tmp_win->frame_y;
+	md_move.w = tmp_win->frame_width;
+	md_move.h = tmp_win->frame_height;
+	/* A zoomed window comes back to the geometry saved when it was
+	 * zoomed, so that is the one to keep if it is snapped again. */
+	if(tmp_win->zoomed != ZOOM_NONE && tmp_win->save_frame_width > 0) {
+		md_move.x = tmp_win->save_frame_x;
+		md_move.y = tmp_win->save_frame_y;
+		md_move.w = tmp_win->save_frame_width;
+		md_move.h = tmp_win->save_frame_height;
+	}
+}
+
+bool
+ModernMoveUnzoom(TwmWindow *tmp_win, int x_root, int y_root, int *dx, int *dy)
+{
+	TwmWindow *t = tmp_win;
+	int bw, ow, nx, ny, off, lo, hi;
+
+	if(!md_usable() || !t || t != md_move.win || t->zoomed == ZOOM_NONE ||
+	                t->zoomed == F_FULLSCREENZOOM || t->zoomed == F_XFULLSCREENZOOM ||
+	                t->save_frame_width == 0 || t->save_frame_height == 0) {
+		return false;
+	}
+	bw = t->frame_bw;
+	ow = (int)t->save_frame_width + 2 * bw;
+
+	/* The pointer keeps its place along the caption in proportion, but
+	 * stays on the caption itself: off the window's edge and
+	 * off its caption buttons.  Its height in the caption is kept as it
+	 * was when the button went down; the window follows it from there. */
+	off = (int)((double)(*dx + bw) * ow / (double)(t->frame_width + 2 * bw));
+	lo = bw + MD_LEFT_PAD;
+	hi = ow - bw - MD_RIGHT_PAD - (t->title_w ? Scr->TBInfo.rightoff : 0);
+	if(hi < lo) {
+		off = ow / 2;
+	}
+	else if(off < lo) {
+		off = lo;
+	}
+	else if(off > hi) {
+		off = hi;
+	}
+	nx = x_root - off;
+	ny = y_root - *dy - bw;
+
+	/* Restore to exactly there: fullzoom() puts a window that is zoomed
+	 * the way it is asked to zoom back at its saved geometry. */
+	t->save_frame_x = nx;
+	t->save_frame_y = ny;
+	fullzoom(t, t->zoomed);
+	/* fullzoom() lets go of the server, which the move had grabbed. */
+	if(!Scr->NoGrabServer || !Scr->OpaqueMove) {
+		XGrabServer(dpy);
+	}
+	if(t->zoomed != ZOOM_NONE) {
+		return false;
+	}
+	*dx = off - bw;
+	return true;
+}
+
+void
+ModernMoveMotion(TwmWindow *tmp_win, int x_root, int y_root)
+{
+	RArea area;
+	ModernSnap zone;
+
+	if(!md_move.win || tmp_win != md_move.win) {
+		return;
+	}
+	/* Only what may be maximised snaps; a fixed-size dialog does not. */
+	zone = ModernCanMaximize(tmp_win) ? md_snap_zone(x_root, y_root, &area)
+	       : MD_SNAP_NONE;
+	if(zone != md_move.zone ||
+	                (zone != MD_SNAP_NONE && (area.x != md_move.area.x ||
+	                                          area.y != md_move.area.y ||
+	                                          area.width != md_move.area.width ||
+	                                          area.height != md_move.area.height))) {
+		md_preview(tmp_win, zone, &area);
+		md_move.zone = zone;
+		if(zone != MD_SNAP_NONE) {
+			md_move.area = area;
+		}
+	}
+	else if(zone != MD_SNAP_NONE) {
+		/* The window moved over the outline: keep it beneath. */
+		XWindowChanges xwc;
+
+		xwc.sibling = tmp_win->frame;
+		xwc.stack_mode = Below;
+		if(md_move.outline != None) {
+			XConfigureWindow(dpy, md_move.outline, CWSibling | CWStackMode,
+			                 &xwc);
+		}
+	}
+}
+
+void
+ModernMoveEnd(TwmWindow *tmp_win, bool cancelled)
+{
+	TwmWindow *t = md_move.win;
+	ModernSnap zone = md_move.zone;
+	RArea area = md_move.area;
+	unsigned int w, h;
+	int bw, x, y;
+
+	md_move.win = NULL;
+	md_move.zone = MD_SNAP_NONE;
+	if(md_move.outline != None) {
+		XUnmapWindow(dpy, md_move.outline);
+	}
+	if(!t || t != tmp_win || cancelled || zone == MD_SNAP_NONE ||
+	                t->zoomed != ZOOM_NONE) {
+		return;
+	}
+
+	if(zone == MD_SNAP_MAX) {
+		fullzoom(t, F_FULLZOOM);
+	}
+	else {
+		/* Half the work area, as ctwm's own left and right zooms would
+		 * not do it (they only stretch the window to that edge). */
+		t->zoomed = (zone == MD_SNAP_LEFT) ? F_LEFTZOOM : F_RIGHTZOOM;
+		bw = t->frame_bw;
+		w = (unsigned int)(area.width - 2 * bw);
+		h = (unsigned int)(area.height - 2 * bw);
+		ConstrainSize(t, &w, &h);
+		x = area.x;
+		y = area.y;
+		/* A window that sizes in steps (a terminal) keeps to the screen's
+		 * edge on the right. */
+		if(zone == MD_SNAP_RIGHT) {
+			x = area.x + area.width - (int)w - 2 * bw;
+		}
+		OtpRaise(t, WinWin);
+		SetupWindow(t, x, y, (int)w, (int)h, -1);
+#ifdef EWMH
+		EwmhSet_NET_WM_STATE(t, EWMH_STATE_MAXIMIZED_VERT);
+#endif
+	}
+	if(t->zoomed == ZOOM_NONE) {
+		return;
+	}
+	/* Restoring puts it back where it was before it was dragged here. */
+	t->save_frame_x = md_move.x;
+	t->save_frame_y = md_move.y;
+	t->save_frame_width = md_move.w;
+	t->save_frame_height = md_move.h;
+}

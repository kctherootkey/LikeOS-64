+/* ------------------------------------------------------------------------ */
+/* Title icon                                                               */
+/* ------------------------------------------------------------------------ */
+
+/* The application's icon at 16x16, from _NET_WM_ICON.
+ *
+ * The property holds a list of (width, height, ARGB pixels...) images.  The
+ * smallest that is at least 16 pixels is taken -- downsampling a 256-pixel
+ * icon to 16 turns detail into mud -- and box-filtered down to size, in
+ * premultiplied alpha so that transparent pixels do not darken the edges. */
+static struct modern_icon *
+md_load_icon(TwmWindow *tmp_win)
+{
+	static Atom net_wm_icon = None;
+	Atom type;
+	int fmt;
+	unsigned long n, after;
+	unsigned char *data = NULL;
+	struct modern_icon *ic = NULL;
+
+	if(net_wm_icon == None) {
+		net_wm_icon = XInternAtom(dpy, "_NET_WM_ICON", False);
+	}
+	if(XGetWindowProperty(dpy, tmp_win->w, net_wm_icon, 0, 1 << 20, False,
+	                      XA_CARDINAL, &type, &fmt, &n, &after,
+	                      &data) != Success || !data) {
+		return NULL;
+	}
+	if(type != XA_CARDINAL || fmt != 32) {
+		XFree(data);
+		return NULL;
+	}
+
+	/* Format-32 properties come back as an array of longs. */
+	unsigned long *p = (unsigned long *)data;
+	unsigned long i = 0, best = 0, bw = 0, bh = 0;
+
+	while(i + 2 <= n) {
+		unsigned long iw = p[i], ih = p[i + 1];
+
+		if(iw == 0 || ih == 0 || iw > 4096 || ih > 4096 ||
+		                i + 2 + iw * ih > n) {
+			break;
+		}
+		if((iw >= MD_ICON && (bw < MD_ICON || iw < bw)) ||
+		                (bw < MD_ICON && iw > bw)) {
+			best = i + 2;
+			bw = iw;
+			bh = ih;
+		}
+		i += 2 + iw * ih;
+	}
+
+	if(bw > 0 && (ic = calloc(1, sizeof(*ic)))) {
+		for(int y = 0; y < MD_ICON; y++) {
+			for(int x = 0; x < MD_ICON; x++) {
+				unsigned long x0 = x * bw / MD_ICON, x1 = (x + 1) * bw / MD_ICON;
+				unsigned long y0 = y * bh / MD_ICON, y1 = (y + 1) * bh / MD_ICON;
+				double a = 0, r = 0, g = 0, b = 0;
+				unsigned long cnt = 0;
+
+				if(x1 <= x0) {
+					x1 = x0 + 1;
+				}
+				if(y1 <= y0) {
+					y1 = y0 + 1;
+				}
+				for(unsigned long yy = y0; yy < y1 && yy < bh; yy++) {
+					for(unsigned long xx = x0; xx < x1 && xx < bw; xx++) {
+						unsigned long v = p[best + yy * bw + xx];
+						double al = ((v >> 24) & 0xff) / 255.0;
+
+						a += al;
+						r += ((v >> 16) & 0xff) * al;
+						g += ((v >> 8) & 0xff) * al;
+						b += (v & 0xff) * al;
+						cnt++;
+					}
+				}
+				if(cnt == 0 || a <= 0) {
+					continue;
+				}
+				r /= a;
+				g /= a;
+				b /= a;
+				a /= cnt;
+				ic->px[y * MD_ICON + x] =
+				        ((unsigned int)(a * 255 + 0.5) << 24) |
+				        ((unsigned int)(r + 0.5) << 16) |
+				        ((unsigned int)(g + 0.5) << 8) |
+				        (unsigned int)(b + 0.5);
+			}
+		}
+	}
+	XFree(data);
+	return ic;
+}
+
+void
+ModernIconChanged(TwmWindow *tmp_win)
+{
+	if(!tmp_win) {
+		return;
+	}
+	free(tmp_win->modern_icon);
+	tmp_win->modern_icon = NULL;
+	tmp_win->modern_icon_tried = false;
+	if(md_usable() && tmp_win->title_w) {
+		ModernPaintTitle(tmp_win);
+	}
+}
+
+static void md_grip_destroy(TwmWindow *tmp_win);
+
+void
+ModernForgetWindow(TwmWindow *tmp_win)
+{
+	if(!tmp_win) {
+		return;
+	}
+	free(tmp_win->modern_icon);
+	tmp_win->modern_icon = NULL;
+	tmp_win->modern_icon_tried = false;
+	md_grip_destroy(tmp_win);
+}

+/* Caption glyphs                                                           */
+/* ------------------------------------------------------------------------ */
+
+/* Distance from (px, py) to the segment (ax, ay)-(bx, by). */
+static double
+seg_dist(double px, double py, double ax, double ay, double bx, double by)
+{
+	double dx = bx - ax, dy = by - ay;
+	double t = ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy);
+
+	if(t < 0) {
+		t = 0;
+	}
+	if(t > 1) {
+		t = 1;
+	}
+	dx = px - (ax + t * dx);
+	dy = py - (ay + t * dy);
+	return sqrt(dx * dx + dy * dy);
+}
+
+/* Signed distance from (px, py) to the edge of the rectangle centred on
+ * (cx, cy) with half-sizes `hx' and `hy' and corner radius `r': negative
+ * inside, positive outside. */
+static double
+rrect_dist(double px, double py, double cx, double cy, double hx, double hy,
+           double r)
+{
+	double qx = fabs(px - cx) - (hx - r), qy = fabs(py - cy) - (hy - r);
+	double ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+	double in = (qx > qy ? qx : qy);
+
+	return sqrt(ox * ox + oy * oy) + (in < 0 ? in : 0) - r;
+}
+
+/*
+ * Is glyph-space point (x, y) on the stroke of the glyph?
+ *
+ * The glyph box is MD_GLYPH square, pixel (i, j) covering [i, i+1) x
+ * [j, j+1).  Every stroke is MD_STROKE wide with round ends: the points
+ * within half of that of a centre line.  Horizontal and vertical centre lines
+ * run along pixel centres, so that each covers one pixel row or column fully
+ * and only a faint fringe either side.
+ *
+ *   minimise  one line across the middle;
+ *   maximise  a square outline with well-rounded corners, filling the box;
+ *   restore   two smaller rounded squares, the back one two pixels up and
+ *             to the right, cut away for a pixel's gap around the front one,
+ *             so that only its top and right sides show;
+ *   close     the two diagonals.
+ */
+static bool
+glyph_hit(ModernKind kind, bool restore, double x, double y)
+{
+	const double sw = MD_STROKE / 2;
+
+	switch(kind) {
+		case MD_MINIMIZE:
+			return seg_dist(x, y, 1.0, 5.5, 9.0, 5.5) <= sw;
+
+		case MD_CLOSE:
+			return seg_dist(x, y, 1.0, 1.0, 9.0, 9.0) <= sw ||
+			       seg_dist(x, y, 1.0, 9.0, 9.0, 1.0) <= sw;
+
+		case MD_MAXIMIZE:
+			if(!restore) {
+				return fabs(rrect_dist(x, y, 5.0, 5.0, 4.5, 4.5, 2.5)) <= sw;
+			}
+			/* Front square: 0.5..7.5 across, 2.5..9.5 down. */
+			if(fabs(rrect_dist(x, y, 4.0, 6.0, 3.5, 3.5, 2.0)) <= sw) {
+				return true;
+			}
+			/* Back square: 2.5..9.5 across, 0.5..7.5 down, where it
+			 * keeps clear of the front one. */
+			return fabs(rrect_dist(x, y, 6.0, 4.0, 3.5, 3.5, 2.0)) <= sw &&
+			       rrect_dist(x, y, 4.0, 6.0, 3.5, 3.5, 2.0) > sw + 1.0;
+
+		default:
+			return false;
+	}
+}
+
+/* Coverage of pixel (i, j) of the glyph box, 0..1, by 8x8 supersampling.
+ * (i, j) may lie a pixel outside the box, for the fringe of a stroke laid
+ * along its edge. */
+static double
+glyph_cover(ModernKind kind, bool restore, int i, int j)
+{
+	int n = 0;
+
+	for(int sy = 0; sy < 8; sy++) {
+		for(int sx = 0; sx < 8; sx++) {
+			if(glyph_hit(kind, restore, i + (sx + 0.5) / 8.0,
+			                j + (sy + 0.5) / 8.0)) {
+				n++;
+			}
+		}
+	}
+	return n / 64.0;
+}
+
+/* Coverage of pixel (x, y) by the w x h rounded rectangle at the origin
+ * with corner radius `r', by 4x4 supersampling. */
+static double
+rrect_cover(int x, int y, int w, int h, double r)
+{
+	int n = 0;
+
+	for(int sy = 0; sy < 4; sy++) {
+		for(int sx = 0; sx < 4; sx++) {
+			if(rrect_dist(x + (sx + 0.5) / 4.0, y + (sy + 0.5) / 4.0,
+			              w / 2.0, h / 2.0, w / 2.0, h / 2.0, r) <= 0) {
+				n++;
+			}
+		}
+	}
+	return n / 16.0;
+}
+
+static ModernKind
+md_kind(TitleButton *tb)
+{
+	TitleButtonFunc *tbf;
+
+	if(!tb) {
+		return MD_NONE;
+	}
+	for(tbf = tb->funs; tbf; tbf = tbf->next) {
+		switch(tbf->func) {
+			case F_ICONIFY:
+				return MD_MINIMIZE;
+			case F_ZOOM: case F_HORIZOOM: case F_FULLZOOM:
+			case F_FULLSCREENZOOM: case F_LEFTZOOM: case F_RIGHTZOOM:
+			case F_TOPZOOM: case F_BOTTOMZOOM: case F_XZOOM:
+			case F_XHORIZOOM: case F_XFULLZOOM: case F_XFULLSCREENZOOM:
+			case F_XLEFTZOOM: case F_XRIGHTZOOM: case F_XTOPZOOM:
+			case F_XBOTTOMZOOM:
+				return MD_MAXIMIZE;
+			case F_DELETE: case F_DESTROY: case F_DELETEORDESTROY:
+				return MD_CLOSE;
+			default:
+				break;
+		}
+	}
+	return MD_NONE;
+}
+
+bool
+ModernPaintTitleButton(TwmWindow *tmp_win, TBWindow *tbw)
+{
+	ModernKind kind;
+	bool focus, restore, lit;
+	unsigned int bg, fill, fg;
+	int w, h, bh, by, gx, gy;
+	XImage *img;
+
+	if(!md_usable() || !tbw || !tbw->window) {
+		return false;
+	}
+	kind = md_kind(tbw->info);
+	if(kind == MD_NONE) {
+		return false;
+	}
+
+	focus = tmp_win->hasfocusvisible;
+	restore = (tmp_win->zoomed != ZOOM_NONE);
+	bg = focus ? MD_ACTIVE_BG : MD_INACTIVE_BG;
+	fg = focus ? MD_ACTIVE_FG : MD_INACTIVE_FG;
+	/* At rest the button is the title bar's own colour; under the pointer
+	 * its rounded rectangle is filled. */
+	lit = tbw->hover;
+	fill = bg;
+	if(lit) {
+		if(kind == MD_CLOSE) {
+			fill = MD_CLOSE_BG;
+			fg = MD_CLOSE_FG;
+		}
+		else {
+			fill = md_blend(bg, MD_HOVER_TINT, MD_HOVER_ALPHA);
+			fg = MD_ACTIVE_FG;
+		}
+	}
+
+	/* The button window is the full height of the title bar, so that the
+	 * whole of it takes the click; the rectangle is drawn inset in it. */
+	w = Scr->TBInfo.width;
+	h = Scr->TitleHeight;
+	bh = (h - 4 < MD_BUTTON_H) ? h - 4 : MD_BUTTON_H;
+	by = (h - bh) / 2;
+	img = md_image(w, h);
+	if(!img) {
+		return false;
+	}
+
+	gx = (w - MD_GLYPH) / 2;
+	gy = (h - MD_GLYPH) / 2;
+	for(int y = 0; y < h; y++) {
+		for(int x = 0; x < w; x++) {
+			unsigned int c = bg;
+			double a;
+
+			if(lit && y >= by && y < by + bh) {
+				c = md_blend(bg, fill, rrect_cover(x, y - by, w, bh,
+				                                   MD_BUTTON_RADIUS));
+			}
+			if(x >= gx - 1 && x <= gx + MD_GLYPH &&
+			                y >= gy - 1 && y <= gy + MD_GLYPH) {
+				a = glyph_cover(kind, restore, x - gx, y - gy);
+				c = md_blend(c, fg, a);
+			}
+			XPutPixel(img, x, y, md_pixel(c));
+		}
+	}
+
+	XPutImage(dpy, tbw->window, Scr->NormalGC, img, 0, 0, 0, 0, w, h);
+	XDestroyImage(img);
+	return true;
+}
+
+bool
+ModernButtonCrossing(TwmWindow *tmp_win, Window w, bool entered)
+{
+	TBWindow *tbw;
+	int nb;
+
+	if(!md_usable() || !tmp_win || !tmp_win->titlebuttons) {
+		return false;
+	}
+	nb = Scr->TBInfo.nleft + Scr->TBInfo.nright;
+	tbw = tmp_win->titlebuttons;
+	for(int i = 0; i < nb; i++, tbw++) {
+		if(tbw->window == w) {
+			tbw->hover = entered;
+			if(!ModernPaintTitleButton(tmp_win, tbw)) {
+				PaintTitleButton(tmp_win, tbw);
+			}
+			return true;
+		}
+	}
+	return false;
+}

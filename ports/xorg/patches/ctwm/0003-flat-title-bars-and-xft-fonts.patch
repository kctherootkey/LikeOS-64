+#define XmbDrawString(d, w, fs, gc, x, y, t, n) \
+	ctwm_XmbDrawString(d, w, fs, gc, x, y, t, n)
+#endif
+
+/*
+ * Window operations, routed through win_modern.c so that a frame's resize
+ * border (ModernTitles; see win_modern.h) follows the frame wherever ctwm
+ * moves, sizes, stacks, shows, hides or reparents it.  For every window that
+ * is not such a frame -- and for all of them while ModernTitles is off --
+ * the wrappers are the plain Xlib calls.  win_modern.c, which implements
+ * them, opts out.
+ */
+int ctwm_XMapWindow(Display *d, Window w);
+int ctwm_XMapRaised(Display *d, Window w);
+int ctwm_XUnmapWindow(Display *d, Window w);
+int ctwm_XMoveWindow(Display *d, Window w, int x, int y);
+int ctwm_XResizeWindow(Display *d, Window w, unsigned int width,
+                       unsigned int height);
+int ctwm_XMoveResizeWindow(Display *d, Window w, int x, int y,
+                           unsigned int width, unsigned int height);
+int ctwm_XConfigureWindow(Display *d, Window w, unsigned int mask,
+                          XWindowChanges *xwc);
+int ctwm_XSetWindowBorderWidth(Display *d, Window w, unsigned int width);
+int ctwm_XRaiseWindow(Display *d, Window w);
+int ctwm_XLowerWindow(Display *d, Window w);
+int ctwm_XRestackWindows(Display *d, Window *ws, int n);
+int ctwm_XReparentWindow(Display *d, Window w, Window parent, int x, int y);
+#ifndef CTWM_NO_FRAME_REDIRECT
+#define XMapWindow(d, w)                ctwm_XMapWindow(d, w)
+#define XMapRaised(d, w)                ctwm_XMapRaised(d, w)
+#define XUnmapWindow(d, w)              ctwm_XUnmapWindow(d, w)
+#define XMoveWindow(d, w, x, y)         ctwm_XMoveWindow(d, w, x, y)
+#define XResizeWindow(d, w, wd, ht)     ctwm_XResizeWindow(d, w, wd, ht)
+#define XMoveResizeWindow(d, w, x, y, wd, ht) \
+	ctwm_XMoveResizeWindow(d, w, x, y, wd, ht)
+#define XConfigureWindow(d, w, m, c)    ctwm_XConfigureWindow(d, w, m, c)
+#define XSetWindowBorderWidth(d, w, b)  ctwm_XSetWindowBorderWidth(d, w, b)
+#define XRaiseWindow(d, w)              ctwm_XRaiseWindow(d, w)
+#define XLowerWindow(d, w)              ctwm_XLowerWindow(d, w)
+#define XRestackWindows(d, ws, n)       ctwm_XRestackWindows(d, ws, n)
+#define XReparentWindow(d, w, p, x, y)  ctwm_XReparentWindow(d, w, p, x, y)
+#endif

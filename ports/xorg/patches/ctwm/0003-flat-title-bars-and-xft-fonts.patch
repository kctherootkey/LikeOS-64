+/* ------------------------------------------------------------------------ */
+/* Title bar                                                                */
+/* ------------------------------------------------------------------------ */
+
+/* Shorten `s' (UTF-8) so that it and an ellipsis fit in `avail' pixels. */
+static char *
+md_fit(XftFont *font, const char *s, int avail)
+{
+	XGlyphInfo gi;
+	size_t len = strlen(s);
+	char *out;
+
+	XftTextExtentsUtf8(dpy, font, (const FcChar8 *)s, (int)len, &gi);
+	if(gi.xOff <= avail) {
+		return strdup(s);
+	}
+	out = malloc(len + 4);
+	if(!out) {
+		return NULL;
+	}
+	while(len > 0) {
+		/* step back one whole UTF-8 character */
+		do {
+			len--;
+		}
+		while(len > 0 && ((unsigned char)s[len] & 0xc0) == 0x80);
+		memcpy(out, s, len);
+		memcpy(out + len, "\xe2\x80\xa6", 4);
+		XftTextExtentsUtf8(dpy, font, (const FcChar8 *)out, (int)len + 3, &gi);
+		if(gi.xOff <= avail) {
+			return out;
+		}
+	}
+	free(out);
+	return NULL;
+}
+
+void
+ModernPaintTitle(TwmWindow *tmp_win)
+{
+	bool focus;
+	unsigned int bg, fg;
+	int x, h, avail;
+	MyFont *font = &Scr->TitleBarFont;
+
+	if(!tmp_win->title_w) {
+		return;
+	}
+	focus = tmp_win->hasfocusvisible;
+	bg = focus ? MD_ACTIVE_BG : MD_INACTIVE_BG;
+	fg = focus ? MD_ACTIVE_FG : MD_INACTIVE_FG;
+	h = Scr->TitleHeight;
+
+	XSetForeground(dpy, Scr->NormalGC, md_pixel(bg));
+	XFillRectangle(dpy, tmp_win->title_w, Scr->NormalGC, 0, 0,
+	               tmp_win->title_width, h);
+
+	/*
+	 * The title window has a border as wide as the frame's, and the frame
+	 * clips all of it except the bottom edge -- which would draw a line in
+	 * the border colour between the title and the window contents.  The
+	 * caption runs straight into the contents instead, so that edge takes
+	 * the title's own colour.  (The
+	 * focus code sets the border colour on every change; this runs after
+	 * it.)
+	 */
+	if(tmp_win->frame_bw > 0) {
+		XSetWindowBorder(dpy, tmp_win->title_w, md_pixel(bg));
+	}
+
+	/* MD_LEFT_PAD from the left edge, or from the last left-side button:
+	 * titlex is FramePadding further in than where those end. */
+	x = MD_LEFT_PAD + Scr->TBInfo.titlex - Scr->FramePadding;
+
+	if(!tmp_win->modern_icon_tried) {
+		tmp_win->modern_icon = md_load_icon(tmp_win);
+		tmp_win->modern_icon_tried = true;
+	}
+	if(tmp_win->modern_icon && h >= MD_ICON) {
+		XImage *img = md_image(MD_ICON, MD_ICON);
+
+		if(img) {
+			for(int y = 0; y < MD_ICON; y++) {
+				for(int xx = 0; xx < MD_ICON; xx++) {
+					unsigned int v = tmp_win->modern_icon->px[y * MD_ICON + xx];
+					double a = ((v >> 24) & 0xff) / 255.0;
+
+					XPutPixel(img, xx, y,
+					          md_pixel(md_blend(bg, v & 0xffffff, a)));
+				}
+			}
+			XPutImage(dpy, tmp_win->title_w, Scr->NormalGC, img, 0, 0,
+			          x, (h - MD_ICON) / 2, MD_ICON, MD_ICON);
+			XDestroyImage(img);
+		}
+		x += MD_ICON_ADVANCE;
+	}
+
+	if(!tmp_win->name || !*tmp_win->name) {
+		return;
+	}
+	avail = (int)tmp_win->title_width - Scr->TBInfo.rightoff - MD_RIGHT_PAD - x;
+	if(avail <= 0) {
+		return;
+	}
+
+	if(font->xft) {
+		XftDraw *d = XftDrawCreate(dpy, tmp_win->title_w, Scr->d_visual,
+		                           DefaultColormap(dpy, Scr->screen));
+		XRenderColor rc = {
+			.red = ((fg >> 16) & 0xff) * 257,
+			.green = ((fg >> 8) & 0xff) * 257,
+			.blue = (fg & 0xff) * 257,
+			.alpha = 0xffff,
+		};
+		XftColor col;
+		char *text = md_fit(font->xft, tmp_win->name, avail);
+
+		if(d && text && XftColorAllocValue(dpy, Scr->d_visual,
+		                                   DefaultColormap(dpy, Scr->screen),
+		                                   &rc, &col)) {
+			int base = (h - (font->xft->ascent + font->xft->descent)) / 2 +
+			           font->xft->ascent;
+
+			XftDrawStringUtf8(d, &col, font->xft, x, base,
+			                  (const FcChar8 *)text, (int)strlen(text));
+			XftColorFree(dpy, Scr->d_visual,
+			             DefaultColormap(dpy, Scr->screen), &col);
+		}
+		free(text);
+		if(d) {
+			XftDrawDestroy(d);
+		}
+	}
+	else {
+		XRectangle ink, logical;
+		int len = (int)strlen(tmp_win->name);
+
+		XSetForeground(dpy, Scr->NormalGC, md_pixel(fg));
+		XmbTextExtents(font->font_set, tmp_win->name, len, &ink, &logical);
+		while(len > 0 && logical.width > avail) {
+			len--;
+			XmbTextExtents(font->font_set, tmp_win->name, len, &ink, &logical);
+		}
+		XmbDrawString(dpy, tmp_win->title_w, font->font_set, Scr->NormalGC, x,
+		              (h - logical.height) / 2 - logical.y, tmp_win->name, len);
+	}
+}
+
+void
+ModernFocusChanged(TwmWindow *tmp_win, bool focus)
+{
+	(void)focus;
+	if(!md_usable() || !tmp_win || !tmp_win->title_w) {
+		return;
+	}
+	ModernPaintTitle(tmp_win);
+	/* AddWindow sets the focus look before the buttons exist. */
+	if(tmp_win->titlebuttons) {
+		PaintTitleButtons(tmp_win);
+	}
+}
+
+/* ------------------------------------------------------------------------ */
+/* The resize border                                                        */
+/* ------------------------------------------------------------------------ */
+
+#define MD_GRIP          6    /* the band outside the frame, pixels */
+#define MD_GRIP_CORNER   16   /* along an edge from a corner: the corner */
+
+/* Borders in existence; the frame-call wrappers do nothing extra while it
+ * is 0, which it is whenever ModernTitles is off. */
+static int md_grips;
+
+/* Does the window get a border at all?  Not without a frame edge (docks,
+ * the desktop, NoBorder windows), and not for a window whose size is fixed
+ * -- there is nothing to resize. */
+static bool
+md_resizable(TwmWindow *t)
+{
+	const XSizeHints *h = &t->hints;
+
+	if((h->flags & PMinSize) && (h->flags & PMaxSize) &&
+	                h->min_width == h->max_width &&
+	                h->min_height == h->max_height) {
+		return false;
+	}
+	return true;
+}
+
+/* Show the border while the frame is shown, the window is not maximised
+ * (a maximised window fills the screen, it has no edges to drag) and its
+ * size is not fixed; bring it to the frame's geometry and, when the frame was
+ * restacked, put it back directly beneath the frame. */
+static void
+md_grip_sync(TwmWindow *t, bool restack)
+{
+	bool want;
+
+	int gx, gy;
+	unsigned int gw, gh;
+
+	if(t->modern_grip == None) {
+		return;
+	}
+	/* Only when it changed: this runs for every move step and every
+	 * restack, and a configure request is never free. */
+	gx = t->modern_fx - MD_GRIP;
+	gy = t->modern_fy - MD_GRIP;
+	gw = t->modern_fw + 2 * t->modern_fbw + 2 * MD_GRIP;
+	gh = t->modern_fh + 2 * t->modern_fbw + 2 * MD_GRIP;
+	if(gx != t->modern_gx || gy != t->modern_gy || gw != t->modern_gw ||
+	                gh != t->modern_gh) {
+		XMoveResizeWindow(dpy, t->modern_grip, gx, gy, gw, gh);
+		t->modern_gx = gx;
+		t->modern_gy = gy;
+		t->modern_gw = gw;
+		t->modern_gh = gh;
+	}
+	if(restack) {
+		XWindowChanges xwc;
+
+		xwc.sibling = t->frame;
+		xwc.stack_mode = Below;
+		XConfigureWindow(dpy, t->modern_grip, CWSibling | CWStackMode, &xwc);
+	}
+	want = t->modern_frame_mapped && t->zoomed == ZOOM_NONE &&
+	       md_resizable(t);
+	if(want && !t->modern_grip_mapped) {
+		if(!restack) {
+			XWindowChanges xwc;
+
+			xwc.sibling = t->frame;
+			xwc.stack_mode = Below;
+			XConfigureWindow(dpy, t->modern_grip, CWSibling | CWStackMode,
+			                 &xwc);
+		}
+		XMapWindow(dpy, t->modern_grip);
+		t->modern_grip_mapped = true;
+	}
+	else if(!want && t->modern_grip_mapped) {
+		XUnmapWindow(dpy, t->modern_grip);
+		t->modern_grip_mapped = false;
+	}
+}
+
+void
+ModernGripCreate(TwmWindow *tmp_win)
+{
+	XSetWindowAttributes attr;
+	XWindowAttributes wa;
+	Window root, parent, *kids = NULL;
+	unsigned int nkids;
+
+	if(!md_usable() || !tmp_win || tmp_win->frame == None ||
+	                tmp_win->frame_bw <= 0 || tmp_win->modern_grip != None) {
+		return;
+	}
+	/* ctwm's own windows (icon and workspace managers, the occupy
+	 * dialog) are not resized by hand. */
+	if(tmp_win->isiconmgr || tmp_win->iswspmgr || tmp_win->isoccupy) {
+		return;
+	}
+	/* Where the frame really is: the placement code may have moved it
+	 * since it was created. */
+	if(!XGetWindowAttributes(dpy, tmp_win->frame, &wa) ||
+	                !XQueryTree(dpy, tmp_win->frame, &root, &parent, &kids,
+	                            &nkids)) {
+		return;
+	}
+	if(kids) {
+		XFree(kids);
+	}
+	tmp_win->modern_grip_parent = parent;
+	tmp_win->modern_gx = wa.x - MD_GRIP;
+	tmp_win->modern_gy = wa.y - MD_GRIP;
+	tmp_win->modern_gw = (unsigned int)wa.width + 2 * (unsigned int)wa.border_width + 2 * MD_GRIP;
+	tmp_win->modern_gh = (unsigned int)wa.height + 2 * (unsigned int)wa.border_width + 2 * MD_GRIP;
+	tmp_win->modern_fx = wa.x;
+	tmp_win->modern_fy = wa.y;
+	tmp_win->modern_fw = (unsigned int)wa.width;
+	tmp_win->modern_fh = (unsigned int)wa.height;
+	tmp_win->modern_fbw = (unsigned int)wa.border_width;
+	tmp_win->modern_frame_mapped = (wa.map_state != IsUnmapped);
+	tmp_win->modern_grip_edges = -1;
+
+	/* Override-redirect: it is ctwm's own furniture, not a window for
+	 * anyone to manage or list. */
+	attr.override_redirect = True;
+	attr.event_mask = ButtonPressMask | ButtonReleaseMask | PointerMotionMask;
+	attr.cursor = Scr->FrameCursor;
+	tmp_win->modern_grip = XCreateWindow(dpy, parent,
+	                                     wa.x - MD_GRIP, wa.y - MD_GRIP,
+	                                     (unsigned int)wa.width + 2 * (unsigned int)wa.border_width + 2 * MD_GRIP,
+	                                     (unsigned int)wa.height + 2 * (unsigned int)wa.border_width + 2 * MD_GRIP,
+	                                     0, 0, InputOnly, CopyFromParent,
+	                                     CWOverrideRedirect | CWEventMask | CWCursor,
+	                                     &attr);
+	if(tmp_win->modern_grip == None) {
+		return;
+	}
+	if(Scr->NameDecorations) {
+		XStoreName(dpy, tmp_win->modern_grip, "CTWM resize border");
+	}
+	XSaveContext(dpy, tmp_win->modern_grip, TwmContext, (XPointer) tmp_win);
+	XSaveContext(dpy, tmp_win->modern_grip, ScreenContext, (XPointer) Scr);
+	md_grips++;
+	md_grip_sync(tmp_win, true);
+}
+
+static void
+md_grip_destroy(TwmWindow *tmp_win)
+{
+	if(tmp_win->modern_grip == None) {
+		return;
+	}
+	XDeleteContext(dpy, tmp_win->modern_grip, TwmContext);
+	XDeleteContext(dpy, tmp_win->modern_grip, ScreenContext);
+	XDestroyWindow(dpy, tmp_win->modern_grip);
+	tmp_win->modern_grip = None;
+	tmp_win->modern_grip_mapped = false;
+	md_grips--;
+}
+
+/* The edges at (x, y), frame coordinates (the frame's outer top-left corner
+ * is 0,0, so the band around it is negative or beyond its size): the frame's
+ * own one-pixel edge counts, the band outside it, and near a corner the
+ * corner -- MD_GRIP_CORNER pixels along either edge, a target easier to hit
+ * than the corner pixel itself. */
+static int
+md_edges_at(TwmWindow *t, int x, int y)
+{
+	int w = (int)(t->modern_fw + 2 * t->modern_fbw);
+	int h = (int)(t->modern_fh + 2 * t->modern_fbw);
+	int bw = (int)t->modern_fbw;
+	int e = 0;
+
+	if(x < bw) {
+		e |= MODERN_EDGE_LEFT;
+	}
+	else if(x >= w - bw) {
+		e |= MODERN_EDGE_RIGHT;
+	}
+	if(y < bw) {
+		e |= MODERN_EDGE_TOP;
+	}
+	else if(y >= h - bw) {
+		e |= MODERN_EDGE_BOTTOM;
+	}
+	if(e & (MODERN_EDGE_TOP | MODERN_EDGE_BOTTOM)) {
+		if(x < MD_GRIP_CORNER) {
+			e |= MODERN_EDGE_LEFT;
+		}
+		else if(x >= w - MD_GRIP_CORNER) {
+			e |= MODERN_EDGE_RIGHT;
+		}
+	}
+	if(e & (MODERN_EDGE_LEFT | MODERN_EDGE_RIGHT)) {
+		if(y < MD_GRIP_CORNER) {
+			e |= MODERN_EDGE_TOP;
+		}
+		else if(y >= h - MD_GRIP_CORNER) {
+			e |= MODERN_EDGE_BOTTOM;
+		}
+	}
+	return e;
+}
+
+Cursor
+ModernEdgeCursor(int edges)
+{
+	switch(edges) {
+		case MODERN_EDGE_TOP | MODERN_EDGE_LEFT:
+			return TopLeftCursor;
+		case MODERN_EDGE_TOP | MODERN_EDGE_RIGHT:
+			return TopRightCursor;
+		case MODERN_EDGE_BOTTOM | MODERN_EDGE_LEFT:
+			return BottomLeftCursor;
+		case MODERN_EDGE_BOTTOM | MODERN_EDGE_RIGHT:
+			return BottomRightCursor;
+		case MODERN_EDGE_TOP:
+			return TopCursor;
+		case MODERN_EDGE_BOTTOM:
+			return BottomCursor;
+		case MODERN_EDGE_LEFT:
+			return LeftCursor;
+		case MODERN_EDGE_RIGHT:
+			return RightCursor;
+		default:
+			return Scr->FrameCursor;
+	}
+}
+
+void
+ModernGripMotion(TwmWindow *tmp_win, int x, int y)
+{
+	int e;
+
+	if(!tmp_win || tmp_win->modern_grip == None) {
+		return;
+	}
+	e = md_edges_at(tmp_win, x - MD_GRIP, y - MD_GRIP);
+	if(e != tmp_win->modern_grip_edges) {
+		XDefineCursor(dpy, tmp_win->modern_grip, ModernEdgeCursor(e));
+		tmp_win->modern_grip_edges = e;
+	}
+}
+
+int
+ModernResizeEdges(TwmWindow *tmp_win, XEvent *evp, int fx, int fy, int fw,
+                  int fh)
+{
+	int bw;
+
+	if(!md_usable() || !tmp_win || evp->type != ButtonPress) {
+		return 0;
+	}
+	if(evp->xbutton.window != tmp_win->frame &&
+	                (tmp_win->modern_grip == None ||
+	                 evp->xbutton.window != tmp_win->modern_grip)) {
+		return 0;
+	}
+	/* fx..fh are the inner geometry; the edges are measured from the
+	 * outer corner, where the frame's border begins. */
+	bw = tmp_win->frame_bw;
+	(void)fw;
+	(void)fh;
+	return md_edges_at(tmp_win, evp->xbutton.x_root - (fx - bw),
+	                   evp->xbutton.y_root - (fy - bw));
+}
+
+/* ---- The frame-call wrappers (see ctwm.h) -------------------------------- */
+
+/*
+ * Before the frame itself is restacked, its border goes to the bottom of the
+ * stack, out of everything's way; md_grip_sync() puts it back under the frame
+ * afterwards.
+ *
+ * Without this the restack passes through a state where the border is ABOVE
+ * its own frame: ctwm raises a window by placing it directly above the next
+ * frame down ("Above sibling"), which lands it underneath its border still
+ * sitting there.  For the moment between that request and the border's own
+ * restack the pointer is over the border, not the application -- and the
+ * application is told it left its window and came back.  ctwm raises on every
+ * click, the wheel included, and GDK takes each such re-entry as a new
+ * scrolling gesture and drops the scroll position it measures smooth scrolling
+ * from: the wheel did nothing in most GTK programs.
+ */
+static void
+md_grip_out_of_the_way(Display *d, TwmWindow *t)
+{
+	if(t->modern_grip_mapped) {
+		XLowerWindow(d, t->modern_grip);
+	}
+}
+
+/* The window `w' is a frame that has a border: its TwmWindow, else NULL. */
+static TwmWindow *
+md_frame_owner(Display *d, Window w)
+{
+	TwmWindow *t;
+
+	if(md_grips == 0 ||
+	                XFindContext(d, w, TwmContext, (XPointer *)&t) != XCSUCCESS) {
+		return NULL;
+	}
+	return (t && t->frame == w && t->modern_grip != None) ? t : NULL;
+}
+
+int
+ctwm_XMapWindow(Display *d, Window w)
+{
+	int r = XMapWindow(d, w);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		t->modern_frame_mapped = true;
+		md_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XMapRaised(Display *d, Window w)
+{
+	int r = XMapRaised(d, w);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		t->modern_frame_mapped = true;
+		md_grip_sync(t, true);
+	}
+	return r;
+}
+
+int
+ctwm_XUnmapWindow(Display *d, Window w)
+{
+	int r = XUnmapWindow(d, w);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		t->modern_frame_mapped = false;
+		md_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XMoveWindow(Display *d, Window w, int x, int y)
+{
+	int r = XMoveWindow(d, w, x, y);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		t->modern_fx = x;
+		t->modern_fy = y;
+		md_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XResizeWindow(Display *d, Window w, unsigned int width,
+                   unsigned int height)
+{
+	int r = XResizeWindow(d, w, width, height);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		t->modern_fw = width;
+		t->modern_fh = height;
+		md_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XMoveResizeWindow(Display *d, Window w, int x, int y,
+                       unsigned int width, unsigned int height)
+{
+	int r = XMoveResizeWindow(d, w, x, y, width, height);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		t->modern_fx = x;
+		t->modern_fy = y;
+		t->modern_fw = width;
+		t->modern_fh = height;
+		md_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XConfigureWindow(Display *d, Window w, unsigned int mask,
+                      XWindowChanges *xwc)
+{
+	TwmWindow *t = md_frame_owner(d, w);
+	int r;
+
+	if(t && (mask & CWStackMode)) {
+		md_grip_out_of_the_way(d, t);
+	}
+	r = XConfigureWindow(d, w, mask, xwc);
+
+	if(t) {
+		if(mask & CWX) {
+			t->modern_fx = xwc->x;
+		}
+		if(mask & CWY) {
+			t->modern_fy = xwc->y;
+		}
+		if(mask & CWWidth) {
+			t->modern_fw = (unsigned int)xwc->width;
+		}
+		if(mask & CWHeight) {
+			t->modern_fh = (unsigned int)xwc->height;
+		}
+		if(mask & CWBorderWidth) {
+			t->modern_fbw = (unsigned int)xwc->border_width;
+		}
+		md_grip_sync(t, (mask & CWStackMode) != 0);
+	}
+	return r;
+}
+
+int
+ctwm_XSetWindowBorderWidth(Display *d, Window w, unsigned int width)
+{
+	int r = XSetWindowBorderWidth(d, w, width);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		t->modern_fbw = width;
+		md_grip_sync(t, false);
+	}
+	return r;
+}
+
+int
+ctwm_XRaiseWindow(Display *d, Window w)
+{
+	int r = XRaiseWindow(d, w);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		md_grip_sync(t, true);
+	}
+	return r;
+}
+
+int
+ctwm_XLowerWindow(Display *d, Window w)
+{
+	TwmWindow *t = md_frame_owner(d, w);
+	int r;
+
+	if(t) {
+		md_grip_out_of_the_way(d, t);
+	}
+	r = XLowerWindow(d, w);
+
+	if(t) {
+		md_grip_sync(t, true);
+	}
+	return r;
+}
+
+int
+ctwm_XRestackWindows(Display *d, Window *ws, int n)
+{
+	int r;
+
+	for(int i = 0; i < n; i++) {
+		TwmWindow *t = md_frame_owner(d, ws[i]);
+
+		if(t) {
+			md_grip_out_of_the_way(d, t);
+		}
+	}
+	r = XRestackWindows(d, ws, n);
+
+	for(int i = 0; i < n; i++) {
+		TwmWindow *t = md_frame_owner(d, ws[i]);
+
+		if(t) {
+			md_grip_sync(t, true);
+		}
+	}
+	return r;
+}
+
+int
+ctwm_XReparentWindow(Display *d, Window w, Window parent, int x, int y)
+{
+	int r = XReparentWindow(d, w, parent, x, y);
+	TwmWindow *t = md_frame_owner(d, w);
+
+	if(t) {
+		/* Reparenting unmaps and remaps a mapped window; the border
+		 * goes along the same way, into the same parent. */
+		XReparentWindow(d, t->modern_grip, parent, x - MD_GRIP, y - MD_GRIP);
+		t->modern_grip_parent = parent;
+		t->modern_fx = x;
+		t->modern_fy = y;
+		t->modern_gx = x - MD_GRIP;
+		t->modern_gy = y - MD_GRIP;
+		md_grip_sync(t, true);
+	}
+	return r;
+}
diff -Nur a/win_modern.h b/win_modern.h
--- a/win_modern.h
+++ b/win_modern.h
@@ -0,0 +1,102 @@
+/*
+ * LikeOS -- the LikeOS window frame for ctwm ("ModernTitles").
+ *
+ * With the ModernTitles keyword set, ctwm draws its title bars as one flat
+ * band whose colour says whether the window has the focus: the application's
+ * icon and its title on the left in an anti-aliased font, and on the right
+ * the caption buttons -- rounded rectangles inset in the band, each with a
+ * small anti-aliased line glyph, that light up under the pointer, the close
+ * button in red.
+ *
+ * The glyph a button gets follows from the function bound to it: f.iconify
+ * draws the minimise line, the zoom functions the maximise square (or the
+ * restore glyph while the window is zoomed), f.delete and f.destroy the cross.
+ * A button bound to anything else keeps its configured image.
+ *
+ * Copyright (C) 2026 The LikeOS Project
+ */
+
+#ifndef _CTWM_WIN_MODERN_H
+#define _CTWM_WIN_MODERN_H
+
+/* Draw the whole title bar band: background, icon and name. */
+void ModernPaintTitle(TwmWindow *tmp_win);
+
+/* Draw one caption button in its current state.  Returns false for a button
+ * whose function has no glyph of its own, which the caller then draws the
+ * classic way. */
+bool ModernPaintTitleButton(TwmWindow *tmp_win, TBWindow *tbw);
+
+/* The window gained or lost the focus: redraw the title and its buttons in
+ * the colours for the new state. */
+void ModernFocusChanged(TwmWindow *tmp_win, bool focus);
+
+/* An EnterNotify or LeaveNotify on window `w'.  Returns true when `w' is one
+ * of tmp_win's caption buttons, which have then been redrawn hovered or not;
+ * false means the event is for somebody else. */
+bool ModernButtonCrossing(TwmWindow *tmp_win, Window w, bool entered);
+
+/*
+ * Menus (menus.c).  Rows are MODERN_MENU_ROW pixels tall; the entry under the
+ * pointer is a rounded rectangle in its highlight colour, inset in the row --
+ * ModernMenuHighlight() draws it over the row's background `bg' and returns
+ * true, or returns false when the mode is off and the caller fills the row
+ * the classic way.  Separators are MODERN_MENU_SEPARATOR_INSET pixels short
+ * of either edge, in ModernMenuSeparator(): MenuShadowColor, the menu's
+ * border, lightened towards the menu background.
+ */
+#define MODERN_MENU_ROW              30
+#define MODERN_MENU_SEPARATOR_INSET  10
+bool ModernMenuHighlight(Window w, int x, int y, int width, int height,
+                         Pixel bg, Pixel fill);
+Pixel ModernMenuSeparator(void);
+
+/* The window's _NET_WM_ICON changed: forget the cached title icon. */
+void ModernIconChanged(TwmWindow *tmp_win);
+
+/* The window is going away: free what ModernPaintTitle cached for it, and
+ * its resize border. */
+void ModernForgetWindow(TwmWindow *tmp_win);
+
+/*
+ * The resize border.
+ *
+ * A window shows a one-pixel edge, and the band that resizes it lies OUTSIDE
+ * that edge, where nothing is drawn: the pointer turns into a double arrow a
+ * few pixels short of the window, and a drag there resizes it.
+ * Without a compositor nothing can be drawn transparently, so the band is an
+ * InputOnly window -- invisible by definition -- a few pixels larger than the
+ * frame on every side and stacked directly beneath it.  The frame covers its
+ * middle; the ring around the frame is the band.  Being directly beneath its
+ * own frame, it is covered by every window above that frame, exactly as the
+ * window itself is.
+ *
+ * It has to follow the frame through every move, resize, restack, map, unmap
+ * and reparent.  ctwm does those in some thirty places, so rather than hook
+ * each one, ctwm.h routes the Xlib calls that do them through the wrappers
+ * below, which make the call and then bring the border along when the window
+ * is a frame that has one.
+ */
+
+/* Create the border for a newly managed window (frame already created). */
+void ModernGripCreate(TwmWindow *tmp_win);
+
+/* Pointer motion over the border, in its coordinates: set the cursor for the
+ * edge or corner the pointer is on. */
+void ModernGripMotion(TwmWindow *tmp_win, int x, int y);
+
+/* Edges a resize started by `evp' moves, as MODERN_EDGE_* bits: the edges
+ * nearest the pointer when the press was on the border (or on the frame's
+ * own one-pixel edge), 0 otherwise.  fx..fh are the frame's inner geometry,
+ * as StartResize() has it. */
+#define MODERN_EDGE_TOP    1
+#define MODERN_EDGE_BOTTOM 2
+#define MODERN_EDGE_LEFT   4
+#define MODERN_EDGE_RIGHT  8
+int ModernResizeEdges(TwmWindow *tmp_win, XEvent *evp, int fx, int fy,
+                      int fw, int fh);
+
+/* The cursor for a set of MODERN_EDGE_* bits. */
+Cursor ModernEdgeCursor(int edges);
+
+#endif /* _CTWM_WIN_MODERN_H */
diff -Nur a/win_ops.c b/win_ops.c
--- a/win_ops.c
+++ b/win_ops.c
@@ -15,6 +15,7 @@
 #include "otp.h"
 #include "screen.h"
 #include "win_decorations.h"
+#include "win_modern.h"
 #include "win_iconify.h"
 #include "win_ops.h"
 #include "win_utils.h"
@@ -115,6 +116,11 @@ SetFocusVisualAttributes(TwmWindow *tmp_win, bool focus)
 		             tmp_win->title, bs, false, false);
 	}
 	tmp_win->hasfocusvisible = focus;
+
+	/* ModernTitles: the title bar's colours follow the focus. */
+	if(Scr->ModernTitles && tmp_win->title_height) {
+		ModernFocusChanged(tmp_win, focus);
+	}
 }
 
 
diff -Nur a/win_resize.c b/win_resize.c
--- a/win_resize.c
+++ b/win_resize.c
@@ -40,6 +40,7 @@
 #include "r_area_list.h"
 #include "r_layout.h"
 #include "win_decorations.h"
+#include "win_modern.h"
 #include "win_ops.h"
 #include "win_resize.h"
 #include "win_utils.h"
@@ -216,7 +217,35 @@ void StartResize(XEvent *evp, TwmWindow *tmp_win,
 	origHeight = dragHeight;
 	clampTop = clampBottom = clampLeft = clampRight = clampDX = clampDY = 0;
 
-	if(Scr->AutoRelativeResize && (from3dborder || !fromtitlebar)) {
+	/* Started on the window's edge (ModernTitles' resize border): the edges
+	 * under the pointer move, and only those, keeping their distance from
+	 * the pointer -- so the window does not jump to it -- and the pointer
+	 * keeps the edge's double arrow for the whole drag. */
+	int edges = ModernResizeEdges(tmp_win, evp, dragx, dragy, (int)dragWidth,
+	                              (int)dragHeight);
+	if(edges) {
+		int x = evp->xbutton.x_root, y = evp->xbutton.y_root;
+
+		if(edges & MODERN_EDGE_LEFT) {
+			clampLeft = 1;
+			clampDX = x - dragx;
+		}
+		else if(edges & MODERN_EDGE_RIGHT) {
+			clampRight = 1;
+			clampDX = x - dragx - (int)dragWidth;
+		}
+		if(edges & MODERN_EDGE_TOP) {
+			clampTop = 1;
+			clampDY = y - dragy;
+		}
+		else if(edges & MODERN_EDGE_BOTTOM) {
+			clampBottom = 1;
+			clampDY = y - dragy - (int)dragHeight;
+		}
+		XChangeActivePointerGrab(dpy, resizeGrabMask, ModernEdgeCursor(edges),

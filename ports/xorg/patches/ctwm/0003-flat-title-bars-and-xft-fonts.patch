+/* ------------------------------------------------------------------------ */
+/* Colour helpers                                                           */
+/* ------------------------------------------------------------------------ */
+
+static unsigned long
+chan(unsigned int c8, unsigned long mask)
+{
+	int shift = 0, bits = 0;
+	unsigned long v;
+
+	if(mask == 0) {
+		return 0;
+	}
+	while(!(mask & 1)) {
+		mask >>= 1;
+		shift++;
+	}
+	while(mask & 1) {
+		mask >>= 1;
+		bits++;
+	}
+	v = (bits >= 8) ? ((unsigned long)c8 << (bits - 8)) : (c8 >> (8 - bits));
+	return v << shift;
+}
+
+static unsigned long
+md_pixel(unsigned int rgb)
+{
+	Visual *v = Scr->d_visual;
+
+	return chan((rgb >> 16) & 0xff, v->red_mask) |
+	       chan((rgb >> 8) & 0xff, v->green_mask) |
+	       chan(rgb & 0xff, v->blue_mask);
+}
+
+/* The 0xRRGGBB a TrueColor pixel value stands for: the inverse of
+ * md_pixel(), for colours ctwm allocated from the configuration. */
+static unsigned int
+md_rgb(unsigned long pixel)
+{
+	Visual *v = Scr->d_visual;
+	unsigned long masks[3] = { v->red_mask, v->green_mask, v->blue_mask };
+	unsigned int out = 0;
+
+	for(int c = 0; c < 3; c++) {
+		unsigned long mask = masks[c], val;
+		int shift = 0, bits = 0;
+
+		if(mask == 0) {
+			continue;
+		}
+		while(!(mask & 1)) {
+			mask >>= 1;
+			shift++;
+		}
+		while(mask & 1) {
+			mask >>= 1;
+			bits++;
+		}
+		val = (pixel >> shift) & ((1UL << bits) - 1);
+		val = bits >= 8 ? val >> (bits - 8) : (val * 255) / ((1UL << bits) - 1);
+		out |= (unsigned int)(val & 0xff) << (16 - 8 * c);
+	}
+	return out;
+}
+
+/* `a' of `fg' over `bg', both 0xRRGGBB. */
+static unsigned int
+md_blend(unsigned int bg, unsigned int fg, double a)
+{
+	unsigned int out = 0;
+
+	if(a <= 0) {
+		return bg;
+	}
+	if(a >= 1) {
+		return fg;
+	}
+	for(int s = 0; s <= 16; s += 8) {
+		double b = (bg >> s) & 0xff, f = (fg >> s) & 0xff;
+		unsigned int c = (unsigned int)(b + (f - b) * a + 0.5);
+
+		out |= (c > 255 ? 255 : c) << s;
+	}
+	return out;
+}
+
+/* Everything here assumes a TrueColor screen, which is what every modern
+ * server offers; on anything else the classic decorations are used. */
+static bool
+md_usable(void)
+{
+	return Scr->ModernTitles && Scr->d_visual &&
+	       Scr->d_visual->class == TrueColor;
+}
+
+static XImage *
+md_image(int w, int h)
+{
+	char *data = malloc((size_t)w * h * 4);
+	XImage *img;
+
+	if(!data) {
+		return NULL;
+	}
+	img = XCreateImage(dpy, Scr->d_visual, Scr->d_depth, ZPixmap, 0, data,
+	                   w, h, 32, 0);
+	if(!img) {
+		free(data);
+	}
+	return img;
+}

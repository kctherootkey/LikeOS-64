+/*
+ * LikeOS -- the LikeOS window frame for ctwm ("ModernTitles").
+ *
+ * See win_modern.h for what this draws.  Everything is drawn client-side into
+ * small XImages and blitted, rather than with core X lines: the caption
+ * glyphs are thin strokes with anti-aliased curves and diagonals, the caption
+ * buttons rounded rectangles with smooth corners, and the application icon is
+ * blended onto the title colour, none of which the core protocol can draw.
+ * Blending against a known, opaque background is all that is needed -- the
+ * title bar is a solid colour -- so no compositing or Render extension is
+ * involved.
+ *
+ * The colours are the LikeOS light palette: a focused title is #eef2f9 with
+ * near-black text, an unfocused one #f5f7fb with slate text and glyphs.  A
+ * caption button under the pointer gets a faint blue-grey wash, the close
+ * button a coral red (#e0443e) with a white glyph.
+ *
+ * The resize border at the end of this file is the other half of the frame:
+ * the band outside the visible edge that resizes the window.
+ *
+ * Copyright (C) 2026 The LikeOS Project
+ */
+
+/* This file implements the frame-call wrappers ctwm.h routes everything
+ * else through, so it has to see the real Xlib calls. */
+#define CTWM_NO_FRAME_REDIRECT
+#include "ctwm.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#include <X11/Xatom.h>
+#include <X11/Xutil.h>
+#include <X11/Xft/Xft.h>
+
+#include "functions_defs.h"
+#include "screen.h"
+#include "win_decorations.h"
+#include "win_modern.h"
+
+#define MD_ACTIVE_BG     0xeef2f9
+#define MD_INACTIVE_BG   0xf5f7fb
+#define MD_ACTIVE_FG     0x141a24
+#define MD_INACTIVE_FG   0x586174
+#define MD_HOVER_TINT    0x1c3a78  /* the wash under the pointer ... */
+#define MD_HOVER_ALPHA   0.06      /* ... and how much of it */
+#define MD_CLOSE_BG      0xe0443e
+#define MD_CLOSE_FG      0xffffff
+
+#define MD_GLYPH         10   /* caption glyph box, pixels */
+#define MD_STROKE        1.25 /* caption glyph line width, pixels */
+#define MD_BUTTON_H      26   /* caption button height (its width is the
+                               * TitleButtonWidth), vertically centred */
+#define MD_BUTTON_RADIUS 6    /* its corners */
+#define MD_ICON          16   /* title icon, pixels */
+#define MD_LEFT_PAD      12   /* title bar edge to the icon or the text */
+#define MD_ICON_ADVANCE  24   /* icon's left edge to the text */
+#define MD_RIGHT_PAD     8    /* text to the first caption button */
+
+typedef enum { MD_NONE, MD_MINIMIZE, MD_MAXIMIZE, MD_CLOSE } ModernKind;
+
+/* The application icon at title size, kept per window: 16x16 ARGB. */
+struct modern_icon {
+	unsigned int px[MD_ICON * MD_ICON];
+};

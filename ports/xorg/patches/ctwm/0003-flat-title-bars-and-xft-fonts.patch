+/* ------------------------------------------------------------------------ */
+/* Menus                                                                    */
+/* ------------------------------------------------------------------------ */
+
+#define MD_MENU_HL_INSET  4   /* highlight, in from the menu's sides */
+#define MD_MENU_HL_RADIUS 6
+
+bool
+ModernMenuHighlight(Window w, int x, int y, int width, int height, Pixel bg,
+                    Pixel fill)
+{
+	unsigned int bg_rgb, fill_rgb;
+	int hw = width - 2 * MD_MENU_HL_INSET, hh = height - 2;
+	XImage *img;
+
+	if(!md_usable() || hw <= 2 * MD_MENU_HL_RADIUS ||
+	                hh <= 2 * MD_MENU_HL_RADIUS) {
+		return false;
+	}
+	img = md_image(width, height);
+	if(!img) {
+		return false;
+	}
+	bg_rgb = md_rgb(bg);
+	fill_rgb = md_rgb(fill);
+	/* One pixel clear above and below, so that neighbouring rows never
+	 * run together. */
+	for(int j = 0; j < height; j++) {
+		for(int i = 0; i < width; i++) {
+			double a = 0;
+
+			if(j >= 1 && j < height - 1 && i >= MD_MENU_HL_INSET &&
+			                i < width - MD_MENU_HL_INSET) {
+				a = rrect_cover(i - MD_MENU_HL_INSET, j - 1, hw, hh,
+				                MD_MENU_HL_RADIUS);
+			}
+			XPutPixel(img, i, j, md_pixel(md_blend(bg_rgb, fill_rgb, a)));
+		}
+	}
+	XPutImage(dpy, w, Scr->NormalGC, img, 0, 0, x, y, (unsigned int)width,
+	          (unsigned int)height);
+	XDestroyImage(img);
+	return true;
+}
+
+Pixel
+ModernMenuSeparator(void)
+{
+	if(!md_usable()) {
+		return Scr->MenuShadowColor;
+	}
+	return md_pixel(md_blend(md_rgb(Scr->MenuC.back),
+	                         md_rgb(Scr->MenuShadowColor), 0.55));
+}

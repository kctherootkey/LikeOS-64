+# Xft, for anti-aliased fonts ("xft:" font names) and ModernTitles.  Its
+# header pulls in FreeType's, which lives in a freetype2/ subdirectory.
+if(NOT X11_Xft_FOUND)
+	message(FATAL_ERROR "Can't find Xft; missing lib or -devel package?")
+endif()
+find_path(FREETYPE2_INCLUDE_DIR ft2build.h PATH_SUFFIXES freetype2)
+if(NOT FREETYPE2_INCLUDE_DIR)
+	message(FATAL_ERROR "Can't find ft2build.h (FreeType headers)")
+endif()
+include_directories(${X11_Xft_INCLUDE_PATH} ${FREETYPE2_INCLUDE_DIR})
+list(APPEND CTWMLIBS ${X11_Xft_LIB} m)
+
 

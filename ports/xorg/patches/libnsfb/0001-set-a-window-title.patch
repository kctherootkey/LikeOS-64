Give the window a name.

The X surface never set WM_NAME, so the window arrived at the window manager
nameless and was displayed under its placeholder for untitled windows.  The
program's own name is used, so this is not specific to one application.

--- a/src/surface/x.c
+++ b/src/surface/x.c
@@ -880,6 +880,29 @@
     update_and_redraw_pixmap(xstate, 0, 0, xstate->image->width, xstate->image->height);
 
 
+    /* Name the window.
+     *
+     * The surface never set WM_NAME, so the window reached the window manager
+     * nameless and was shown under whatever placeholder that manager uses for
+     * an untitled window.  The program's own name is used rather than a string
+     * baked in here, so any application on this surface gets its own title.
+     *
+     * WM_ICON_NAME is set to the same thing: a window manager showing an
+     * iconified window reads that one instead, and leaving it unset would put
+     * the placeholder back the moment the window was minimised. */
+    {
+        extern const char *__progname;
+        const char *title = (__progname && *__progname) ? __progname : "nsfb";
+        size_t tlen = strlen(title);
+
+        xcb_change_property(xstate->connection, XCB_PROP_MODE_REPLACE,
+                            xstate->window, XCB_ATOM_WM_NAME,
+                            XCB_ATOM_STRING, 8, tlen, title);
+        xcb_change_property(xstate->connection, XCB_PROP_MODE_REPLACE,
+                            xstate->window, XCB_ATOM_WM_ICON_NAME,
+                            XCB_ATOM_STRING, 8, tlen, title);
+    }
+
     /* show the window */
     xcb_map_window (xstate->connection, xstate->window);
     xcb_flush(xstate->connection);

+/*
+ * MemoryPressureHandler for LikeOS.
+ *
+ * This system has no swap, so what WebKit holds nothing else can have, and
+ * the engine must give memory back before the machine is full.  Upstream has
+ * two ways of noticing that it should, and this file provides both for a
+ * system that is not Linux:
+ *
+ *   - the system monitor.  On Linux the UI process watches /proc/meminfo
+ *     (UIProcess/linux/MemoryPressureMonitor.cpp) and tells every process
+ *     over IPC to release memory when the machine is nearly full.  That
+ *     message, its receiver and the handler's trigger for it are all
+ *     declared under OS(LINUX), in headers most of the engine includes, so
+ *     the monitor lives here instead: every process installs this handler,
+ *     and install() starts one thread per process that reads /proc/meminfo
+ *     the way the Linux monitor does and delivers the verdict to its own
+ *     process.  Same knob: WEBKIT_DISABLE_MEMORY_PRESSURE_MONITOR=1.
+ *
+ *   - the per-process monitor.  MemoryPressureHandler::measurementTimerFired()
+ *     compares memoryFootprint() with fractions of min(3 GB, RAM) every 30 s
+ *     and prunes accordingly; that needs a footprint, which
+ *     linux/MemoryFootprintLinux.cpp supplies from /proc/self/statm.  The
+ *     web process leaves this one off unless WEBKIT_PERIODIC_MEMORY_MONITOR=1
+ *     is set, as upstream does with system malloc; WebProcess.cpp says why.
+ *
+ * The response and its hold-off are those of unix/MemoryPressureHandlerUnix.cpp;
+ * the hold-off timer, a member declared under the same OS list, is replaced
+ * by a deadline the polling thread honours.
+ *
+ * The thresholds are lower than Linux's because of the swap.  Linux declares
+ * pressure at 90% of RAM in use and critical at 95%: the last 10%, plus swap,
+ * covers the time between the machine getting there and the processes
+ * responding.  Here there is no plus.  The reserve alone has to cover one
+ * polling interval of allocation -- a page load can take a hundred megabytes
+ * in the second between polls -- and the response itself, which allocates
+ * before it frees.  So the reserve is doubled: pressure at 80%, critical at
+ * 90%, and the polling curve shifted down the same ten points, one-second
+ * polls from 75% in use and five-second ones below 40%.  "In use" is
+ * MemTotal minus MemAvailable, and the kernel counts its page cache as
+ * available, since it drops that on demand.
+ */
+
+#include "config.h"
+#include <wtf/MemoryPressureHandler.h>
+
+#include <algorithm>
+#include <atomic>
+#include <malloc.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <wtf/MainThread.h>
+#include <wtf/MemoryFootprint.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/Threading.h>
+#include <wtf/linux/CurrentProcessMemoryStatus.h>
+#include <wtf/text/WTFString.h>
+
+namespace WTF {
+
+// Percent of RAM in use.  See the note at the top for the values.
+static const int s_memoryPressurePercentageThreshold = 80;
+static const int s_memoryPressurePercentageThresholdCritical = 90;
+static const double s_minUsedMemoryPercentageForPolling = 40;
+static const double s_maxUsedMemoryPercentageForPolling = 75;
+static const Seconds s_minPollingInterval { 1_s };
+static const Seconds s_maxPollingInterval { 5_s };
+
+// Hold-off after a response, as in unix/MemoryPressureHandlerUnix.cpp: at
+// least s_minimumHoldOffTime, s_holdOffMultiplier times the time the release
+// took if it freed at least s_minimumBytesFreedToUseMinimumHoldOffTime, and
+// s_maximumHoldOffTime if it freed less than that.
+static const Seconds s_minimumHoldOffTime { 5_s };
+static const Seconds s_maximumHoldOffTime { 30_s };
+static const size_t s_minimumBytesFreedToUseMinimumHoldOffTime = 1 * MB;
+static const unsigned s_holdOffMultiplier = 20;
+
+// The hold-off deadline, as MonotonicTime seconds.  Written on the main
+// thread by holdOff(), read by the polling thread.
+static std::atomic<double> s_holdOffUntil { 0 };
+
+// The last reading that made the polling thread ask for a response, for
+// the line the response writes.
+static std::atomic<int> s_usedPercentageAtRequest { -1 };
+
+// Every trigger writes a line to stderr, prefixed by the pid so that the
+// web process, the network process and the UI process can be told apart:
+// which monitor fired, what it saw, what the release cost and freed.  A
+// release is rare and never cheap -- at its heaviest it drops every
+// decoded image, the style resolver and the compiled JavaScript of every
+// page in the process -- so when a page stalls, these lines say whether
+// the engine was releasing at the time, and why.  The relief logger's
+// own "Memory pressure relief: Total" line, which the UI process switches
+// on for the web process as it does on Linux, follows with the resident
+// size before and after.
+static const char* policyName(MemoryUsagePolicy policy)
+{
+    switch (policy) {
+    case MemoryUsagePolicy::Unrestricted: return "Unrestricted";
+    case MemoryUsagePolicy::Conservative: return "Conservative";
+    case MemoryUsagePolicy::Strict: return "Strict";
+    }
+    return "?";
+}
+
+static int systemMemoryUsedAsPercentage()
+{
+    FILE* file = fopen("/proc/meminfo", "r");
+    if (!file)
+        return -1;
+
+    unsigned long long total = 0;
+    unsigned long long available = 0;
+    bool haveTotal = false;
+    bool haveAvailable = false;
+    char line[128];
+    while (fgets(line, sizeof(line), file)) {
+        unsigned long long value;
+        if (sscanf(line, "MemTotal: %llu kB", &value) == 1) {
+            total = value;
+            haveTotal = true;
+        } else if (sscanf(line, "MemAvailable: %llu kB", &value) == 1) {
+            available = value;
+            haveAvailable = true;
+        }
+        if (haveTotal && haveAvailable)
+            break;
+    }
+    fclose(file);
+
+    if (!haveTotal || !haveAvailable || !total || available > total)
+        return -1;
+    return static_cast<int>(((total - available) * 100) / total);
+}
+
+static Seconds pollIntervalForUsedMemoryPercentage(int usedPercentage)
+{
+    // The Linux monitor's curve: poll seldom while memory is plentiful,
+    // every second once it is not, linearly in between.
+    if (usedPercentage < s_minUsedMemoryPercentageForPolling)
+        return s_maxPollingInterval;
+
+    if (usedPercentage >= s_maxUsedMemoryPercentageForPolling)
+        return s_minPollingInterval;
+
+    return s_minPollingInterval + (s_maxPollingInterval - s_minPollingInterval) *
+        ((s_maxUsedMemoryPercentageForPolling - usedPercentage) / (s_maxUsedMemoryPercentageForPolling - s_minUsedMemoryPercentageForPolling));
+}
+
+static size_t processMemoryUsage()
+{
+    ProcessMemoryStatus memoryStatus;
+    currentProcessMemoryStatus(memoryStatus);
+    return memoryStatus.resident - memoryStatus.shared;
+}
+
+static bool monitorDisabled()
+{
+    const char* value = getenv("WEBKIT_DISABLE_MEMORY_PRESSURE_MONITOR");
+    return value && !strcmp(value, "1");
+}
+
+void MemoryPressureHandler::install()
+{
+    if (m_installed)
+        return;
+    m_installed = true;
+
+    // One thread for the life of the process, started by the first
+    // install(); uninstall()/install() around a hold-off must not add more.
+    static bool monitorStarted = false;
+    if (monitorStarted || monitorDisabled())
+        return;
+    monitorStarted = true;
+
+    Thread::create("MemoryPressureMonitor"_s, [this] {
+        Seconds pollInterval = s_maxPollingInterval;
+        while (true) {
+            sleep(pollInterval);
+
+            int usedPercentage = systemMemoryUsedAsPercentage();
+            if (usedPercentage == -1) {
+                pollInterval = s_maxPollingInterval;
+                continue;
+            }
+
+            if (usedPercentage >= s_memoryPressurePercentageThreshold && MonotonicTime::now().secondsSinceEpoch().value() >= s_holdOffUntil.load()) {
+                bool isCritical = usedPercentage >= s_memoryPressurePercentageThresholdCritical;
+                // The response sets the real hold-off once it has run; this
+                // keeps the next poll from queueing another one before then.
+                s_holdOffUntil.store((MonotonicTime::now() + s_minimumHoldOffTime).secondsSinceEpoch().value());
+                s_usedPercentageAtRequest.store(usedPercentage);
+                callOnMainThread([this, isCritical] {
+                    respondToMemoryPressure(isCritical ? Critical::Yes : Critical::No);
+                });
+            }
+            pollInterval = pollIntervalForUsedMemoryPercentage(usedPercentage);
+        }
+    })->detach();
+}
+
+void MemoryPressureHandler::uninstall()
+{
+    m_installed = false;
+}
+
+void MemoryPressureHandler::holdOff(Seconds seconds)
+{
+    s_holdOffUntil.store((MonotonicTime::now() + seconds).secondsSinceEpoch().value());
+}
+
+void MemoryPressureHandler::respondToMemoryPressure(Critical critical, Synchronous synchronous)
+{
+    if (!m_installed)
+        return;
+
+    setMemoryPressureStatus(SystemMemoryPressureStatus::Critical);
+
+    MonotonicTime startTime = MonotonicTime::now();
+    int64_t processMemory = processMemoryUsage();
+    releaseMemory(critical, synchronous);
+    int64_t bytesFreed = processMemory - processMemoryUsage();
+
+    setMemoryPressureStatus(SystemMemoryPressureStatus::Normal);
+
+    Seconds took = MonotonicTime::now() - startTime;
+    Seconds holdOffTime = s_maximumHoldOffTime;
+    if (bytesFreed > 0 && static_cast<size_t>(bytesFreed) >= s_minimumBytesFreedToUseMinimumHoldOffTime)
+        holdOffTime = took * s_holdOffMultiplier;
+    holdOffTime = std::max(holdOffTime, s_minimumHoldOffTime);
+    holdOff(holdOffTime);
+
+    WTFLogAlways("[%d] memory pressure: system at %d%% in use, %s release took %.0f ms and freed %lld MB, next one in %.0f s at the earliest",
+        static_cast<int>(getpid()), s_usedPercentageAtRequest.load(),
+        critical == Critical::Yes ? "critical" : "non-critical",
+        took.milliseconds(), static_cast<long long>(bytesFreed / (1024 * 1024)), holdOffTime.seconds());
+}
+
+void MemoryPressureHandler::platformReleaseMemory(Critical critical)
+{
+    // Reached from both monitors: the system one above, and the per-process
+    // one (MemoryPressureHandler::measurementTimerFired, on when
+    // WEBKIT_PERIODIC_MEMORY_MONITOR=1) whose verdict is the policy named
+    // here -- Conservative or Strict is that monitor talking, Unrestricted
+    // means the system one did.
+    WTFLogAlways("[%d] memory pressure: %s release, resident %zu MB, process policy %s",
+        static_cast<int>(getpid()), critical == Critical::Yes ? "critical" : "non-critical",
+        memoryFootprint() / (1024 * 1024), policyName(m_memoryUsagePolicy));
+#if HAVE(MALLOC_TRIM)
+    malloc_trim(0);
+#endif
+}
+
+std::optional<MemoryPressureHandler::ReliefLogger::MemoryUsage> MemoryPressureHandler::ReliefLogger::platformMemoryUsage()
+{
+    return MemoryUsage { processMemoryUsage(), memoryFootprint() };
+}
+
+} // namespace WTF

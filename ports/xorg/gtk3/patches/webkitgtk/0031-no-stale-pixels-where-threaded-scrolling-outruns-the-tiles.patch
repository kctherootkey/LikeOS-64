-void AcceleratedSurface::clear(const OptionSet<WebCore::CompositionReason>& reasons)
+// Every frame starts from the background, opaque or not.  Skipping the clear
+// for an opaque background on all but scrolling-thread frames assumed that the
+// tiles cover the viewport in every other frame, and with threaded scrolling
+// they need not: a rendering update composites with the scrolling tree's
+// positions, which may have moved past what the update covered with tiles
+// while the main thread was busy.  Uncovered pixels then showed whatever the
+// buffer held before -- an older frame at another offset, or memory nothing
+// ever wrote (grey on VMware, whose undefined surface contents are 0xcc) --
+// until the tiles arrived.  One clear per frame is a fraction of the cost of
+// compositing it.
+void AcceleratedSurface::clear(const OptionSet<WebCore::CompositionReason>&)
 {
     ASSERT(!RunLoop::isMain());
     auto backgroundColor = m_backgroundColor.load();
     if (!isColorOpaque(backgroundColor)) {
         glClearColor(0, 0, 0, 0);
         glClear(GL_COLOR_BUFFER_BIT);
-    } else if (reasons.contains(CompositionReason::AsyncScrolling)) {
-        auto [r, g, b, a] = backgroundColor;
-        glClearColor(r, g, b, a);
-        glClear(GL_COLOR_BUFFER_BIT);
+        return;
     }
+
+    auto [r, g, b, a] = backgroundColor;
+    glClearColor(r, g, b, a);
+    glClear(GL_COLOR_BUFFER_BIT);
 }
 

+
+void webkitWebViewBaseSetCursor(WebKitWebViewBase* webViewBase, const Cursor& cursor)
+{
+    if (webViewBase->priv->isBusy) {
+        // Kept for when the wait ends; the hourglass stays until then.
+        webViewBase->priv->cursorRequestedWhileBusy = cursor;
+        return;
+    }
+    webkitWebViewBaseApplyCursor(webViewBase, cursor);
+}
+
+static void webkitWebViewBaseShowBusyCursor(WebKitWebViewBase* webViewBase)
+{
+    WebKitWebViewBasePrivate* priv = webViewBase->priv;
+#if USE(GTK4)
+    priv->cursorBeforeBusy = gtk_widget_get_cursor(GTK_WIDGET(webViewBase));
+#else
+    GdkWindow* window = gtk_widget_get_window(GTK_WIDGET(webViewBase));
+    if (!window)
+        return; // Not realized yet: realize() shows it once there is a window.
+    priv->cursorBeforeBusy = gdk_window_get_cursor(window);
+#endif
+    webkitWebViewBaseApplyCursor(webViewBase, Cursor::fromType(Cursor::Type::Progress));
+}
+
+void webkitWebViewBaseSetBusy(WebKitWebViewBase* webViewBase, bool busy)
+{
+    WebKitWebViewBasePrivate* priv = webViewBase->priv;
+    if (priv->isBusy == busy)
+        return;
+
+    priv->isBusy = busy;
+    if (busy) {
+        priv->cursorRequestedWhileBusy = std::nullopt;
+        webkitWebViewBaseShowBusyCursor(webViewBase);
+        return;
+    }
+
+    GRefPtr<GdkCursor> cursorBeforeBusy = WTF::move(priv->cursorBeforeBusy);
+#if !USE(GTK4)
+    GdkWindow* window = gtk_widget_get_window(GTK_WIDGET(webViewBase));
+    if (!window) {
+        // Never shown, or gone with the window; WebCore sends the cursor
+        // again on the next pointer motion.
+        priv->cursorRequestedWhileBusy = std::nullopt;
+        return;
+    }
+#endif
+    if (priv->cursorRequestedWhileBusy) {
+        Cursor cursor = *priv->cursorRequestedWhileBusy;
+        priv->cursorRequestedWhileBusy = std::nullopt;
+        webkitWebViewBaseApplyCursor(webViewBase, cursor);
+        return;
+    }
+
+    // Nothing asked for a cursor during the wait: put back the one from before.
+#if USE(GTK4)
+    gtk_widget_set_cursor(GTK_WIDGET(webViewBase), cursorBeforeBusy.get());
+#else
+    gdk_window_set_cursor(window, cursorBeforeBusy.get());
+#endif
+}

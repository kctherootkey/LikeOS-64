+// The positions the main thread's layer flush and the scrolling tree set are
+// pending until this runs: on the main thread at the end of a rendering
+// update, after the scrolling tree has applied its positions, and on the
+// scrolling thread after it has applied them on its own.  Both commit the
+// whole tree under the state lock, which the compositor also takes to read
+// positions, so a frame never combines the main thread's position of one
+// layer with the scrolling tree's position of another.
+void CoordinatedSceneState::flushPendingState()
+{
+    Locker stateLock { m_stateLock };
+    Locker layersLock { m_layersLock };
+    for (Ref layer : m_layers)
+        layer->flushPendingState();
+}
+
+void CoordinatedSceneState::flushCompositingState(const OptionSet<CompositionReason>& reasons)
+{
+    ASSERT(!isMainRunLoop());
+    auto& layers = committedLayers();
+
+    {
+        Locker stateLock { m_stateLock };
+        m_rootLayer->flushPositionChanges(reasons);
+        for (auto& layer : layers)
+            layer->flushPositionChanges(reasons);
+    }
+
+    m_rootLayer->flushCompositingState(reasons);
+    for (auto& layer : layers)
+        layer->flushCompositingState(reasons);
 }
 

 #endif
 
     std::optional<GstMappedFrame> m_videoFrame;
+#if USE(GBM)
+    // A frame shown straight from the decoder's memory stays the decoder's
+    // for as long as it is shown: the buffer is held here, so its memory
+    // does not go back to the decoder's pool to be filled with a later
+    // frame while the compositor still draws from it.
+    GRefPtr<GstBuffer> m_gstBuffer;
+#endif
     std::optional<GstVideoDecoderPlatform> m_videoDecoderPlatform;
     std::unique_ptr<CoordinatedPlatformLayerBuffer> m_buffer;
 };

 #if PLATFORM(GTK)
-// LikeOS: the pointer over the view shows the small hourglass while the page
-// is loading or its web process has stopped answering.
+// LikeOS: the pointer over the view carries the small hourglass while what
+// is on screen is not yet what the person will get: the page is loading,
+// resources it asked for are still arriving, or its web process is too busy
+// to answer -- which is when nothing on the page reacts to a click.
+//
+// Loading and network activity come from the page load state.  Busyness is
+// measured: while a load is in progress and for a few seconds after, the
+// watch below pings the web process's main thread every quarter second and
+// counts an answer that takes longer than that as busy.  The pings stop when
+// the page has settled, so an idle page costs nothing.
+static constexpr Seconds busyWatchInterval = 250_ms;
+static constexpr Seconds busyPingSlow = 250_ms;
+static constexpr Seconds busySettleWindow = 5_s;
+// A stretch of network activity after the load (a fetch the page started
+// late, or one a click started) holds the hourglass at most this long, so a
+// page that polls forever does not wait forever.
+static constexpr Seconds busyNetworkMax = 10_s;
+
 static void webkitWebViewUpdateBusyCursor(WebKitWebView* webView)
 {
     WebKitWebViewPrivate* priv = webView->priv;
-    webkitWebViewBaseSetBusy(WEBKIT_WEB_VIEW_BASE(webView), priv->isLoading || !priv->isWebProcessResponsive);
+    webkitWebViewBaseSetBusy(WEBKIT_WEB_VIEW_BASE(webView), priv->isLoading || priv->networkBusy || priv->mainThreadBusy || !priv->isWebProcessResponsive);
+}
+
+static gboolean webkitWebViewBusyWatchTick(gpointer);
+
+static void webkitWebViewStartBusyWatch(WebKitWebView* webView)
+{
+    WebKitWebViewPrivate* priv = webView->priv;
+    priv->busyWindowEnd = MonotonicTime::now() + busySettleWindow;
+    if (!priv->busyWatchSource)
+        priv->busyWatchSource = g_timeout_add(busyWatchInterval.millisecondsAs<unsigned>(), webkitWebViewBusyWatchTick, webView);
+}
+
+static void webkitWebViewStopBusyWatch(WebKitWebView* webView)
+{
+    WebKitWebViewPrivate* priv = webView->priv;
+    if (priv->busyWatchSource) {
+        g_source_remove(priv->busyWatchSource);
+        priv->busyWatchSource = 0;
+    }
+    priv->networkBusy = false;
+    priv->mainThreadBusy = false;
+}
+
+static void webkitWebViewPingAnswered(WebKitWebView* webView)
+{
+    WebKitWebViewPrivate* priv = webView->priv;
+    priv->pingOutstanding = false;
+    priv->mainThreadBusy = false;
+    webkitWebViewUpdateBusyCursor(webView);
+}
+
+static gboolean webkitWebViewBusyWatchTick(gpointer userData)
+{
+    auto* webView = WEBKIT_WEB_VIEW(userData);
+    WebKitWebViewPrivate* priv = webView->priv;
+    auto now = MonotonicTime::now();
+    bool network = getPage(webView).pageLoadState().networkRequestsInProgress();
+
+    priv->networkBusy = network && (priv->isLoading || now < priv->networkBusyUntil);
+    if (priv->isLoading || priv->networkBusy)
+        priv->busyWindowEnd = now + busySettleWindow;
+
+    if (now >= priv->busyWindowEnd) {
+        // Settled: the last cursor decision, then no more ticks.
+        priv->busyWatchSource = 0;
+        priv->networkBusy = false;
+        priv->mainThreadBusy = false;
+        webkitWebViewUpdateBusyCursor(webView);
+        return G_SOURCE_REMOVE;
+    }
+
+    if (!priv->pingOutstanding) {
+        priv->pingOutstanding = true;
+        priv->pingSentAt = now;
+        // Answered when the web process's main thread gets to it; answered
+        // with false, at once, when the process is already known to be
+        // unresponsive or has gone -- is-web-process-responsive covers those.
+        getPage(webView).legacyMainFrameProcess().isResponsive([weakView = GWeakPtr<WebKitWebView>(webView)](bool) {
+            if (auto* view = weakView.get())
+                webkitWebViewPingAnswered(view);
+        });
+    } else if (now - priv->pingSentAt >= busyPingSlow)
+        priv->mainThreadBusy = true;
+
+    webkitWebViewUpdateBusyCursor(webView);
+    return G_SOURCE_CONTINUE;
+}
+
+static void webkitWebViewNetworkActivityChanged(WebKitWebView* webView)
+{
+    WebKitWebViewPrivate* priv = webView->priv;
+    auto now = MonotonicTime::now();
+    if (getPage(webView).pageLoadState().networkRequestsInProgress()) {
+        if (!priv->isLoading)
+            priv->networkBusyUntil = now + busyNetworkMax;
+        priv->networkBusy = true;
+        webkitWebViewStartBusyWatch(webView);
+    } else
+        priv->networkBusy = false;
+    webkitWebViewUpdateBusyCursor(webView);
 }
 #endif
 

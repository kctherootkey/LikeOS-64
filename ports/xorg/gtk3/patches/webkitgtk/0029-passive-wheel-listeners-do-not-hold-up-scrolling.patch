+#if !ENABLE(WHEEL_EVENT_REGIONS)
+static bool hasNonPassiveWheelEventListener(EventTarget& target)
+{
+    auto& names = eventNames();
+    for (auto* eventType : { &names.wheelEvent, &names.mousewheelEvent }) {
+        for (auto& listener : target.eventListeners(*eventType)) {
+            if (!listener->isPassive())
+                return true;
+        }
+    }
+    return false;
+}
+
+// Whether the wheel listeners counted for this node may cancel the scroll.
+// The document stands for the window's listeners too (LocalDOMWindow counts
+// them against it).
+static bool wheelEventTargetCanPreventScrolling(Node& node)
+{
+    if (hasNonPassiveWheelEventListener(node))
+        return true;
+    if (RefPtr document = dynamicDowncast<Document>(node)) {
+        if (RefPtr window = document->window())
+            return hasNonPassiveWheelEventListener(*window);
+    }
+    return false;
+}
+#endif
+
+// The region the scrolling thread must not scroll before the main thread has
+// dispatched the wheel event.  Without event regions only listeners that may
+// cancel the scroll put a target here: a passive listener cannot, and
+// ScrollingCoordinator sends the event to it without blocking the scroll.

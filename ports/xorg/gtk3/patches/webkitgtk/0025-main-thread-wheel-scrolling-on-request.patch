--- a/Source/WebKit/UIProcess/API/glib/WebKitSettings.cpp
+++ b/Source/WebKit/UIProcess/API/glib/WebKitSettings.cpp
@@ -3944,6 +3944,19 @@ WebKitHardwareAccelerationPolicy webkit_
  *
  * Since: 2.16
  */
+// Wheel scrolling on the scrolling thread, as upstream has it with forced
+// compositing, unless WEBKIT_DISABLE_THREADED_SCROLLING=1 asks for the main
+// thread -- the way to compare the two on one machine.  A scrolling thread
+// that runs ahead of the main thread used to shake sticky and fixed headers,
+// because the compositor could take a set of layer positions half from the
+// main thread's flush and half from the scrolling tree; the positions are
+// now committed as one set (patch 0028).
+static bool settingsThreadedScrollingWanted()
+{
+    const char* value = getenv("WEBKIT_DISABLE_THREADED_SCROLLING");
+    return !value || !*value || !strcmp(value, "0");
+}
+
 void webkit_settings_set_hardware_acceleration_policy(WebKitSettings* settings, WebKitHardwareAccelerationPolicy policy)
 {
     g_return_if_fail(WEBKIT_IS_SETTINGS(settings));
@@ -3960,7 +3973,7 @@ void webkit_settings_set_hardware_accele
         }
         if (!priv->preferences->forceCompositingMode()) {
             priv->preferences->setForceCompositingMode(true);
-            priv->preferences->setThreadedScrollingEnabled(true);
+            priv->preferences->setThreadedScrollingEnabled(settingsThreadedScrollingWanted());
             changed = true;
         }
         break;

+// Wheel scrolling on the main thread, as scrollbar dragging always is, unless
+// WEBKIT_ENABLE_THREADED_SCROLLING=1.  The scrolling thread moves the page
+// ahead of the main thread, and a main thread that does not finish its
+// rendering update within half a frame lets sticky and fixed elements be
+// composited where the main thread last saw them: headers jump by the scroll
+// distance and back on every wheel step, while a scrollbar drag of the same
+// page stays steady.  Scrolling with the main thread keeps them in step.
+static bool settingsThreadedScrollingWanted()
+{
+    const char* value = getenv("WEBKIT_ENABLE_THREADED_SCROLLING");
+    return value && *value && strcmp(value, "0");
+}
+

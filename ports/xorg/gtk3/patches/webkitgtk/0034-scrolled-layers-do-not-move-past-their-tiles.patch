+
+void CoordinatedPlatformLayer::applyPositions(float fractionOfScrollingTreeLead)
+{
+    ASSERT(!isMainThread());
+    const auto& current = m_compositorPositions.current;
+    auto& layer = ensureTarget();
+    if (fractionOfScrollingTreeLead >= 1 || !m_compositorPositions.mainThread) {
+        layer.setPosition(current.position);
+        layer.setBoundsOrigin(current.boundsOrigin);
+        return;
+    }
+
+    const auto& mainThread = *m_compositorPositions.mainThread;
+    float behind = 1 - std::max(fractionOfScrollingTreeLead, 0.f);
+    auto back = [&](const FloatPoint& from, const FloatPoint& to) {
+        return FloatPoint(from.x() - behind * (from.x() - to.x()), from.y() - behind * (from.y() - to.y()));
+    };
+    layer.setPosition(back(current.position, mainThread.position));
+    layer.setBoundsOrigin(back(current.boundsOrigin, mainThread.boundsOrigin));
+}
+
+float CoordinatedPlatformLayer::scrollingTreeLead() const
+{
+    ASSERT(!isMainThread());
+    if (!m_compositorPositions.mainThread)
+        return 0;
+
+    const auto& current = m_compositorPositions.current;
+    const auto& mainThread = *m_compositorPositions.mainThread;
+    return std::max({ std::abs(current.position.x() - mainThread.position.x()), std::abs(current.position.y() - mainThread.position.y()),
+        std::abs(current.boundsOrigin.x() - mainThread.boundsOrigin.x()), std::abs(current.boundsOrigin.y() - mainThread.boundsOrigin.y()) });
 }
 

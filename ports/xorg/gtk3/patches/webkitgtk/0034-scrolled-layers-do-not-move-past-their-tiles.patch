+// Collects the layers that draw from a backing store whose tiles do not cover
+// all of what the surface rect shows of them, with the layer state as it is
+// now.  What a layer shows is found the way the layer flush finds the rect its
+// tiles are created for: the surface rect projected onto the layer's plane, its
+// ancestors' clips not taken into account.  So with the positions the tiles
+// were created for a layer is covered, and with positions that take it past
+// them -- the scrolling tree's, further on than the main thread has got -- not.
+void TextureMapperLayer::collectLayersWithUncoveredBackingStore(const FloatRect& surfaceRect, Vector<const TextureMapperLayer*>& layers) const
+{
+    collectLayersWithUncoveredBackingStoreRecursive(surfaceRect, { }, layers);
+}
+
+void TextureMapperLayer::collectLayersWithUncoveredBackingStoreRecursive(const FloatRect& surfaceRect, const TransformationMatrix& parentTransform, Vector<const TextureMapperLayer*>& layers) const
+{
+    // Neither the layer nor its descendants are painted then (paintRecursive()).
+    if (!isVisible())
+        return;
+
+    // As computeTransformsRecursive() computes combined and combinedForChildren.
+    const float originX = m_state.anchorPoint.x() * m_state.size.width();
+    const float originY = m_state.anchorPoint.y() * m_state.size.height();
+    TransformationMatrix combined = parentTransform;
+    combined
+        .translate3d(originX + (m_state.pos.x() - m_state.boundsOrigin.x()), originY + (m_state.pos.y() - m_state.boundsOrigin.y()), m_state.anchorPoint.z())
+        .multiply(m_layerTransforms.localTransform);
+    TransformationMatrix combinedForChildren = combined;
+    combined.translate3d(-originX, -originY, -m_state.anchorPoint.z());
+    if (!m_state.preserves3D)
+        combinedForChildren.flatten();
+    combinedForChildren.multiply(m_state.childrenTransform);
+    combinedForChildren.translate3d(-originX, -originY, -m_state.anchorPoint.z());
+
+    // A layer is given a backing store only while it draws content, which the
+    // coordinated layers do not pass on as drawsContent.
+    // As paintSelf() draws it: not with its back face turned and hidden.
+    bool showsBackingStore = m_backingStore && m_state.contentsVisible && m_state.visible;
+#if USE(COORDINATED_GRAPHICS)
+    // Tiles of a layer under a transform animation are created for where the
+    // animation takes it, not for where it is.
+    if (m_animatedBackingStoreClient)
+        showsBackingStore = false;
+#endif
+    if (showsBackingStore) {
+        if (auto inverse = combined.inverse()) {
+            FloatRect visibleRect = inverse->clampedBoundsOfProjectedQuad(FloatQuad(surfaceRect));
+            if (visibleRect.width() >= LayoutUnit::nearlyMax() || visibleRect.width() <= LayoutUnit::nearlyMin()) {
+                visibleRect.setX(0);
+                visibleRect.setWidth(m_state.size.width());
+            }
+            if (visibleRect.height() >= LayoutUnit::nearlyMax() || visibleRect.height() <= LayoutUnit::nearlyMin()) {
+                visibleRect.setY(0);
+                visibleRect.setHeight(m_state.size.height());
+            }
+            if (!m_backingStore->coversRect(visibleRect))
+                layers.append(this);
+        }
+    }
+
+    for (auto* child : m_children)
+        child->collectLayersWithUncoveredBackingStoreRecursive(surfaceRect, combinedForChildren, layers);
+}

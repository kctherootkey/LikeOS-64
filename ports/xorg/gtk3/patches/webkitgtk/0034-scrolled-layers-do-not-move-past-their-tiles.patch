+// Chooses the layer positions the frame is composited with, so that it never
+// shows a part of a layer its tiles do not cover.  The scrolling tree moves the
+// layers on its own, the main thread creates the tiles; when the scrolling tree
+// gets further than the tiles reach -- the main thread busy, the scroll fast --
+// the current positions would show the background in place of the page until a
+// rendering update brought the tiles.  The frame is then composited as far on
+// from the positions the main thread created the tiles for, towards the current
+// ones, as the tiles reach: the page stops where its tiles end, as it would if
+// the main thread scrolled it, and moves on as soon as tiles get there.  All
+// layers are moved by the same fraction of the scrolling tree's lead, so fixed
+// and sticky layers stay in place with the content.  A layer whose tiles do not
+// cover it at the main thread's positions either -- tiles still to be created,
+// a viewport being resized -- is left out of the comparison: holding the page
+// back cannot help it.
+void CoordinatedSceneState::applyCoveredLayerPositions(const FloatRect& surfaceRect, float deviceScaleFactor)
+{
+    ASSERT(!isMainRunLoop());
+    // The layers flushCompositingState() took, not a set committed since.
+    auto& layers = m_committedLayers;
+    auto& rootTarget = m_rootLayer->ensureTarget();
+    auto apply = [&](float fraction) {
+        m_rootLayer->applyPositions(fraction);
+        for (auto& layer : layers)
+            layer->applyPositions(fraction);
+    };
+
+    apply(1);
+    float lead = m_rootLayer->scrollingTreeLead();
+    for (auto& layer : layers)
+        lead = std::max(lead, layer->scrollingTreeLead());
+    if (!lead)
+        return;
+
+    Vector<const TextureMapperLayer*> uncoveredAtCurrentPositions;
+    rootTarget.collectLayersWithUncoveredBackingStore(surfaceRect, uncoveredAtCurrentPositions);
+    if (uncoveredAtCurrentPositions.isEmpty())
+        return;
+
+    apply(0);
+    Vector<const TextureMapperLayer*> uncoveredAtMainThreadPositions;
+    rootTarget.collectLayersWithUncoveredBackingStore(surfaceRect, uncoveredAtMainThreadPositions);
+    auto noneUncoveredButThoseAtMainThreadPositions = [&](const Vector<const TextureMapperLayer*>& uncovered) {
+        return std::ranges::all_of(uncovered, [&](auto* layer) {
+            return uncoveredAtMainThreadPositions.contains(layer);
+        });
+    };
+    if (noneUncoveredButThoseAtMainThreadPositions(uncoveredAtCurrentPositions)) {
+        apply(1);
+        return;
+    }
+
+    // On from the main thread's positions by the most whole device pixels of
+    // the largest lead that the tiles cover.  The largest lead is that of the
+    // content of the node being scrolled, so that content is held where its
+    // tiles end, the same from frame to frame as long as the tiles are, however
+    // far the scrolling tree gets meanwhile; fixed and sticky layers, moved on
+    // by the same fraction of their own lead, stay where they are relative to
+    // it.  (Whole pixels at a page scale of 1: the lead is in the layers' units.)
+    float leadInDevicePixels = lead * deviceScaleFactor;
+    auto fractionForPixelsOn = [&](unsigned pixels) {
+        return std::min(1.f, pixels / leadInDevicePixels);
+    };
+    auto covered = [&](unsigned pixels) {
+        apply(fractionForPixelsOn(pixels));
+        Vector<const TextureMapperLayer*> uncovered;
+        rootTarget.collectLayersWithUncoveredBackingStore(surfaceRect, uncovered);
+        return noneUncoveredButThoseAtMainThreadPositions(uncovered);
+    };
+    // Covered at 0 pixels on (the main thread's positions), not at the whole
+    // lead (the current ones, tested above).
+    unsigned coveredPixels = 0;
+    unsigned notCoveredPixels = std::ceil(leadInDevicePixels);
+    while (notCoveredPixels - coveredPixels > 1) {
+        unsigned pixels = coveredPixels + (notCoveredPixels - coveredPixels) / 2;
+        if (covered(pixels))
+            coveredPixels = pixels;
+        else
+            notCoveredPixels = pixels;
+    }
+    apply(fractionForPixelsOn(coveredPixels));
+}

+// The tiles of a backing store do not overlap, so they cover the part of the
+// rect the layer reaches when the parts of it they cover add up to all of it.
+// Counted in the scaled pixels the tiles were created in, where neighbouring
+// tiles share their edges exactly -- unscaled, at a fractional scale, their
+// float rects leave hairline gaps between them.
+bool CoordinatedBackingStore::coversRect(const FloatRect& rect) const
+{
+    // The tiles reach as far as the layer's whole pixels do
+    // (CoordinatedPlatformLayer::updateBackingStore()), not into a fraction
+    // of a pixel at its edge.
+    FloatRect layerPart = intersection(rect, FloatRect({ }, FloatSize(IntSize(m_size))));
+    if (layerPart.isEmpty())
+        return true;
+
+    // Every pixel whose center lies in the rect is drawn, so each of them
+    // has to be on a tile; rounding the edges to the nearest pixel boundary
+    // picks exactly those.
+    layerPart.scale(m_scale);
+    IntPoint minCorner(std::round(layerPart.x()), std::round(layerPart.y()));
+    IntPoint maxCorner(std::round(layerPart.maxX()), std::round(layerPart.maxY()));
+    IntRect needed(minCorner, maxCorner - minCorner);
+    if (needed.isEmpty())
+        return true;
+
+    uint64_t covered = 0;
+    for (const auto& tile : m_tiles.values()) {
+        if (!tile.canBePainted())
+            continue;
+        auto tilePart = intersection(tile.scaledRect(), needed);
+        covered += static_cast<uint64_t>(tilePart.width()) * tilePart.height();
+    }
+    return covered >= static_cast<uint64_t>(needed.width()) * needed.height();
+}

+++ b/src/session-child.c
@@ -13,9 +13,18 @@
 #include <grp.h>
 #include <glib.h>
 #include <security/pam_appl.h>
+#include <sys/mman.h>
+
+/* Login records (utmp, wtmp, btmp) where the C library keeps them; LikeOS's
+   has no utmp database. */
+#ifndef __LIKEOS__
+#define WITH_UTMP 1
+#endif
+
+#ifdef WITH_UTMP
 #include <utmp.h>
 #include <utmpx.h>
-#include <sys/mman.h>
+#endif
 

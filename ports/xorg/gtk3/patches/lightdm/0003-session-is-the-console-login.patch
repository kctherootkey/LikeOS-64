+#ifdef __LIKEOS__
+static void
+write_error (const char *message)
+{
+    /* Async-signal-safe: this runs in the forked session process */
+    ssize_t unused = write (STDERR_FILENO, message, strlen (message));
+    (void) unused;
+}
+
+/* Make the session process that is about to run the session the login at
+   the console, the way a console login is: the kernel's console user -- to
+   whom the seat's devices are granted (the GPU render node), whom the
+   device manager mounts drives for and who may power the machine off -- is
+   the leader of the session whose controlling terminal is the console,
+   when it is a recorded login of the user it runs as.
+
+   Called as root, in the new session (after setsid(), which ends the login
+   a privileged process belonged to), before changing to the user:
+
+     - write the user's uid to /proc/self/loginuid, which makes this
+       process, and everything it starts, that user's login;
+     - make the console the controlling terminal, taking it from the
+       session that had it, if any (it is the display manager's seat). */
+static void
+take_console (uid_t uid)
+{
+    char buf[16];
+    int n = 0;
+    unsigned int v = uid;
+
+    /* The uid in decimal, without stdio */
+    char digits[16];
+    int nd = 0;
+    do
+    {
+        digits[nd++] = '0' + v % 10;
+        v /= 10;
+    } while (v && nd < (int) sizeof (digits));
+    while (nd > 0)
+        buf[n++] = digits[--nd];
+
+    int fd = open ("/proc/self/loginuid", O_WRONLY | O_CLOEXEC);
+    if (fd >= 0)
+    {
+        if (write (fd, buf, n) != n)
+            write_error ("Failed to record the login in /proc/self/loginuid\n");
+        close (fd);
+    }
+    else if (errno != ENOENT)
+        write_error ("Failed to open /proc/self/loginuid\n");
+
+    fd = open ("/dev/console", O_RDWR | O_CLOEXEC);
+    if (fd < 0)
+    {
+        write_error ("Failed to open /dev/console\n");
+        return;
+    }
+    if (ioctl (fd, TIOCSCTTY, 1) < 0)
+        write_error ("Failed to make /dev/console the controlling terminal\n");
+    close (fd);
+}
+#endif
+

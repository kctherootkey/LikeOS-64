+/* The drag holds the pointer until it ends, so the button release that
+ * on_button_release() waits for to end the dragging state never reaches
+ * the desktop: the dragged items -- not drawn while they are dragged --
+ * stayed invisible after the drop until the next click. */
+static void on_drag_end (GtkWidget *widget, GdkDragContext *drag_context)
+{
+    FmDesktop *desktop = FM_DESKTOP(widget);
+
+    if (desktop->dragging)
+    {
+        desktop->dragging = FALSE;
+        queue_layout_items(desktop);
+    }
+}

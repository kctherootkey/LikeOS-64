--- a/src/desktop.c
+++ b/src/desktop.c
@@ -2897,13 +2897,51 @@
     gtk_ui_manager_add_ui_from_string(ui, desktop_icon_menu_xml, -1, NULL);
 }
 
+/* Folders opened from the desktop go to the system's file manager: the
+ * application set as the default for inode/directory (mimeapps.list), the
+ * same one every other program opens a folder with.  PCManFM's own window
+ * is used only when that default is PCManFM itself, when none is set, or
+ * when it could not be started -- the desktop stays PCManFM's either way.
+ */
+static gboolean desktop_open_folder(GAppLaunchContext* ctx, GList* folder_infos,
+                                    gpointer user_data, GError** err)
+{
+    GAppInfo *app = g_app_info_get_default_for_type("inode/directory", FALSE);
+
+    if(app && g_strcmp0(g_app_info_get_id(app), "pcmanfm.desktop") != 0)
+    {
+        GList *uris = NULL, *l;
+        gboolean ok;
+
+        for(l = folder_infos; l; l = l->next)
+            uris = g_list_append(uris,
+                        fm_path_to_uri(fm_file_info_get_path((FmFileInfo*)l->data)));
+        ok = g_app_info_launch_uris(app, uris, ctx, NULL);
+        g_list_free_full(uris, g_free);
+        g_object_unref(app);
+        if(ok)
+            return TRUE;
+    }
+    else if(app)
+        g_object_unref(app);
+    return pcmanfm_open_folder(ctx, folder_infos, user_data, err);
+}
+
+/* One desktop item's folder, through desktop_open_folder(). */
+static void desktop_open_focus(FmDesktop* desktop)
+{
+    GList one = { desktop->focus->fi, NULL, NULL };
+
+    desktop_open_folder(NULL, &one, desktop, NULL);
+}
+
 /* folder options work only with single folder - see above */

--- a/src/desktop.c
+++ b/src/desktop.c
@@ -192,6 +192,21 @@
         desktop_signal_wm(SIGTERM);
 }
 
+/* The resolution dialog (likeos-display-settings): the sizes the screen can
+ * be set to, set at once or saved for the next start.
+ */
+static void on_display_settings(GtkAction* act, gpointer user_data)
+{
+    char *argv[] = { (char *)"/usr/bin/likeos-display-settings", NULL };
+    GError *err = NULL;
+
+    if(!g_spawn_async(NULL, argv, NULL, G_SPAWN_DEFAULT, NULL, NULL, NULL, &err))
+    {
+        fm_show_error(GTK_WINDOW(user_data), NULL, err->message);
+        g_error_free(err);
+    }
+}
+
 /* insert GtkUIManager XML definitions */
 #include "desktop-ui.c"
 
--- a/src/desktop-ui.c
+++ b/src/desktop-ui.c
@@ -27,6 +27,7 @@
 "<popup>"
   "<placeholder name='CustomCommonOps'>"

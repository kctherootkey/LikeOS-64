     "<separator/>"
     "<menuitem action='WMRestart'/>"
     "<menuitem action='WMQuit'/>"
@@ -36,6 +37,7 @@
 static const GtkActionEntry desktop_actions[]=
 {
     {"DeskPref", GTK_STOCK_PROPERTIES, N_("Desktop Preferences"), "", NULL, G_CALLBACK(fm_desktop_preference)},
+    {"DisplaySettings", "preferences-desktop-display", N_("Display settings"), "", NULL, G_CALLBACK(on_display_settings)},
     {"WMRestart", GTK_STOCK_REFRESH, N_("Restart session"), "", NULL, G_CALLBACK(on_wm_restart)},
     {"WMQuit", GTK_STOCK_QUIT, N_("Exit session"), "", NULL, G_CALLBACK(on_wm_quit)}
 };

@@ -644,6 +644,10 @@
     cfg->folder = g_key_file_get_string(kf, group, "folder", NULL);
 
     fm_key_file_get_bool(kf, group, "show_wm_menu", &cfg->show_wm_menu);
+    fm_key_file_get_int(kf, group, "reserve_top", &cfg->reserve_top);
+    fm_key_file_get_int(kf, group, "reserve_bottom", &cfg->reserve_bottom);
+    fm_key_file_get_int(kf, group, "reserve_left", &cfg->reserve_left);
+    fm_key_file_get_int(kf, group, "reserve_right", &cfg->reserve_right);
     _parse_sort(kf, group, &cfg->desktop_sort_type, &cfg->desktop_sort_by);
 #if FM_CHECK_VERSION(1, 2, 0)
     fm_key_file_get_bool(kf, group, "show_documents", &cfg->show_documents);
@@ -1064,6 +1068,10 @@
     if(cfg->folder)
         g_string_append_printf(buf, "folder=%s\n", cfg->folder);
     g_string_append_printf(buf, "show_wm_menu=%d\n", cfg->show_wm_menu);
+    g_string_append_printf(buf, "reserve_top=%d\n", cfg->reserve_top);
+    g_string_append_printf(buf, "reserve_bottom=%d\n", cfg->reserve_bottom);
+    g_string_append_printf(buf, "reserve_left=%d\n", cfg->reserve_left);

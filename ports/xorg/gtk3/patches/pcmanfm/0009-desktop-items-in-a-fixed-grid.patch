+/* A rounded rectangle path, inset half a pixel when `stroke' so a one-pixel
+ * line falls on whole pixels. */
+static void desktop_round_rect(cairo_t *cr, const GdkRectangle *r, double radius, gboolean stroke)
+{
+    double x = r->x, y = r->y, w = r->width, h = r->height;
+
+    if (stroke)
+    {
+        x += 0.5;
+        y += 0.5;
+        w -= 1;
+        h -= 1;
+        radius -= 0.5;
+    }
+    cairo_new_sub_path(cr);
+    cairo_arc(cr, x + w - radius, y + radius, radius, -G_PI / 2, 0);
+    cairo_arc(cr, x + w - radius, y + h - radius, radius, 0, G_PI / 2);
+    cairo_arc(cr, x + radius, y + h - radius, radius, G_PI / 2, G_PI);
+    cairo_arc(cr, x + radius, y + radius, radius, G_PI, 3 * G_PI / 2);
+    cairo_close_path(cr);
+}
+
+/* The mark of a shortcut: a small disc in the LikeOS accent, ringed in
+ * white so it stands off any icon, with a white arrow pointing up and to the
+ * right -- over the bottom-right corner of the icon, in place of libfm's
+ * black arrow in the top-left one.  (x, y) is the disc's top-left corner. */
+static void paint_link_mark(cairo_t *cr, double x, double y)
+{
+    const double r = 7, cx = x + r, cy = y + r;
+
+    cairo_save(cr);
+    cairo_new_sub_path(cr);
+    cairo_arc(cr, cx, cy, r, 0, 2 * G_PI);
+    cairo_set_source_rgb(cr, 1, 1, 1);
+    cairo_fill(cr);
+    cairo_new_sub_path(cr);
+    cairo_arc(cr, cx, cy, r - 1.25, 0, 2 * G_PI);
+    cairo_set_source_rgb(cr, 0x3f / 255.0, 0x74 / 255.0, 0xf2 / 255.0);
+    cairo_fill(cr);
+
+    cairo_set_source_rgb(cr, 1, 1, 1);
+    cairo_set_line_width(cr, 1.5);
+    cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND);
+    cairo_set_line_join(cr, CAIRO_LINE_JOIN_ROUND);
+    cairo_move_to(cr, cx - 2.5, cy + 2.5);
+    cairo_line_to(cr, cx + 2.5, cy - 2.5);
+    cairo_move_to(cr, cx - 1.25, cy - 2.5);
+    cairo_line_to(cr, cx + 2.5, cy - 2.5);
+    cairo_line_to(cr, cx + 2.5, cy + 1.25);
+    cairo_stroke(cr);
+    cairo_restore(cr);
+}

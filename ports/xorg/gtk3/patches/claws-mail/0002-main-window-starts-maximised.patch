 	 NULL, NULL, NULL},
-	{"mainwin_maximised", "FALSE", &prefs_common.mainwin_maximised, P_BOOL,
+	/* LikeOS: the main window starts maximised until the user restores it. */
+	{"mainwin_maximised", "TRUE", &prefs_common.mainwin_maximised, P_BOOL,
 	 NULL, NULL, NULL},
 	{"mainwin_fullscreen", "FALSE", &prefs_common.mainwin_fullscreen, P_BOOL,
 	 NULL, NULL, NULL},

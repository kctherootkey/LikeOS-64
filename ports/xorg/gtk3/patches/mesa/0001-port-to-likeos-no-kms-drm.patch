+/*  SPDX-License-Identifier: MIT */
+
+/* Stubs for the dri2 entry points on builds without dri2.
+ *
+ * dri2.c is only compiled where a DRM display system exists, but libEGL and
+ * libGL reference its PUBLIC entry points unconditionally -- damage
+ * regions, DMA-BUF image creation, GL interop, the shader blob cache.  A
+ * software-only system (gallium drivers llvmpipe/softpipe over drisw, no
+ * KMS/DRM anywhere) therefore could not link them.  Exactly the situation
+ * kopper_stubs.c already solves for a build without the vulkan swrast:
+ * every entry answers "not supported" in its interface's own vocabulary,
+ * and the callers all have the corresponding failure path because real
+ * drivers may refuse these requests too.
+ */
+
+#include "dri_screen.h"
+#include "dri_drawable.h"
+#include "dri_util.h"
+#include "GL/mesa_glinterop.h"
+
+struct pipe_screen *
+dri2_init_screen(struct dri_screen *screen, bool driver_name_is_inferred)
+{
+   return NULL;
+}
+
+struct pipe_screen *
+dri_swrast_kms_init_screen(struct dri_screen *screen,
+                           bool driver_name_is_inferred)
+{
+   return NULL;
+}
+
+void
+dri2_init_drawable(struct dri_drawable *drawable, bool isPixmap,
+                   int alphaBits)
+{
+}
+
+/* Declared locally by its caller (drisw.c does the same); no header
+ * carries it. */
+extern bool
+dri_image_drawable_get_buffers(struct dri_drawable *drawable,
+                               struct __DRIimageList *images,
+                               const enum st_attachment_type *statts,
+                               unsigned statts_count);
+
+bool
+dri_image_drawable_get_buffers(struct dri_drawable *drawable,
+                               struct __DRIimageList *images,
+                               const enum st_attachment_type *statts,
+                               unsigned statts_count)

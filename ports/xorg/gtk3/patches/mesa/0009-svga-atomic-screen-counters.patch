diff -Nur a/src/gallium/drivers/svga/svga_resource_buffer.c b/src/gallium/drivers/svga/svga_resource_buffer.c
--- a/src/gallium/drivers/svga/svga_resource_buffer.c
+++ b/src/gallium/drivers/svga/svga_resource_buffer.c
@@ -422,10 +422,12 @@
 
       pipe_resource_reference(&sbuf->translated_indices.buffer, NULL);
 
-      ss->hud.total_resource_bytes -= sbuf->size;
-      assert(ss->hud.num_resources > 0);
-      if (ss->hud.num_resources > 0)
-         ss->hud.num_resources--;
+      p_atomic_add(&ss->hud.total_resource_bytes, -(int64_t)sbuf->size);
+      {
+         ASSERTED uint64_t remaining =
+            p_atomic_dec_return(&ss->hud.num_resources);
+         assert(remaining != UINT64_MAX);
+      }
 
       FREE(sbuf);
    } else {
@@ -448,16 +450,18 @@
       if (tex->backed_handle)
          svga_screen_surface_destroy(ss, &tex->backed_key, to_invalidate, &tex->backed_handle);
 
-      ss->hud.total_resource_bytes -= tex->size;
+      p_atomic_add(&ss->hud.total_resource_bytes, -(int64_t)tex->size);
 
       FREE(tex->defined);
       FREE(tex->rendered_to);
       FREE(tex->dirty);
       FREE(tex);
 
-      assert(ss->hud.num_resources > 0);
-      if (ss->hud.num_resources > 0)
-         ss->hud.num_resources--;
+      {
+         ASSERTED uint64_t remaining =
+            p_atomic_dec_return(&ss->hud.num_resources);
+         assert(remaining != UINT64_MAX);
+      }
    }
 }
 
@@ -542,9 +546,9 @@
 
    sbuf->bind_flags = bind_flags;
    sbuf->size = util_resource_size(&sbuf->b);
-   ss->hud.total_resource_bytes += sbuf->size;
+   p_atomic_add(&ss->hud.total_resource_bytes, sbuf->size);
 
-   ss->hud.num_resources++;
+   p_atomic_inc(&ss->hud.num_resources);
    SVGA_STATS_TIME_POP(ss->sws);
 
    return &sbuf->b;
@@ -587,7 +591,7 @@
    debug_reference(&sbuf->b.reference,
                    (debug_reference_descriptor)debug_describe_resource, 0);
 
-   ss->hud.num_resources++;
+   p_atomic_inc(&ss->hud.num_resources);
 
    return &sbuf->b;
 
diff -Nur a/src/gallium/drivers/svga/svga_resource.c b/src/gallium/drivers/svga/svga_resource.c
--- a/src/gallium/drivers/svga/svga_resource.c
+++ b/src/gallium/drivers/svga/svga_resource.c
@@ -7,6 +7,7 @@
 
 #include <inttypes.h>
 #include "util/u_debug.h"
+#include "util/u_atomic.h"
 
 #include "svga_resource.h"
 #include "svga_resource_buffer.h"
@@ -33,7 +34,7 @@
 
    if (!r) {
       struct svga_screen *svgascreen = svga_screen(screen);
-      svgascreen->hud.num_failed_allocations++;
+      p_atomic_inc(&svgascreen->hud.num_failed_allocations);
    }
 
    return r;

diff -Nur a/src/gallium/drivers/svga/svga_screen.h b/src/gallium/drivers/svga/svga_screen.h
--- a/src/gallium/drivers/svga/svga_screen.h
+++ b/src/gallium/drivers/svga/svga_screen.h
@@ -73,7 +73,9 @@
 
    struct svga_host_surface_cache cache;
 
-   /** HUD counters */
+   /** HUD counters.  Every context of this screen -- on whatever thread it
+    * runs -- creates and destroys resources, so they are only ever changed
+    * with p_atomic_*. */
    struct {
       /** Memory used by all resources (buffers and surfaces) */
       uint64_t total_resource_bytes;

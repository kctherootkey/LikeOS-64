+/**
+ * Send every constant buffer binding again in full, on the next state
+ * update.
+ *
+ * A device may copy a binding's data out of the buffer when the binding
+ * command arrives, into storage of its own that it recycles as later
+ * bindings arrive.  VirtualBox's does: into a ring of 512 KB buffers that
+ * it hands out again as soon as the GPU has finished with them -- whether
+ * or not a binding still points into one.  A stage whose constants stay
+ * the same is bound once and never again, while another stage's per-draw
+ * offset change (one SET_*_CONSTANT_BUFFER_OFFSET per draw, each a fresh
+ * copy) keeps filling the ring.  Once the ring has come round, the
+ * unchanged stage reads whatever was copied there since: a compositor's
+ * pixel shader takes another draw's vertex transform for its colour
+ * matrix, and the page turns yellow or pink until its constants happen to
+ * change.
+ *
+ * A copy is overwritten only after the rest of its buffer and the whole
+ * of the next one have been filled.  Sending every binding again once
+ * half a buffer's worth has been copied keeps every live binding's copy
+ * newer than that.  Clearing the offset shortcut makes each stage send a
+ * full SetSingleConstantBuffer, which such a device copies anew; a device
+ * that reads bindings at draw time merely sees the same binding again.
+ */
+void
+svga_resend_constbufs(struct svga_context *svga)
+{
+   for (unsigned shader = 0; shader < MESA_SHADER_STAGES; shader++) {
+      for (unsigned slot = 0; slot < SVGA_MAX_CONST_BUFS; slot++)
+         svga->state.hw_draw.constbufoffsets[shader][slot].handle = NULL;
+   }
+
+   svga->dirty |= SVGA_NEW_VS_CONSTS | SVGA_NEW_FS_CONSTS |
+                  SVGA_NEW_GS_CONSTS | SVGA_NEW_TCS_CONSTS |
+                  SVGA_NEW_TES_CONSTS | SVGA_NEW_CS_CONSTS |
+                  SVGA_NEW_CONST_BUFFER;
+
+   svga->state.hw_draw.constbuf_fetched_bytes = 0;
+}
+
+
 /* For constbuf 0 */
 static enum pipe_error
 emit_consts_vgpu10(struct svga_context *svga, mesa_shader_stage shader)

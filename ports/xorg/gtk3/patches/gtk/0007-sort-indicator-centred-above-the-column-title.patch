   hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 2);
+  /* The sort indicator is a small chevron centred at the top edge of the
+   * header, above the title, where the theme expects it: an overlay over
+   * the title's row, so it takes no width from the title and the titles of

+  gtk_image_set_pixel_size (GTK_IMAGE (priv->arrow), 12);
+  gtk_widget_set_halign (priv->arrow, GTK_ALIGN_CENTER);
+  gtk_widget_set_valign (priv->arrow, GTK_ALIGN_START);
+  gtk_style_context_add_class (gtk_widget_get_style_context (priv->arrow),
+                               "sort-indicator");
 
   if (priv->child)
     child = priv->child;

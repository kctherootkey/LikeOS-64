+/* A picture for a window that cannot be blended: every pixel at least
+ * half opaque becomes its own colour at full opacity, every other pixel
+ * fully transparent, so the window can take the picture's shape
+ * (`*shape', in the window's coordinates) and show nothing of its
+ * background.  The result starts at the corner of `extents', which is
+ * the window's (0, 0). */
+static cairo_surface_t *
+gtk_drag_icon_solid (cairo_surface_t *surface,
+                     GdkRectangle    *extents,
+                     cairo_region_t **shape)
+{
+  cairo_surface_t *solid;
+  cairo_t *cr;
+  double sx, sy;
+  int width, height, stride;
+  guchar *data;
+
+  cairo_surface_get_device_scale (surface, &sx, &sy);
+  width = MAX (1, (int) ceil (extents->width * sx));
+  height = MAX (1, (int) ceil (extents->height * sy));
+  solid = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, width, height);
+  cairo_surface_set_device_scale (solid, sx, sy);
+  cr = cairo_create (solid);
+  cairo_set_source_surface (cr, surface, -extents->x, -extents->y);
+  cairo_paint (cr);
+  cairo_destroy (cr);
+
+  cairo_surface_flush (solid);
+  data = cairo_image_surface_get_data (solid);
+  stride = cairo_image_surface_get_stride (solid);
+  for (int y = 0; y < height; y++)
+    {
+      guint32 *row = (guint32 *) (data + y * stride);
+
+      for (int x = 0; x < width; x++)
+        {
+          guint32 p = row[x], a = p >> 24;
+
+          if (a < 128)
+            row[x] = 0;
+          else if (a < 255)
+            row[x] = 0xff000000 |
+                     MIN (255, (((p >> 16) & 0xff) * 255 + a / 2) / a) << 16 |
+                     MIN (255, (((p >> 8) & 0xff) * 255 + a / 2) / a) << 8 |
+                     MIN (255, ((p & 0xff) * 255 + a / 2) / a);
+        }
+    }
+  cairo_surface_mark_dirty (solid);
+
+  *shape = gdk_cairo_region_create_from_surface (solid);
+  return solid;
+}

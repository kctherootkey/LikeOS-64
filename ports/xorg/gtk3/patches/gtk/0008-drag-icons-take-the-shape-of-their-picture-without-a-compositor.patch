+/* Whether a window on the drag's screen can be partly transparent: it
+ * needs a visual with alpha and a compositing manager that blends it. */
+static gboolean
+gtk_drag_can_blend (GdkDragContext *context)
+{
+  GdkScreen *screen = gdk_window_get_screen (gdk_drag_context_get_source_window (context));
+
+  return gdk_screen_get_rgba_visual (screen) != NULL &&
+         gdk_screen_is_composited (screen);
+}
+
+/* The icon a definition names, as a picture at the drag icon size, with
+ * the hot spot at its (0, 0); NULL if there is none. */
+static cairo_surface_t *
+gtk_drag_icon_picture (GdkDragContext     *context,
+                       GtkImageDefinition *def,
+                       gint                hot_x,
+                       gint                hot_y)
+{
+  GdkWindow *source = gdk_drag_context_get_source_window (context);
+  int scale = source ? gdk_window_get_scale_factor (source) : 1;
+  GtkWidget *owner = g_object_ref_sink (gtk_image_new ());
+  GtkIconHelper *helper;
+  cairo_surface_t *surface;
+  double sx, sy;
+
+  helper = gtk_icon_helper_new (gtk_widget_get_css_node (owner), owner);
+  _gtk_icon_helper_set_definition (helper, def);
+  _gtk_icon_helper_set_icon_size (helper, GTK_ICON_SIZE_DND);
+  surface = gtk_icon_helper_load_surface (helper, scale);
+  g_object_unref (helper);
+  gtk_widget_destroy (owner);
+  g_object_unref (owner);
+  if (surface)
+    {
+      cairo_surface_get_device_scale (surface, &sx, &sy);
+      cairo_surface_set_device_offset (surface, -hot_x * sx, -hot_y * sy);
+    }
+  return surface;
+}

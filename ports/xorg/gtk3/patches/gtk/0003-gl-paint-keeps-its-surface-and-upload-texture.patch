+/*
+ * gdk_gl_context_upload_subtexture:
+ * @context: a #GdkGLContext
+ * @image_surface: an image surface
+ * @x: where the image lands in the texture, in texels
+ * @y: likewise
+ * @width: the image's width
+ * @height: the image's height
+ * @texture_target: the bound texture target
+ *
+ * gdk_gl_context_upload_texture() for a texture whose storage already
+ * exists: @image_surface lands at (@x, @y) of the texture bound to
+ * @texture_target, with the same pixel-format handling.
+ */
+void
+gdk_gl_context_upload_subtexture (GdkGLContext    *context,
+                                  cairo_surface_t *image_surface,
+                                  int              x,
+                                  int              y,
+                                  int              width,
+                                  int              height,
+                                  guint            texture_target)
+{
+  GdkGLContextPrivate *priv = gdk_gl_context_get_instance_private (context);
+  GLvoid *data;
+  int stride;
+  GLenum format, type;
+
+  g_return_if_fail (GDK_IS_GL_CONTEXT (context));
+
+  data = cairo_image_surface_get_data (image_surface);
+  stride = cairo_image_surface_get_stride (image_surface);
+
+  if (priv->use_es)
+    {
+      format = GL_RGBA;
+      type = GL_UNSIGNED_BYTE;
+    }
+  else
+    {
+      format = GL_BGRA;
+      type = GL_UNSIGNED_INT_8_8_8_8_REV;
+    }
+
+  /* GL_UNPACK_ROW_LENGTH is available on desktop GL, OpenGL ES >= 3.0, or if
+   * the GL_EXT_unpack_subimage extension for OpenGL ES 2.0 is available
+   */
+  if (!priv->use_es ||
+      (priv->use_es && (priv->gl_version >= 30 || priv->has_unpack_subimage)))
+    {
+      glPixelStorei (GL_UNPACK_ALIGNMENT, 4);
+      glPixelStorei (GL_UNPACK_ROW_LENGTH, stride / 4);
+      glTexSubImage2D (texture_target, 0, x, y, width, height, format, type, data);
+      glPixelStorei (GL_UNPACK_ROW_LENGTH, 0);
+    }
+  else
+    {
+      int i;
+
+      for (i = 0; i < height; i++)
+        glTexSubImage2D (texture_target, 0, x, y + i, width, 1, format, type,
+                         (unsigned char *) data + (i * stride));
+    }
+}

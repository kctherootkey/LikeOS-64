+/*
+ * gdk_gl_context_ref_paint_surface:
+ * @context: a #GdkGLContext
+ * @width: the surface's width, in device pixels
+ * @height: the surface's height, in device pixels
+ *
+ * The memory surface for the cairo half of a GL paint (see
+ * gdk_gl_context_set_image_paint_surface()), held by the context and
+ * handed out again for every frame that wants the same size.
+ *
+ * A surface for a window of any real size is several megabytes, which is
+ * above what a C library serves from its heap: allocated per frame it
+ * arrived as fresh pages, every one of them faulted in as the paint
+ * touched it, and went back to the kernel at the end of the paint with
+ * the invalidation of every other processor's translations that an unmap
+ * carries -- per frame, for as long as the window kept repainting, and
+ * in proportion to its area.  Nothing of the previous frame is ever read:
+ * a paint clears the region it is about to draw before drawing it.
+ *
+ * Returns: (transfer full): the surface, with a reference for the caller
+ */
+cairo_surface_t *
+gdk_gl_context_ref_paint_surface (GdkGLContext *context,
+                                  int           width,
+                                  int           height)
+{
+  GdkGLContextPrivate *priv = gdk_gl_context_get_instance_private (context);
+
+  g_return_val_if_fail (GDK_IS_GL_CONTEXT (context), NULL);
+
+  width = MAX (width, 1);
+  height = MAX (height, 1);
+
+  if (priv->paint_surface != NULL &&
+      (priv->paint_surface_width != width ||
+       priv->paint_surface_height != height ||
+       cairo_surface_status (priv->paint_surface) != CAIRO_STATUS_SUCCESS))
+    g_clear_pointer (&priv->paint_surface, cairo_surface_destroy);
+
+  if (priv->paint_surface == NULL)
+    {
+      priv->paint_surface = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, width, height);
+      priv->paint_surface_width = width;
+      priv->paint_surface_height = height;
+    }
+
+  return cairo_surface_reference (priv->paint_surface);
+}

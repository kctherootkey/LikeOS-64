--- a/gtk/gtkmain.c
+++ b/gtk/gtkmain.c
@@ -1869,12 +1869,17 @@
       if (gtk_invoke_key_snoopers (grab_widget, event))
         break;
 
-      /* make focus visible in a window that receives a key event */
+      /* make focus visible in a window that receives a key event --
+       * other than a modifier on its own: Alt, Shift, Control or Super
+       * pressed and let go moves nothing, and the press of Alt that
+       * starts Alt+Tab reaches the focused window before the switcher
+       * sees the Tab
+       */
       {
         GtkWidget *window;
 
         window = gtk_widget_get_toplevel (grab_widget);
-        if (GTK_IS_WINDOW (window))
+        if (GTK_IS_WINDOW (window) && !event->key.is_modifier)
           gtk_window_set_focus_visible (GTK_WINDOW (window), TRUE);
       }
 

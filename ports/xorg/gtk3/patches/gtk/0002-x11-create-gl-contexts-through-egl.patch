+
+/* ---- EGL --------------------------------------------------------------------
+ *
+ * Why this backend creates its contexts through EGL where it can, and through
+ * GLX only when it cannot.
+ *
+ * A context GDK creates is what a program draws into a GdkWindow with, and --
+ * through gdk_cairo_draw_from_gl() -- what it composites GL textures of its own
+ * into.  A program whose picture is produced elsewhere, in another process,
+ * hands each frame over as a dma-buf descriptor, and the only way to show such
+ * a frame without copying it is to import it as an EGLImage and bind that to a
+ * texture in the toolkit's own context.  That works only if the toolkit's
+ * context is an EGL context on the EGLDisplay the image was created on.  A GLX
+ * context cannot take an EGLImage at all, so under GLX the program is left to
+ * map the buffer and copy it through the processor, once per frame, at the
+ * full size of the window.  (A web engine's user-interface process is exactly
+ * such a program; its rendering process draws the page and sends descriptors.)
+ *
+ * The Wayland and Windows backends already create their contexts through EGL.
+ * This is the same arrangement for X11, modelled on gdkglcontext-wayland.c.
+ * What is X11-specific:
+ *
+ *   - the display is an EGL display on the Xlib connection;
+ *   - an X window IS an EGL native window, so there is no intermediate object
+ *     to create or resize (Wayland needs wl_egl_window; this needs nothing);
+ *   - config selection has to name a config whose native visual is the
+ *     window's own.  EGL puts a surface on a window only from such a config,
+ *     and eglChooseConfig() ignores the attribute when selecting, so the
+ *     configs are enumerated and matched by hand.
+ *
+ * GDK_GL=glx forces the GLX path for a session.  A display is one or the
+ * other for its whole life; the two are never mixed.
+ */
+
+/* The EGL 1.5 / EXT platform entry points, fetched by name: the header may
+ * declare them, the library at run time may still not have them. */
+typedef EGLDisplay (EGLAPIENTRY *GdkEglGetPlatformDisplayFunc)         (EGLenum, void *, const EGLAttrib *);
+typedef EGLDisplay (EGLAPIENTRY *GdkEglGetPlatformDisplayEXTFunc)      (EGLenum, void *, const EGLint *);
+typedef EGLSurface (EGLAPIENTRY *GdkEglCreatePlatformWindowSurfaceFunc)    (EGLDisplay, EGLConfig, void *, const EGLAttrib *);
+typedef EGLSurface (EGLAPIENTRY *GdkEglCreatePlatformWindowSurfaceEXTFunc) (EGLDisplay, EGLConfig, void *, const EGLint *);
+
+typedef struct {
+  GdkDisplay *display;
+
+  /* The window's own surface: what an attached context draws to. */
+  EGLSurface egl_surface;
+
+  /* Where the implementation cannot make a context current without a
+   * surface, an unattached context gets a 1x1 window of its own, the way
+   * the GLX path does. */
+  Window dummy_xwin;
+  EGLSurface dummy_surface;
+} EglDrawableInfo;
+
+static void
+egl_drawable_info_free (gpointer data_)
+{
+  EglDrawableInfo *data = data_;
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (data->display);
+  EGLDisplay edpy = display_x11->egl_display;
+  Display *dpy = gdk_x11_display_get_xdisplay (data->display);
+
+  /* A surface still current to a context is released by EGL when that
+   * context lets go of it -- the rule, not a hazard. */
+  if (data->egl_surface != EGL_NO_SURFACE)
+    eglDestroySurface (edpy, data->egl_surface);
+  if (data->dummy_surface != EGL_NO_SURFACE)
+    eglDestroySurface (edpy, data->dummy_surface);
+
+  if (data->dummy_xwin != None)
+    {
+      gdk_x11_display_error_trap_push (data->display);
+      XDestroyWindow (dpy, data->dummy_xwin);
+      gdk_x11_display_error_trap_pop_ignored (data->display);
+    }
+
+  g_slice_free (EglDrawableInfo, data);
+}
+
+static EglDrawableInfo *
+get_egl_drawable_info (GdkWindow *window)
+{
+  return g_object_get_data (G_OBJECT (window), "-gdk-x11-window-egl-info");
+}
+
+static void
+set_egl_drawable_info (GdkWindow       *window,
+                       EglDrawableInfo *info)
+{
+  g_object_set_data_full (G_OBJECT (window), "-gdk-x11-window-egl-info",
+                          info, egl_drawable_info_free);
+}
+
+/* Obtain the EGL display for the Xlib connection.  The platform entry
+ * points say WHAT KIND of native display is being handed over; the legacy
+ * one guesses from the pointer.  Preferred where they exist, and which one
+ * answered is recorded, because the matching surface entry point takes the
+ * native window differently (see egl_create_window_surface). */
+static EGLDisplay
+gdk_x11_get_egl_display (GdkX11Display *display_x11,
+                         gint          *platform_out)
+{
+  Display *dpy = gdk_x11_display_get_xdisplay (GDK_DISPLAY (display_x11));
+  EGLDisplay edpy;
+
+  if (epoxy_has_egl_extension (NULL, "EGL_KHR_platform_x11"))
+    {
+      GdkEglGetPlatformDisplayFunc get =
+        (GdkEglGetPlatformDisplayFunc) eglGetProcAddress ("eglGetPlatformDisplay");
+
+      if (get != NULL)
+        {
+          edpy = get (EGL_PLATFORM_X11_KHR, dpy, NULL);
+          if (edpy != EGL_NO_DISPLAY)
+            {
+              *platform_out = GDK_X11_EGL_PLATFORM_KHR;
+              return edpy;
+            }
+        }
+    }
+
+  if (epoxy_has_egl_extension (NULL, "EGL_EXT_platform_x11"))
+    {
+      GdkEglGetPlatformDisplayEXTFunc get =
+        (GdkEglGetPlatformDisplayEXTFunc) eglGetProcAddress ("eglGetPlatformDisplayEXT");
+
+      if (get != NULL)
+        {
+          edpy = get (EGL_PLATFORM_X11_EXT, dpy, NULL);
+          if (edpy != EGL_NO_DISPLAY)
+            {
+              *platform_out = GDK_X11_EGL_PLATFORM_EXT;
+              return edpy;
+            }
+        }
+    }
+
+  *platform_out = GDK_X11_EGL_PLATFORM_NONE;
+  return eglGetDisplay ((EGLNativeDisplayType) dpy);
+}
+
+/* Put an EGL window surface on an X window.  Through a platform entry point
+ * the native window is passed BY ADDRESS -- the platform extensions define
+ * it as a pointer to the Window -- and through the legacy one by value. */
+static EGLSurface
+egl_create_window_surface (GdkX11Display *display_x11,
+                           EGLConfig      config,
+                           Window         xwindow)
+{
+  EGLDisplay edpy = display_x11->egl_display;
+
+  switch (display_x11->egl_platform)
+    {
+    case GDK_X11_EGL_PLATFORM_KHR:
+      {
+        GdkEglCreatePlatformWindowSurfaceFunc create =
+          (GdkEglCreatePlatformWindowSurfaceFunc) eglGetProcAddress ("eglCreatePlatformWindowSurface");
+
+        if (create != NULL)
+          return create (edpy, config, &xwindow, NULL);
+      }
+      break;
+
+    case GDK_X11_EGL_PLATFORM_EXT:
+      {
+        GdkEglCreatePlatformWindowSurfaceEXTFunc create =
+          (GdkEglCreatePlatformWindowSurfaceEXTFunc) eglGetProcAddress ("eglCreatePlatformWindowSurfaceEXT");
+
+        if (create != NULL)
+          return create (edpy, config, &xwindow, NULL);
+      }
+      break;
+
+    default:
+      break;
+    }
+
+  return eglCreateWindowSurface (edpy, config,
+                                 (EGLNativeWindowType) (uintptr_t) xwindow,
+                                 NULL);
+}
+
+struct eglconfiginfo {
+  EGLint alpha_size;
+  EGLint depth_size;
+  EGLint stencil_size;
+  EGLint sample_buffers;
+  EGLint caveat;
+};
+
+/* The config for an X visual.
+ *
+ * Every config usable with a visual carries that visual's id, which is how
+ * the two worlds are joined.  Among the configs for one visual the preference
+ * is the GLX path's: the alpha the visual implies (an rgba visual wants it,
+ * the system visual does not), none of the depth, stencil or multisample
+ * buffers nothing here uses, and no caveat.  A config missing the preferred
+ * properties is still taken over nothing at all; only a config an rgba visual
+ * cannot blend through is refused outright. */
+static gboolean
+find_eglconfig_for_visual_id (GdkX11Display         *display_x11,
+                              VisualID               visual_id,
+                              gboolean               want_alpha,
+                              EGLConfig             *config_out,
+                              struct eglconfiginfo  *info_out)
+{
+  EGLDisplay edpy = display_x11->egl_display;
+  EGLConfig *configs;
+  EGLConfig best = NULL;
+  int best_score = -1;
+  EGLint n_configs = 0;
+  EGLint renderable_bits;
+  EGLint i;
+
+  if ((_gdk_gl_flags & GDK_GL_GLES) != 0)
+    renderable_bits = EGL_OPENGL_ES2_BIT | EGL_OPENGL_ES3_BIT_KHR;
+  else
+    renderable_bits = EGL_OPENGL_BIT;
+
+  if (!eglGetConfigs (edpy, NULL, 0, &n_configs) || n_configs <= 0)
+    return FALSE;
+
+  configs = g_new (EGLConfig, n_configs);
+  if (!eglGetConfigs (edpy, configs, n_configs, &n_configs))
+    {
+      g_free (configs);
+      return FALSE;
+    }
+
+  for (i = 0; i < n_configs; i++)
+    {
+      EGLint id = 0, surface_type = 0, renderable = 0, buffer_type = 0;
+      struct eglconfiginfo ci = { 0, 0, 0, 0, EGL_NONE };
+      int score;
+
+      if (!eglGetConfigAttrib (edpy, configs[i], EGL_NATIVE_VISUAL_ID, &id) ||
+          (VisualID) id != visual_id)
+        continue;
+      if (!eglGetConfigAttrib (edpy, configs[i], EGL_SURFACE_TYPE, &surface_type) ||
+          (surface_type & EGL_WINDOW_BIT) == 0)
+        continue;
+      if (!eglGetConfigAttrib (edpy, configs[i], EGL_RENDERABLE_TYPE, &renderable) ||
+          (renderable & renderable_bits) == 0)
+        continue;
+      if (!eglGetConfigAttrib (edpy, configs[i], EGL_COLOR_BUFFER_TYPE, &buffer_type) ||
+          buffer_type != EGL_RGB_BUFFER)
+        continue;
+
+      eglGetConfigAttrib (edpy, configs[i], EGL_ALPHA_SIZE, &ci.alpha_size);
+      eglGetConfigAttrib (edpy, configs[i], EGL_DEPTH_SIZE, &ci.depth_size);
+      eglGetConfigAttrib (edpy, configs[i], EGL_STENCIL_SIZE, &ci.stencil_size);
+      eglGetConfigAttrib (edpy, configs[i], EGL_SAMPLE_BUFFERS, &ci.sample_buffers);
+      eglGetConfigAttrib (edpy, configs[i], EGL_CONFIG_CAVEAT, &ci.caveat);
+
+      if (want_alpha && ci.alpha_size == 0)
+        continue;
+
+      score = 0;
+      if (want_alpha ? ci.alpha_size > 0 : ci.alpha_size == 0)
+        score += 8;
+      if (ci.depth_size == 0)
+        score += 4;
+      if (ci.stencil_size == 0)
+        score += 2;
+      if (ci.sample_buffers == 0)
+        score += 1;
+      if (ci.caveat != EGL_NONE)
+        score -= 16;
+
+      if (score > best_score)
+        {
+          best_score = score;
+          best = configs[i];
+          if (info_out != NULL)
+            *info_out = ci;
+        }
+    }
+
+  g_free (configs);
+
+  if (best == NULL)
+    return FALSE;
+  if (config_out != NULL)
+    *config_out = best;
+  return TRUE;
+}
+
+static gboolean
+find_eglconfig_for_window (GdkWindow  *window,
+                           EGLConfig  *config_out,
+                           GError    **error)
+{
+  GdkDisplay *display = gdk_window_get_display (window);
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (display);
+  GdkVisual *visual = gdk_window_get_visual (window);
+  VisualID xvisual_id = XVisualIDFromVisual (gdk_x11_visual_get_xvisual (visual));
+  gboolean use_rgba;
+
+  use_rgba = (visual == gdk_screen_get_rgba_visual (gdk_display_get_default_screen (display)));
+
+  if (!find_eglconfig_for_visual_id (display_x11, xvisual_id, use_rgba, config_out, NULL))
+    {
+      g_set_error_literal (error, GDK_GL_ERROR,
+                           GDK_GL_ERROR_UNSUPPORTED_FORMAT,
+                           _("No available configurations for the given RGBA pixel format"));
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+/* Bring EGL up on the display.  Once; the answer is remembered either way.
+ *
+ * Nothing here terminates the display on a failed bring-up.  The EGL display
+ * for an X connection is one object however many times it is asked for, and
+ * a program may already have initialised it for its own use before GDK gets
+ * here -- terminating it would take theirs away with ours. */
+static gboolean
+gdk_x11_display_init_egl (GdkDisplay *display)
+{
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (display);
+  Display *dpy = gdk_x11_display_get_xdisplay (display);
+  EGLDisplay edpy;
+  EGLint major, minor;
+  gint platform;
+  gboolean use_es;
+
+  if (display_x11->have_egl)
+    return TRUE;
+  if (display_x11->egl_tried)
+    return FALSE;
+  display_x11->egl_tried = TRUE;
+
+  if (_gdk_gl_flags & (GDK_GL_DISABLE | GDK_GL_GLX))
+    return FALSE;
+
+  if (!epoxy_has_egl ())
+    return FALSE;
+
+  edpy = gdk_x11_get_egl_display (display_x11, &platform);
+  if (edpy == EGL_NO_DISPLAY)
+    return FALSE;
+
+  if (!eglInitialize (edpy, &major, &minor))
+    return FALSE;
+
+  use_es = (_gdk_gl_flags & GDK_GL_GLES) != 0;
+  if (!eglBindAPI (use_es ? EGL_OPENGL_ES_API : EGL_OPENGL_API))
+    return FALSE;
+
+  /* A core profile -- what a GdkGLContext asks for unless told otherwise --
+   * needs EGL_KHR_create_context.  Without it this display cannot serve the
+   * contexts GDK creates, and GLX may still be able to. */
+  if (!epoxy_has_egl_extension (edpy, "EGL_KHR_create_context"))
+    return FALSE;
+
+  display_x11->egl_display = edpy;
+  display_x11->egl_platform = platform;
+
+  /* The one X11 condition: EGL must be able to put a window surface on the
+   * screen's default visual, or every ordinary window would be refused a
+   * context that GLX would have granted.  Checked before committing, so the
+   * fallback is still open. */
+  if (!find_eglconfig_for_visual_id (display_x11,
+                                     XVisualIDFromVisual (DefaultVisual (dpy, DefaultScreen (dpy))),
+                                     FALSE, NULL, NULL))
+    {
+      display_x11->egl_display = NULL;
+      display_x11->egl_platform = GDK_X11_EGL_PLATFORM_NONE;
+      return FALSE;
+    }
+
+  display_x11->egl_major_version = major;
+  display_x11->egl_minor_version = minor;
+  display_x11->have_egl = TRUE;
+
+  display_x11->have_egl_buffer_age =
+    epoxy_has_egl_extension (edpy, "EGL_EXT_buffer_age");
+  display_x11->have_egl_swap_buffers_with_damage =
+    epoxy_has_egl_extension (edpy, "EGL_EXT_swap_buffers_with_damage");
+  display_x11->have_egl_surfaceless_context =
+    epoxy_has_egl_extension (edpy, "EGL_KHR_surfaceless_context");
+
+  GDK_NOTE (OPENGL,
+            g_message ("EGL API version %d.%d found on X11 (%s)\n"
+                       " - Vendor: %s\n"
+                       " - Version: %s\n"
+                       " - Client APIs: %s\n"
+                       " - Checked extensions:\n"
+                       "\t* EGL_KHR_create_context: yes\n"
+                       "\t* EGL_EXT_buffer_age: %s\n"
+                       "\t* EGL_EXT_swap_buffers_with_damage: %s\n"
+                       "\t* EGL_KHR_surfaceless_context: %s",
+                       major, minor,
+                       platform == GDK_X11_EGL_PLATFORM_KHR ? "EGL_KHR_platform_x11" :
+                       platform == GDK_X11_EGL_PLATFORM_EXT ? "EGL_EXT_platform_x11" :
+                                                              "eglGetDisplay",
+                       eglQueryString (edpy, EGL_VENDOR),
+                       eglQueryString (edpy, EGL_VERSION),
+                       eglQueryString (edpy, EGL_CLIENT_APIS),
+                       display_x11->have_egl_buffer_age ? "yes" : "no",
+                       display_x11->have_egl_swap_buffers_with_damage ? "yes" : "no",
+                       display_x11->have_egl_surfaceless_context ? "yes" : "no"));
+
+  return TRUE;
+}

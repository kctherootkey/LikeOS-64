+static void
+gdk_x11_screen_update_visuals_for_egl (GdkX11Screen *x11_screen)
+{
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (x11_screen->display);
+  struct glvisualinfo *gl_info;
+  int i;
+
+  gl_info = g_new0 (struct glvisualinfo, x11_screen->nvisuals);
+
+  for (i = 0; i < x11_screen->nvisuals; i++)
+    {
+      GdkVisual *visual = x11_screen->visuals[i];
+      VisualID visual_id = gdk_x11_visual_get_xvisual (visual)->visualid;
+      struct eglconfiginfo ci;
+
+      if (!find_eglconfig_for_visual_id (display_x11, visual_id,
+                                         visual_is_rgba (visual), NULL, &ci))
+        continue;
+
+      gl_info[i].supports_gl = 1;
+      /* An EGL window surface is always back-buffered. */
+      gl_info[i].double_buffer = 1;
+      gl_info[i].stereo = 0;
+      gl_info[i].alpha_size = ci.alpha_size;
+      gl_info[i].depth_size = ci.depth_size;
+      gl_info[i].stencil_size = ci.stencil_size;
+      gl_info[i].num_multisample = ci.sample_buffers;
+      gl_info[i].visual_caveat = ci.caveat == EGL_NONE ? GLX_NONE_EXT
+                                                        : GLX_SLOW_VISUAL_EXT;
+    }
+
+  x11_screen->system_visual = pick_better_visual_for_gl (x11_screen, gl_info, x11_screen->system_visual);
+  if (x11_screen->rgba_visual)
+    x11_screen->rgba_visual = pick_better_visual_for_gl (x11_screen, gl_info, x11_screen->rgba_visual);
+
+  g_free (gl_info);
+}

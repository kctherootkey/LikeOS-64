+/* The surfaces of the window a context is created on, made once per
+ * toplevel and kept for its life, as the GLX path keeps its GLXWindow. */
+static EglDrawableInfo *
+egl_drawable_info_ensure (GdkWindow  *impl_window,
+                          EGLConfig   config,
+                          GError    **error)
+{
+  GdkDisplay *display = gdk_window_get_display (impl_window);
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (display);
+  Display *dpy = gdk_x11_display_get_xdisplay (display);
+  EglDrawableInfo *info;
+  gboolean failed = FALSE;
+
+  info = get_egl_drawable_info (impl_window);
+  if (info != NULL)
+    return info;
+
+  info = g_slice_new0 (EglDrawableInfo);
+  info->display = display;
+  info->egl_surface = EGL_NO_SURFACE;
+  info->dummy_xwin = None;
+  info->dummy_surface = EGL_NO_SURFACE;
+
+  gdk_x11_display_error_trap_push (display);
+
+  info->egl_surface = egl_create_window_surface (display_x11, config,
+                                                 gdk_x11_window_get_xid (impl_window));
+  if (info->egl_surface == EGL_NO_SURFACE)
+    failed = TRUE;
+
+  if (!failed && !display_x11->have_egl_surfaceless_context)
+    {
+      XVisualInfo visual_template, *visual_list;
+      XSetWindowAttributes attrs;
+      unsigned long mask;
+      EGLint visual_id = 0;
+      int n_visuals = 0;
+
+      /* A window of the config's own visual, off screen and never shown. */
+      eglGetConfigAttrib (display_x11->egl_display, config,
+                          EGL_NATIVE_VISUAL_ID, &visual_id);
+      visual_template.screen = DefaultScreen (dpy);
+      visual_template.visualid = (VisualID) visual_id;
+      visual_list = XGetVisualInfo (dpy, VisualIDMask | VisualScreenMask,
+                                    &visual_template, &n_visuals);
+      if (visual_list == NULL || n_visuals < 1)
+        failed = TRUE;
+      else
+        {
+          attrs.override_redirect = True;
+          attrs.colormap = XCreateColormap (dpy, DefaultRootWindow (dpy),
+                                            visual_list[0].visual, AllocNone);
+          attrs.border_pixel = 0;
+          mask = CWOverrideRedirect | CWColormap | CWBorderPixel;
+          info->dummy_xwin = XCreateWindow (dpy, DefaultRootWindow (dpy),
+                                            -100, -100, 1, 1, 0,
+                                            visual_list[0].depth,
+                                            CopyFromParent,
+                                            visual_list[0].visual,
+                                            mask, &attrs);
+          info->dummy_surface = egl_create_window_surface (display_x11, config,
+                                                           info->dummy_xwin);
+          if (info->dummy_surface == EGL_NO_SURFACE)
+            failed = TRUE;
+        }
+      if (visual_list != NULL)
+        XFree (visual_list);
+    }
+
+  if (gdk_x11_display_error_trap_pop (display))
+    failed = TRUE;
+
+  if (failed)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR,
+                           GDK_GL_ERROR_NOT_AVAILABLE,
+                           _("Unable to create a GL context"));
+      egl_drawable_info_free (info);
+      return NULL;
+    }
+
+  set_egl_drawable_info (impl_window, info);
+  return info;
+}
+
+#define N_EGL_ATTRS     16
+
+static gboolean
+gdk_x11_gl_context_realize_egl (GdkGLContext  *context,
+                                GError       **error)
+{
+  GdkX11GLContext *context_x11 = GDK_X11_GL_CONTEXT (context);
+  GdkDisplay *display = gdk_gl_context_get_display (context);
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (display);
+  GdkGLContext *share = gdk_gl_context_get_shared_context (context);
+  GdkWindow *window = gdk_gl_context_get_window (context);
+  EGLContext ctx;
+  EGLint context_attribs[N_EGL_ATTRS];
+  int major, minor, flags;
+  gboolean debug_bit, forward_bit, legacy_bit, use_es;
+  int i = 0;
+
+  gdk_gl_context_get_required_version (context, &major, &minor);
+  debug_bit = gdk_gl_context_get_debug_enabled (context);
+  forward_bit = gdk_gl_context_get_forward_compatible (context);
+  legacy_bit = (_gdk_gl_flags & GDK_GL_LEGACY) != 0 ||
+               (share != NULL && gdk_gl_context_is_legacy (share));
+  use_es = (_gdk_gl_flags & GDK_GL_GLES) != 0 ||
+           (share != NULL && gdk_gl_context_get_use_es (share));
+
+  flags = 0;
+  if (debug_bit)
+    flags |= EGL_CONTEXT_OPENGL_DEBUG_BIT_KHR;
+  if (forward_bit)
+    flags |= EGL_CONTEXT_OPENGL_FORWARD_COMPATIBLE_BIT_KHR;
+
+  if (!use_es)
+    {
+      eglBindAPI (EGL_OPENGL_API);
+
+      /* A core profile, unless in legacy mode */
+      context_attribs[i++] = EGL_CONTEXT_OPENGL_PROFILE_MASK_KHR;
+      context_attribs[i++] = legacy_bit
+                           ? EGL_CONTEXT_OPENGL_COMPATIBILITY_PROFILE_BIT_KHR
+                           : EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT_KHR;
+      context_attribs[i++] = EGL_CONTEXT_MAJOR_VERSION_KHR;
+      context_attribs[i++] = legacy_bit ? 3 : major;
+      context_attribs[i++] = EGL_CONTEXT_MINOR_VERSION_KHR;
+      context_attribs[i++] = legacy_bit ? 0 : minor;
+    }
+  else
+    {
+      eglBindAPI (EGL_OPENGL_ES_API);
+
+      context_attribs[i++] = EGL_CONTEXT_CLIENT_VERSION;
+      context_attribs[i++] = major == 3 ? 3 : 2;
+    }
+
+  context_attribs[i++] = EGL_CONTEXT_FLAGS_KHR;
+  context_attribs[i++] = flags;
+
+  context_attribs[i++] = EGL_NONE;
+  g_assert (i < N_EGL_ATTRS);
+
+  GDK_NOTE (OPENGL,
+            g_message ("Creating EGL context version %d.%d (debug:%s, forward:%s, legacy:%s, es:%s)",
+                       major, minor,
+                       debug_bit ? "yes" : "no",
+                       forward_bit ? "yes" : "no",
+                       legacy_bit ? "yes" : "no",
+                       use_es ? "yes" : "no"));
+
+  ctx = eglCreateContext (display_x11->egl_display,
+                          context_x11->egl_config,
+                          share != NULL ? GDK_X11_GL_CONTEXT (share)->egl_context
+                                        : EGL_NO_CONTEXT,
+                          context_attribs);
+
+  /* Not to be had as asked: try again as a legacy context, as the GLX path
+   * and the Wayland backend do. */
+  if (ctx == EGL_NO_CONTEXT && !legacy_bit && !use_es)
+    {
+      g_assert (context_attribs[0] == EGL_CONTEXT_OPENGL_PROFILE_MASK_KHR);
+      context_attribs[1] = EGL_CONTEXT_OPENGL_COMPATIBILITY_PROFILE_BIT_KHR;
+      context_attribs[3] = 3;
+      context_attribs[5] = 0;
+
+      legacy_bit = TRUE;
+
+      GDK_NOTE (OPENGL, g_message ("eglCreateContext failed, switching to legacy"));
+      ctx = eglCreateContext (display_x11->egl_display,
+                              context_x11->egl_config,
+                              share != NULL ? GDK_X11_GL_CONTEXT (share)->egl_context
+                                            : EGL_NO_CONTEXT,
+                              context_attribs);
+    }
+
+  if (ctx == EGL_NO_CONTEXT)
+    {
+      g_set_error_literal (error, GDK_GL_ERROR,
+                           GDK_GL_ERROR_NOT_AVAILABLE,
+                           _("Unable to create a GL context"));
+      return FALSE;
+    }
+
+  /* The drawable, before the context is committed to: an attached context
+   * draws to the window's surface, an unattached one needs one only where
+   * surfaceless contexts are missing. */
+  if (egl_drawable_info_ensure (window->impl_window, context_x11->egl_config, error) == NULL)
+    {
+      eglDestroyContext (display_x11->egl_display, ctx);
+      return FALSE;
+    }
+
+  context_x11->egl_context = ctx;
+  context_x11->is_direct = TRUE;
+
+  gdk_gl_context_set_is_legacy (context, legacy_bit);
+  gdk_gl_context_set_use_es (context, use_es);
+
+  GDK_NOTE (OPENGL, g_message ("Realized EGL context[%p]", ctx));
+
+  return TRUE;
+}
+
+static void
+gdk_x11_gl_context_end_frame_egl (GdkGLContext   *context,
+                                  cairo_region_t *painted,
+                                  cairo_region_t *damage)
+{
+  GdkWindow *window = gdk_gl_context_get_window (context);
+  GdkDisplay *display = gdk_window_get_display (window);
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (display);
+  EglDrawableInfo *info;
+
+  gdk_gl_context_make_current (context);
+
+  info = get_egl_drawable_info (window->impl_window);
+  if (info == NULL || info->egl_surface == EGL_NO_SURFACE)
+    return;
+
+  GDK_NOTE (OPENGL,
+            g_message ("Swapping EGL buffers for window %lu",
+                       (unsigned long) gdk_x11_window_get_xid (window)));
+
+  if (display_x11->have_egl_swap_buffers_with_damage)
+    {
+      int i, j, n_rects = cairo_region_num_rectangles (damage);
+      EGLint *rects = g_new (EGLint, n_rects * 4);
+      cairo_rectangle_int_t rect;
+      int scale = gdk_window_get_scale_factor (window);
+      int window_height = gdk_window_get_height (window);
+
+      /* EGL wants device pixels with the origin at the bottom left. */
+      for (i = 0, j = 0; i < n_rects; i++)
+        {
+          cairo_region_get_rectangle (damage, i, &rect);
+          rects[j++] = rect.x * scale;
+          rects[j++] = (window_height - rect.height - rect.y) * scale;
+          rects[j++] = rect.width * scale;
+          rects[j++] = rect.height * scale;
+        }
+      eglSwapBuffersWithDamageEXT (display_x11->egl_display, info->egl_surface,
+                                   rects, n_rects);
+      g_free (rects);
+    }
+  else
+    eglSwapBuffers (display_x11->egl_display, info->egl_surface);
+}
+
+static void
+gdk_x11_window_invalidate_for_new_frame_egl (GdkWindow      *window,
+                                             cairo_region_t *update_area)
+{
+  cairo_rectangle_int_t window_rect;
+  GdkDisplay *display = gdk_window_get_display (window);
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (display);
+  GdkX11GLContext *context_x11 = GDK_X11_GL_CONTEXT (window->gl_paint_context);
+  EglDrawableInfo *info;
+  EGLint buffer_age = 0;
+  gboolean invalidate_all;
+
+  context_x11->do_blit_swap = FALSE;
+
+  info = get_egl_drawable_info (window->impl_window);
+
+  if (display_x11->have_egl_buffer_age && info != NULL &&
+      info->egl_surface != EGL_NO_SURFACE)
+    {
+      gdk_gl_context_make_current (window->gl_paint_context);
+      eglQuerySurface (display_x11->egl_display, info->egl_surface,
+                       EGL_BUFFER_AGE_EXT, &buffer_age);
+    }
+
+  invalidate_all = FALSE;
+  if (buffer_age == 0 || buffer_age >= 4)
+    invalidate_all = TRUE;
+  else
+    {
+      if (buffer_age >= 2)
+        {
+          if (window->old_updated_area[0])
+            cairo_region_union (update_area, window->old_updated_area[0]);
+          else
+            invalidate_all = TRUE;
+        }
+      if (buffer_age >= 3)
+        {
+          if (window->old_updated_area[1])
+            cairo_region_union (update_area, window->old_updated_area[1]);
+          else
+            invalidate_all = TRUE;
+        }
+    }
+
+  if (invalidate_all)
+    {
+      window_rect.x = 0;
+      window_rect.y = 0;
+      window_rect.width = gdk_window_get_width (window);
+      window_rect.height = gdk_window_get_height (window);
+
+      /* If nothing else is known, repaint everything so that the back
+       * buffer is fully up-to-date for the swapbuffer */
+      cairo_region_union_rectangle (update_area, &window_rect);
+    }
+}
+
+static gboolean
+gdk_x11_display_make_gl_context_current_egl (GdkDisplay   *display,
+                                             GdkGLContext *context)
+{
+  GdkX11Display *display_x11 = GDK_X11_DISPLAY (display);
+  GdkX11GLContext *context_x11;
+  GdkWindow *window;
+  EglDrawableInfo *info;
+  EGLSurface surface;
+
+  if (context == NULL)
+    {
+      eglMakeCurrent (display_x11->egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                      EGL_NO_CONTEXT);
+      return TRUE;
+    }
+
+  context_x11 = GDK_X11_GL_CONTEXT (context);
+  if (context_x11->egl_context == EGL_NO_CONTEXT)
+    {
+      g_critical ("No EGL context associated to the GdkGLContext; you must "
+                  "call gdk_gl_context_realize() first.");
+      return FALSE;
+    }
+
+  window = gdk_gl_context_get_window (context);
+  info = get_egl_drawable_info (window->impl_window);
+  if (info == NULL)
+    {
+      g_critical ("No EGL surface associated to the GdkGLContext's window");
+      return FALSE;
+    }
+
+  if (context_x11->is_attached)
+    surface = info->egl_surface;
+  else if (display_x11->have_egl_surfaceless_context)
+    surface = EGL_NO_SURFACE;
+  else
+    surface = info->dummy_surface;
+
+  GDK_NOTE (OPENGL,
+            g_message ("Making EGL context current to surface %p", surface));
+
+  if (!eglMakeCurrent (display_x11->egl_display, surface, surface,
+                       context_x11->egl_context))
+    {
+      GDK_NOTE (OPENGL, g_message ("Making EGL context current failed"));
+      return FALSE;
+    }
+
+  if (context_x11->is_attached)
+    {
+      gboolean do_frame_sync;
+
+      /* The GLX path's rule: with a compositing manager the swap need not
+       * wait for the display, since what reaches the screen is the
+       * compositor's business and it paces itself; without one, the swap is
+       * what puts the frame on the screen and is timed to the refresh.  The
+       * interval belongs to the surface just made current. */
+      do_frame_sync = !gdk_screen_is_composited (gdk_window_get_screen (window));
+
+      if (!context_x11->egl_swap_interval_set ||
+          do_frame_sync != context_x11->do_frame_sync)
+        {
+          context_x11->do_frame_sync = do_frame_sync;
+          context_x11->egl_swap_interval_set = TRUE;
+          eglSwapInterval (display_x11->egl_display, do_frame_sync ? 1 : 0);
+        }
+    }
+
+  return TRUE;
+}
